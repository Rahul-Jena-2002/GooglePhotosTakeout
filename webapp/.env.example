# ============================================================
# TAKEOUTFIX — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── Firebase (Public — safe to expose in browser bundles) ──
# Get these from Firebase Console → Project Settings → Your App
PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
PUBLIC_FIREBASE_APP_ID=your-app-id
PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Sentry (Public — DSN is safe to bundle, rate-limited per project) ──
# Get from Sentry → Project → Settings → Client Keys (DSN)
PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# ── Master Encryption Key (NEVER commit this) ──
# 32-byte hex string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# For production: set as a Cloudflare Pages Environment Secret named ENCRYPTION_KEY
# For local-server / functions: set as ENCRYPTION_KEY=...
# VITE_ENCRYPTION_KEY is used locally for Admin UI session recovery in development
VITE_ENCRYPTION_KEY=

# ── Gateway Proxy (Server-side only — set as Cloudflare Pages Secrets, NOT prefixed with PUBLIC_) ──
# URL of the deployed Firebase Cloud Function gateway (no trailing slash)
CLOUD_FUNCTION_URL=https://us-central1-takeout-fix.cloudfunctions.net/geminiToolGateway
# Secret key for admin proxy routes (sync-dodo-prices, sync-coupon).
# Must match the value set via: firebase functions:config:set gateway.key="YOUR_SECRET"
GATEWAY_API_KEY=

# ── Firebase Service Account (Server-side only — for dodo-webhook Cloudflare Worker) ──
# Full JSON of a Firebase service account key, stringified.
# Set as a Cloudflare Pages Secret named FIREBASE_SERVICE_ACCOUNT.
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
# Then: FIREBASE_SERVICE_ACCOUNT=$(cat serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT=

# ── Dodo Webhook Secret (Server-side only — for dodo-webhook Cloudflare Worker) ──
# The whsec_... secret from Dodo Dashboard → Webhooks → your endpoint.
# Set as a Cloudflare Pages Secret named DODO_WEBHOOK_KEY.
# If not set, the Worker falls back to fetching it from Firestore settings/secure.
DODO_WEBHOOK_KEY=
