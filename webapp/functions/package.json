{
  "name": "functions",
  "description": "Firebase Cloud Functions for Google AI Studio / Gemini tool integrations",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "local-serve": "node local-server.js"
  },
  "engines": {
    "node": "18"
  },
  "main": "index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.1.0"
  },
  "private": true,
  "allowScripts": {
    "protobufjs@7.2.4": true,
    "protobufjs@7.6.4": true,
    "unrs-resolver@1.12.2": true
  }
}
