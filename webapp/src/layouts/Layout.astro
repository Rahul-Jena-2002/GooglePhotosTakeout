---
import "../index.css";
import { ClientRouter } from "astro:transitions";
import AuthModal from "../react-pages/auth/AuthModal";
import AdUnit from "../components/monetization/AdUnit";

interface Props {
  title?: string;
  description?: string;
  isToolPage?: boolean;
  isAuthPage?: boolean;
  robots?: string;
  sidebarAdCount?: number;
  showSideAds?: boolean;
}

const { 
  title = "TakeoutFix – Take Out Fix, Takeout Fixer & Metadata Fixer for Google Photos",
  description = "Restore missing EXIF dates, GPS coordinates, timestamps, and other metadata from Google Takeout archives. Everything runs locally in your browser—your files never leave your device. Not affiliated with Google.",
  isToolPage = false,
  isAuthPage = false,
  robots = isAuthPage ? "noindex, nofollow" : "index, follow",
  sidebarAdCount,
  showSideAds: propShowSideAds,
} = Astro.props;

// Normalized path check for routing & active links
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHomePage = currentPath === "/" || currentPath === "/index" || currentPath === "/index.html";

// Determine if sidebar empty-space gutter ads should show (NEVER on home, tool, or admin)
const showSideAds = propShowSideAds !== undefined 
  ? propShowSideAds 
  : (!isToolPage && !isHomePage && !currentPath.startsWith("/admin"));

// Flexible sidebar card length tailored to page content length:
// Short pages (Reviews, Support, Terms, Privacy): 2 ads per sidebar
// Medium pages (Pricing, How it works, Download): 3 ads per sidebar
// Long pages (Restore Data guide, documentation): 4 ads per sidebar
let calculatedAdCount = 4;
if (["/reviews", "/support", "/terms", "/privacy"].includes(currentPath)) {
  calculatedAdCount = 2;
} else if (["/pricing", "/how-it-works", "/download"].includes(currentPath)) {
  calculatedAdCount = 3;
}
const effectiveAdCount = sidebarAdCount ?? calculatedAdCount;

// Active Navigation Helper for Purple Highlighting
const isActive = (path: string) => (path === "/" ? currentPath === "/" : currentPath === path || currentPath.startsWith(path + "/"));

// Generate clean canonical URL (strip .html, /index, and trailing slashes)
const rawPath = Astro.url.pathname || "/";
const cleanPath = rawPath.replace(/\.html$/, "").replace(/\/index$/, "").replace(/\/$/, "") || "/";
const canonicalUrl = `https://takeoutfix.pages.dev${cleanPath === "" ? "/" : cleanPath}`;
