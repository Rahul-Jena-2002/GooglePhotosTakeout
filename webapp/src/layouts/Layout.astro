      }
      [data-ad-size="large"] {
        --ad-gutter-width: 220px;
        --ad-gutter-width-2xl: 250px;
      }
      .sidebar-gutter-ad {
        width: var(--ad-gutter-width);
        opacity: var(--ad-opacity);
        transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease;
