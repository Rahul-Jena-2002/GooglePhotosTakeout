            <!-- Desktop Links -->
            <div class="hidden lg:flex gap-8 text-sm font-medium ml-4 font-sans items-center">
              <a href="/" class="nav-link text-zinc-400 hover:text-white transition-colors duration-150">Home</a>
              <a href="/how-it-works" class="nav-link text-zinc-400 hover:text-white transition-colors duration-150">How It Works</a>
              <a href="/pricing" class="nav-link text-zinc-400 hover:text-white transition-colors duration-150">Pricing</a>
              <a href="/reviews" class="nav-link text-zinc-400 hover:text-white transition-colors duration-150">Reviews</a>
