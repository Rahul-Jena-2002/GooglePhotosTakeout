    <!-- FAQPage Schema for Rich Snippets & AI Answer Engines -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Why are my Google Takeout photo dates wrong or set to today?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "When you export photos from Google Takeout, Google strips original capture timestamps and stores them in separate JSON sidecars. Your computer displays the download or extraction date instead. TakeoutFix re-embeds the original JSON timestamps back into EXIF headers so photos sort chronologically."
            }
          },
          {
            "@type": "Question",
            "name": "How can I fix Google Takeout metadata offline on Windows or Mac?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "You can use the TakeoutFix desktop app. On Windows, run the standalone TakeoutFix.exe directly with no installation. On macOS, open TakeoutFix.dmg. Both applications process files 100% locally on your computer with zero file uploads."
            }
          },
          {
            "@type": "Question",
            "name": "What is a take out fix or takeout fix?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A take out fix or takeout fix is the process of repairing missing EXIF metadata after downloading photos using Google Takeout. Google Takeout stores metadata separately in JSON sidecar files. TakeoutFix (also called TakeoutFixer) solves this automatically in your browser."
            }
          },
          {
            "@type": "Question",
            "name": "How do I fix metadata after Google Takeout?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Open TakeoutFix in your browser, select your Takeout folder containing both the image files and their .json sidecar files, then click Restore My Data. The tool automatically matches each photo to its JSON sidecar and writes the date, GPS, and EXIF data back into the file header. No installation or upload required."
            }
          },
          {
            "@type": "Question",
            "name": "What is a metadata fixer for Google Photos?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A metadata fixer for Google Photos reads the .json sidecar files created during a Google Takeout export and writes the stored metadata (date taken, GPS location, camera model) back into the photo EXIF header. TakeoutFix is a free metadata fixer and meta data fix tool that works entirely in your web browser."
            }
          },
          {
            "@type": "Question",
            "name": "What is a Google Takeout merger?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A Google Takeout merger is a tool that merges the photo and video binary files with their detached JSON metadata sidecar files produced by a Google Takeout export. TakeoutFix performs this merge locally on your device with no server, no upload, and no privacy risk."
            }
          },
          {
            "@type": "Question",
            "name": "Does TakeoutFix work as a meta data fixer?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. TakeoutFix is both a metadata fixer and a meta data fixer. It repairs EXIF metadata that was stripped out of your photos and videos during a Google Takeout or Google Photos export."
            }
          }
        ]
      }
    </script>

