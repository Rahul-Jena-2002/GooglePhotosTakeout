---
import "../index.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  isToolPage?: boolean;
}

const { 
  title = "TakeoutFix: Restore Google Takeout Photo & Video EXIF Metadata",
  description = "Restore missing EXIF dates, GPS coordinates, timestamps, and other metadata from Google Takeout archives. Everything runs locally in your browser—your files never leave your device.",
  isToolPage = false 
} = Astro.props;

// Generate canonical URL dynamically based on current path
const canonicalUrl = `https://takeoutfix.pages.dev${Astro.url.pathname.replace(/\/$/, "") || "/"}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Preload hero image to speed up LCP -->
    <link rel="preload" as="image" href="/hero-graphic-light.webp" fetchpriority="high" />
    <!-- Google Fonts: async non-render-blocking load with font-display:optional (no FOUT = no CLS) -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=optional" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=optional" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=optional" /></noscript>
    <!-- System font fallback with adjusted metrics to prevent layout shift -->
    <style>
      @font-face {
        font-family: 'Inter Fallback';
        src: local('Arial');
        ascent-override: 90%;
        descent-override: 22%;
        line-gap-override: 0%;
        size-adjust: 107%;
      }
      body { font-family: 'Inter', 'Inter Fallback', system-ui, -apple-system, sans-serif; }
    </style>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Theme Initialization Script -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("takeoutfix_theme");
        const theme = saved || "light";
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
          document.documentElement.classList.remove("light");
        } else {
          document.documentElement.classList.add("light");
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    
    <!-- Google AdSense Account Setup -->
    <meta name="google-adsense-account" content="ca-pub-7628736172233995">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7628736172233995" crossorigin="anonymous"></script>
 
    <title>{title}</title>
    <ClientRouter />
    <meta name="description" content={description} />
    <meta name="keywords" content="take out fix, takeoutfixer, meta data fix, metadata fixer, how to fix metadata, how to fix meta data, metadata fix, restore metadata, Google Takeout metadata fix, EXIF metadata fix, Google Photos metadata fixer, EXIF recovery, GPS coordinates, JSON sidecar fixer, restore photo date taken, takeoutfix" />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="yjn_T1bJ3RfrKhKTaT4in3ciTBkK5Ngw9LfOChfRztk" />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="TakeoutFix" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:url" content={canonicalUrl} />

    <!-- Google Search Site Name Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "TakeoutFix",
        "alternateName": ["Takeout Fix", "Google Takeout Metadata Fixer", "TakeoutFixer", "Takeout Fixer", "Metadata Fixer", "Metadata Fix", "Restore Metadata"],
        "url": "https://takeoutfix.pages.dev"
      }
    </script>

    <!-- Schema.org JSON-LD Structured Data for Search Engine Optimization -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "TakeoutFix",
        "alternateName": [
          "Takeout Fix", "TakeoutFixer", "Takeout Fixer", "Take Out Fix",
          "Metadata Fixer", "Meta Data Fixer", "Metadata Fix Tool",
          "Google Takeout Fixer", "Google Takeout Metadata Fixer",
          "Google Photos Metadata Fixer", "Google Takeout Merger",
          "EXIF Fixer", "Photo Metadata Fixer"
        ],
        "url": "https://takeoutfix.pages.dev",
        "description": "Restore missing dates, GPS locations, and EXIF metadata from your Google Takeout photos and videos locally in your browser. The best take out fix tool, takeout fixer, and metadata fixer available.",
        "applicationCategory": "MultimediaApplication",
        "operatingSystem": "All",
        "browserRequirements": "Requires HTML5 File System Access API (Google Chrome, Microsoft Edge, Brave recommended)",
        "featureList": [
          "Restore photo EXIF metadata from Google Takeout JSON sidecars",
          "Fix missing photo dates and timestamps",
          "Restore GPS coordinates and location data",
          "Fix metadata on thousands of photos simultaneously",
          "100% local browser processing - no uploads",
          "Google Takeout merger - merge JSON metadata back into photos"
        ],
        "offers": {
          "@type": "Offer",
          "price": "0.00",
          "priceCurrency": "USD"
        }
      }
    </script>

    <!-- FAQPage Schema for Rich Snippets -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What is a take out fix or takeout fix?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A take out fix or takeout fix is the process of repairing missing EXIF metadata after downloading photos using Google Takeout. Google Takeout stores metadata separately in JSON sidecar files. TakeoutFix (also called TakeoutFixer) solves this automatically in your browser."
            }
          },
          {
            "@type": "Question",
            "name": "How do I fix metadata after Google Takeout?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Open TakeoutFix in your browser, select your Takeout folder containing both the image files and their .json sidecar files, then click Restore My Data. The tool automatically matches each photo to its JSON sidecar and writes the date, GPS, and EXIF data back into the file header. No installation or upload required."
            }
          },
          {
            "@type": "Question",
            "name": "What is a metadata fixer for Google Photos?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A metadata fixer for Google Photos reads the .json sidecar files created during a Google Takeout export and writes the stored metadata (date taken, GPS location, camera model) back into the photo EXIF header. TakeoutFix is a free metadata fixer and meta data fix tool that works entirely in your web browser."
            }
          },
          {
            "@type": "Question",
            "name": "What is a Google Takeout merger?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A Google Takeout merger is a tool that merges the photo and video binary files with their detached JSON metadata sidecar files produced by a Google Takeout export. TakeoutFix performs this merge locally on your device with no server, no upload, and no privacy risk."
            }
          },
          {
            "@type": "Question",
            "name": "Does TakeoutFix work as a meta data fixer?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. TakeoutFix is both a metadata fixer and a meta data fixer. It repairs EXIF metadata that was stripped out of your photos and videos during a Google Takeout or Google Photos export."
            }
          }
        ]
      }
    </script>

    <!-- HowTo Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "HowTo",
        "name": "How to Fix Google Takeout Metadata",
        "description": "How to restore missing photo dates, GPS, and EXIF metadata from Google Takeout using TakeoutFix - the free online metadata fixer.",
        "totalTime": "PT5M",
        "step": [
          {
            "@type": "HowToStep",
            "name": "Open TakeoutFix",
            "text": "Visit takeoutfix.pages.dev and sign in or continue as free user."
          },
          {
            "@type": "HowToStep",
            "name": "Select your Google Takeout folder",
            "text": "Click 'Restore My Data' and select the folder containing your Google Takeout photos and JSON sidecar files."
          },
          {
            "@type": "HowToStep",
            "name": "Run the metadata fixer",
            "text": "TakeoutFix automatically matches each photo to its JSON sidecar and writes back the date taken, GPS coordinates, and camera info into the EXIF header."
          },
          {
            "@type": "HowToStep",
            "name": "Download restored photos",
            "text": "Your photos are saved locally with full EXIF metadata restored. No upload, no cloud processing."
          }
        ]
      }
    </script>

  </head>
  <body class="bg-background text-foreground selection:bg-zinc-100 dark:selection:bg-zinc-800">
    <div class="flex flex-col min-h-screen bg-background">
      
      <!-- NAV CAPSULE -->
      <nav 
        id="navbar"
        class="fixed top-0 left-0 right-0 w-full z-50 px-6 md:px-8 py-2.5 transition-all duration-300 nav-header"
