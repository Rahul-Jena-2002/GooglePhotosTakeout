              </svg>
              <span class="text-base md:text-lg font-semibold tracking-tight">TakeoutFix</span>
            </a>

            <!-- Desktop Links -->
            <div class="hidden lg:flex gap-4 text-sm font-medium ml-4 font-sans items-center">
              <a href="/" class="nav-link text-zinc-400 hover:text-white px-3 py-1.5 transition-colors duration-150">Home</a>
              <a href="/restore-data" class="nav-link text-zinc-400 hover:text-white px-3 py-1.5 transition-colors duration-150">Restore Guide</a>
              <a href="/pricing" class="nav-link text-zinc-400 hover:text-white px-3 py-1.5 transition-colors duration-150">Pricing</a>
