---
import "../index.css";
import { ClientRouter } from "astro:transitions";
import AuthModal from "../react-pages/auth/AuthModal";
import GoogleOneTap from "../components/auth/GoogleOneTap";
import AdUnit from "../components/monetization/AdUnit";

interface Props {
  title?: string;
  description?: string;
  isToolPage?: boolean;
  isAuthPage?: boolean;
  robots?: string;
  sidebarAdCount?: number;
  showSideAds?: boolean;
}

const { 
  title = "TakeoutFix – Take Out Fix, Takeout Fixer & Metadata Fixer for Google Photos",
  description = "Restore missing EXIF dates, GPS coordinates, timestamps, and other metadata from Google Takeout archives. Everything runs locally in your browser—your files never leave your device. Not affiliated with Google.",
  isToolPage = false,
  isAuthPage = false,
  robots = isAuthPage ? "noindex, nofollow" : "index, follow",
  sidebarAdCount,
  showSideAds: propShowSideAds,
} = Astro.props;

// Normalized path check for routing & active links
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHomePage = currentPath === "/" || currentPath === "/index" || currentPath === "/index.html";


// Active Navigation Helper for Purple Highlighting
const isActive = (path: string) => (path === "/" ? currentPath === "/" : currentPath === path || currentPath.startsWith(path + "/"));

// Generate clean canonical URL (strip .html, /index, and trailing slashes)
const rawPath = Astro.url.pathname || "/";
const cleanPath = rawPath.replace(/\.html$/, "").replace(/\/index$/, "").replace(/\/$/, "") || "/";
const canonicalUrl = `https://takeoutfix.pages.dev${cleanPath === "" ? "/" : cleanPath}`;

// Cloudflare runtime secrets injection (No secrets hardcoded in git)
const cfRuntimeEnv = (Astro.locals as any)?.runtime?.env || (typeof process !== 'undefined' ? process.env : {}) || {};

const firebaseConfig = {
  apiKey: cfRuntimeEnv.PUBLIC_FIREBASE_API_KEY || import.meta.env.PUBLIC_FIREBASE_API_KEY || "",
  authDomain: cfRuntimeEnv.PUBLIC_FIREBASE_AUTH_DOMAIN || import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN || "",
  projectId: cfRuntimeEnv.PUBLIC_FIREBASE_PROJECT_ID || import.meta.env.PUBLIC_FIREBASE_PROJECT_ID || "",
  storageBucket: cfRuntimeEnv.PUBLIC_FIREBASE_STORAGE_BUCKET || import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET || "",
  messagingSenderId: cfRuntimeEnv.PUBLIC_FIREBASE_MESSAGING_SENDER_ID || import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID || "",
  appId: cfRuntimeEnv.PUBLIC_FIREBASE_APP_ID || import.meta.env.PUBLIC_FIREBASE_APP_ID || "",
  measurementId: cfRuntimeEnv.PUBLIC_FIREBASE_MEASUREMENT_ID || import.meta.env.PUBLIC_FIREBASE_MEASUREMENT_ID || "",
};

const googleClientId = cfRuntimeEnv.PUBLIC_GOOGLE_CLIENT_ID || import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Google AdSense Verification & Auto Ads (Canonical Placement) -->
    <meta name="google-adsense-account" content="ca-pub-7628736172233995" />
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7628736172233995"
      crossorigin="anonymous"
    ></script>
    <script is:inline define:vars={{ firebaseConfig, googleClientId }}>
      if (firebaseConfig && firebaseConfig.apiKey) {
        window.__FIREBASE_CONFIG__ = firebaseConfig;
      }
      if (googleClientId) {
        window.__GOOGLE_CLIENT_ID__ = googleClientId;
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Preload hero image to speed up LCP -->
    <link rel="preload" as="image" href="/hero-graphic-light.webp" fetchpriority="high" />
    <!-- Google Fonts: async non-render-blocking load with font-display:optional (no FOUT = no CLS) -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=optional" />
