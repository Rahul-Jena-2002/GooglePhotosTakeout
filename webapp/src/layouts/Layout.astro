    <!-- Theme Initialization Script -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("takeoutfix_theme");
        const theme = saved || "light";
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
          document.documentElement.classList.remove("light");
        } else {
          document.documentElement.classList.add("light");
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>

    <!-- Suppress React DevTools inspection in production -->
    <script is:inline>
      (() => {
        try {
          const isDev = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
          if (!isDev && typeof window !== "undefined" && typeof window.__REACT_DEVTOOLS_GLOBAL_HOOK__ === "object") {
            window.__REACT_DEVTOOLS_GLOBAL_HOOK__.isDisabled = true;
          }
        } catch (_) {}
      })();
    </script>

    <!-- Production Console Cleanliness (Preserves browser accessibility and inspectability for compliance) -->
    <script is:inline>
      (() => {
        try {
          const isDev = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
          if (!isDev) {
            // Suppress verbose console logging in production
            if (typeof console !== 'undefined') {
              console.log = () => {};
              console.debug = () => {};
              console.info = () => {};
            }
          }
        } catch (_) {}
      })();
    </script>

    <!-- Monetization Appearance Initializer (Reads cached opacity and size to prevent layout shifts) -->
    <script is:inline>
      (() => {
        try {
          const cached = localStorage.getItem("monetization_appearance");
          if (cached) {
            const { opacity, size } = JSON.parse(cached);
            if (opacity !== undefined) document.documentElement.style.setProperty("--ad-opacity", (opacity / 100).toString());
            if (size) document.documentElement.setAttribute("data-ad-size", size);
          }
        } catch (_) {}
      })();
    </script>

    <!-- Global Asset Error Handler: Auto-reload page when dynamic chunk/asset loads fail due to new deployments -->
    <script is:inline>
      const isLocalhost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
      window.addEventListener('error', (e) => {
        if (e.target && (e.target.tagName === 'SCRIPT' || e.target.tagName === 'LINK')) {
          const src = e.target.src || e.target.href;
          if (src && src.includes('/_astro/')) {
            console.warn('Dynamic asset load failed:', src);
            if (!isLocalhost) window.location.reload();
          }
        }
      }, true);

      window.addEventListener('unhandledrejection', (e) => {
        if (e.reason && (
          (e.reason.message && e.reason.message.includes('Failed to fetch dynamically imported module')) ||
          e.reason.name === 'TypeError'
        )) {
          const isAstroChunk = e.reason.stack && e.reason.stack.includes('/_astro/');
          if (isAstroChunk || (e.reason.message && e.reason.message.includes('/_astro/'))) {
            console.warn('Failed to fetch Astro module:', e.reason);
            if (!isLocalhost) window.location.reload();
          }
        }
      });
    </script>


    <!-- Google Cloud reCAPTCHA Enterprise (Loaded on-demand or deferred for Auth protection) -->
    <script is:inline>
      window.addEventListener('load', function() {
        if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') return;
        var rc = document.createElement('script');
        rc.src = "https://www.google.com/recaptcha/enterprise.js?render=6LdDpb4tAAAAADJHZzjrMIC-gvDXkAw0rhdgB5Sb";
        rc.async = true;
        rc.defer = true;
        document.head.appendChild(rc);
      });
    </script>

