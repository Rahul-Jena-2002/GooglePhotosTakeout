  <body class="bg-background text-foreground selection:bg-zinc-100 dark:selection:bg-zinc-800">
    <!-- Top Micro Navigation Progress Bar (Instant visual response on page change) -->
    <div id="astro-nav-progress" class="fixed top-0 left-0 right-0 h-[2.5px] z-[99999] pointer-events-none opacity-0 transition-opacity duration-150 bg-transparent">
      <div id="astro-nav-bar" class="h-full w-0 bg-gradient-to-r from-blue-500 via-indigo-500 to-purple-500 shadow-[0_0_8px_rgba(99,102,241,0.8)] transition-all duration-200 ease-out"></div>
    </div>

    <div class="flex flex-col min-h-screen bg-background">
      
      <!-- NAV CAPSULE -->
      <nav 
        id="navbar"
        class="fixed top-0 left-0 right-0 w-full z-50 px-3 sm:px-6 md:px-8 py-2.5 transition-all duration-300 nav-header"
      >
        <div class="w-full flex items-center justify-between relative z-10">
          <div class="flex items-center gap-2 md:gap-8">
            <!-- Hamburger Menu Button -->
            <button 
              id="hamburger-btn"
              aria-label="Toggle navigation menu"
              class="lg:hidden p-1 text-white/80 hover:text-white focus:outline-none transition-colors mr-1 cursor-pointer"
            >
              <svg id="hamburger-icon" class="w-5 h-5" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <svg id="close-icon" class="w-5 h-5 hidden" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>

            <!-- Brand Logo -->
            <a href="/" class="text-[17px] font-semibold tracking-tight text-white flex items-center gap-2" data-astro-prefetch="hover">
              <svg class="w-5 h-5 md:w-6 md:h-6 flex-shrink-0" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="logo-grad-astro" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#6366f1" />
                    <stop offset="100%" stop-color="#a855f7" />
                  </linearGradient>
                </defs>
                <rect x="9" y="1" width="1.5" height="1.5" fill="url(#logo-grad-astro)" />
                <rect x="14" y="2" width="1.5" height="1.5" fill="url(#logo-grad-astro)" />
                <rect x="11" y="4" width="1.5" height="1.5" fill="url(#logo-grad-astro)" />
