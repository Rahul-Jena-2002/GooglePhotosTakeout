    <!-- Automated Multi-Layer Background Route Preloader & Instant Hover Prioritizer -->
    <script is:inline>
      (() => {
        const coreRoutes = [
          '/tool',
          '/download',
          '/pricing',
          '/reviews',
          '/support',
          '/restore-data',
          '/terms',
          '/privacy',
          '/how-to-restore-metadata-from-takeout',
          '/google-photos-metadata-fix',
          '/fix-google-takeout-dates'
        ];

        const prefetched = new Set();

        const checkIsAdmin = () => {
          try {
            const cached = JSON.parse(localStorage.getItem("takeoutfix_user_data") || "{}");
            const adminData = localStorage.getItem("takeoutfix_admin_data");
            const adminSession = sessionStorage.getItem("takeoutfix_admin_session");
            const email = (cached.email || "").toLowerCase();
            return Boolean(
              cached.isAdmin ||
              cached.role ||
              adminData ||
              adminSession ||
              email.endsWith("@rahuljena.dev") ||
              email === "rahuljena.dev@gmail.com"
            );
          } catch (_) {
            return false;
          }
        };

        function prefetchUrl(url, highPriority = false) {
          if (!url || prefetched.has(url) || url.startsWith('#') || url.startsWith('http')) return;
          if (url.startsWith('/admin') && !checkIsAdmin()) return;
          prefetched.add(url);

          // 1. Native Link Prefetch
          try {
            const link = document.createElement('link');
            link.rel = 'prefetch';
            link.href = url;
            link.as = 'document';
            if (highPriority) {
              link.setAttribute('fetchpriority', 'high');
            }
            document.head.appendChild(link);
          } catch (_) {}

          // 2. Browser Cache Warming via fetch (populates HTTP/disk cache so Astro ClientRouter serves instantly)
          try {
            fetch(url, { priority: highPriority ? 'high' : 'low' }).catch(() => {});
          } catch (_) {}

          // 3. Speculation Rules (Instant Chromium prerender for high-priority hovered links)
          if (highPriority && typeof HTMLScriptElement !== 'undefined' && HTMLScriptElement.supports && HTMLScriptElement.supports('speculationrules')) {
            try {
              const specScript = document.createElement('script');
              specScript.type = 'speculationrules';
              specScript.textContent = JSON.stringify({
                prerender: [{ source: 'list', urls: [url], eagerness: 'immediate' }]
              });
              document.head.appendChild(specScript);
            } catch (_) {}
          }
        }

        // Instant Prioritization on hover or pointerdown
        const prioritizeTarget = (e) => {
          const anchor = e.target && e.target.closest ? e.target.closest('a') : null;
          if (!anchor) return;
          const href = anchor.getAttribute('href');
          if (href && href.startsWith('/')) {
            if (href.startsWith('/admin') && !checkIsAdmin()) return;
            prefetchUrl(href, true);
          }
        };

        document.addEventListener('mouseover', prioritizeTarget, { passive: true });
        document.addEventListener('touchstart', prioritizeTarget, { passive: true });
        document.addEventListener('pointerdown', prioritizeTarget, { passive: true });

        // Lazy prefetch the admin bundle quietly in background if user is authenticated as an admin
        const scheduleAdminPrefetch = () => {
          if (checkIsAdmin()) {
            if ('requestIdleCallback' in window) {
              window.requestIdleCallback(() => prefetchUrl('/admin', false), { timeout: 4000 });
            } else {
              setTimeout(() => prefetchUrl('/admin', false), 2500);
            }
          }
        };

        // Once home page is loaded, systematically prefetch all user routes in the background
        window.addEventListener('load', () => {
          let delay = 100;
          coreRoutes.forEach((route) => {
            setTimeout(() => {
              prefetchUrl(route, false);
            }, delay);
            delay += 120;
          });
          setTimeout(scheduleAdminPrefetch, delay + 500);
        });

        // Also trigger admin prefetch when an admin signs in
        window.addEventListener('takeoutfix:auth-success', () => {
          setTimeout(scheduleAdminPrefetch, 800);
        });
      })();
    </script>
    
