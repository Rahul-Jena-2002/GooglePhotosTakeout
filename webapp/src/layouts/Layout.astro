    <div id="vanilla-toast-container" class="fixed top-[80px] right-6 z-[99999] flex flex-col gap-2.5 max-w-sm w-[calc(100%-2rem)] pointer-events-none items-end"></div>

    <!-- Global Auth Modal (popup sign-in/sign-up, available on every page) -->
    <AuthModal client:only="react" />
    <GoogleOneTap client:only="react" />

    <!-- CLIENT SIDE EVENT HANDLERS AND AUTH LISTENER -->
    <script>
      import * as Sentry from "@sentry/astro";
      import { auth, db, googleProvider, signInWithPopup, signOut } from "../firebase";

      (window as any).showVanillaToast = (message: string, type: "error" | "success" = "error", title?: string) => {
        const container = document.getElementById("vanilla-toast-container");
        if (!container) return;
        const toast = document.createElement("div");
        const defaultTitle = title || (type === "error" ? "Notice" : "Success");
        const defaultIcon = type === "error" ? "⚠️" : "✅";

        toast.className = `toast-right-slide pointer-events-auto flex items-start gap-3.5 p-4 rounded-xl border text-left shadow-2xl transition-all duration-300 w-full 
          bg-white border-[#fee2e2] shadow-[0_10px_30px_rgba(0,0,0,0.06)] 
          dark:bg-[#18181b] dark:border-[#27272a] dark:shadow-[0_10px_30px_rgba(0,0,0,0.5)]`;

        toast.innerHTML = `
          <span class="text-base mt-0.5 flex-shrink-0 select-none ${
            type === "error" ? "text-[#ef4444] dark:text-[#f87171]" : "text-emerald-500"
          }">${defaultIcon}</span>
          <div class="flex-grow min-w-0 font-sans">
            <strong class="block text-sm font-bold text-[#111827] dark:text-white leading-tight">${defaultTitle}</strong>
            <p class="text-xs font-medium text-[#4b5563] dark:text-[#9ca3af] mt-1 leading-relaxed">${message}</p>
          </div>
        `;
        container.appendChild(toast);
        setTimeout(() => {
          toast.classList.add("show");
        }, 10);

        const closeToast = () => {
          toast.classList.remove("show");
          setTimeout(() => {
            toast.remove();
          }, 450);
        };

        setTimeout(closeToast, 4500);
      };
      import { initTheme, setupThemeEvents } from "../lib/browserTheme";
      import { initMobileMenu, highlightActiveLinks, setupNavDropdowns } from "../lib/browserNav";
      import { detectAndStoreCountry } from "../lib/browserCountry";
      import { checkAdBlock, setupAdblockEvents, setUserInteracted } from "../lib/browserAdblock";
      import { setupAuthListeners, setupAuthEvents, syncUserUI } from "../lib/browserAuth";
      import { renderNotifications } from "../lib/browserNotifications";
      import { initPowerManager } from "../lib/powerManager";

      initPowerManager();

      const isDevHost = typeof window !== 'undefined' && (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1');
      if (!isDevHost && import.meta.env.PROD) {
        Sentry.init({
          dsn: "https://789a81283ea0ec0d1f762a19102c7a91@o4507198765277184.ingest.us.sentry.io/4508912384729182",
        });
      }

      // Dev Console Live Logger to browser_console.log (throttled & batched to prevent navigation lag)
      if (import.meta.env.DEV) {
        let logQueue: { type: string; message: string }[] = [];
        let flushTimer: any = null;

        const flushLogs = () => {
          if (logQueue.length === 0) return;
          const batch = logQueue.splice(0, 20);
          fetch('/api/dev-log', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(batch.length === 1 ? batch[0] : { type: 'BATCH', message: batch.map(b => `[${b.type}] ${b.message}`).join('\n') }),
            keepalive: true
          }).catch(() => {});
        };

        const sendDevLog = (type: string, args: any[], immediate = false) => {
          try {
            const message = args.map(a => {
              if (a instanceof Error) return a.stack || a.message;
              if (typeof a === 'object') {
                try { return JSON.stringify(a); } catch { return String(a); }
              }
              return String(a);
            }).join(' ');
            if (message.includes('/api/dev-log')) return;
            logQueue.push({ type, message });

            if (immediate) {
              flushLogs();
            } else if (!flushTimer) {
              flushTimer = setTimeout(() => {
                flushTimer = null;
                flushLogs();
              }, 1200);
            }
          } catch {}
        };

        const _log = console.log;
        const _warn = console.warn;
        const _error = console.error;

        console.log = (...args) => { _log(...args); sendDevLog('LOG', args); };
        console.warn = (...args) => { _warn(...args); sendDevLog('WARN', args); };
        console.error = (...args) => { _error(...args); sendDevLog('ERROR', args, true); };

        window.addEventListener('error', (e) => sendDevLog('UNCAUGHT', [e.message, e.filename, e.lineno, e.colno], true));
        window.addEventListener('unhandledrejection', (e) => sendDevLog('UNHANDLED_REJECTION', [e.reason?.stack || e.reason?.message || e.reason], true));
      }

      const setupInteractionEvents = () => {
        initPowerManager();
        setupThemeEvents();
        setupNavDropdowns();
        setupAdblockEvents();
        setupAuthEvents();
      };

      // Register Auth State Listener once globally
      setupAuthListeners();

      // Instant Top Micro-Progress Bar Feedback on navigation
      document.addEventListener("astro:before-preparation", () => {
        const progress = document.getElementById("astro-nav-progress");
        const bar = document.getElementById("astro-nav-bar");
        if (progress && bar) {
          progress.style.opacity = "1";
          bar.style.transition = "width 0.3s cubic-bezier(0.4, 0, 0.2, 1)";
          bar.style.width = "35%";
          setTimeout(() => { if (bar.style.width === "35%") bar.style.width = "65%"; }, 150);
          setTimeout(() => { if (bar.style.width === "65%") bar.style.width = "80%"; }, 400);
        }

        // Close mobile menu immediately on nav start
        const mobileMenu = document.getElementById("mobile-menu");
        const hamburgerIcon = document.getElementById("hamburger-icon");
        const closeIcon = document.getElementById("close-icon");
        if (mobileMenu && !mobileMenu.classList.contains("hidden")) {
          mobileMenu.classList.add("hidden");
          hamburgerIcon?.classList.remove("hidden");
          closeIcon?.classList.add("hidden");
        }
      });

      // Preserve theme across Astro page transitions before DOM swap
      document.addEventListener("astro:before-swap", (e: any) => {
        const bar = document.getElementById("astro-nav-bar");
        if (bar) bar.style.width = "93%";

        const savedTheme = localStorage.getItem("takeoutfix_theme") || (document.documentElement.classList.contains("dark") ? "dark" : "light");
        if (e.newDocument && e.newDocument.documentElement) {
          e.newDocument.documentElement.classList.remove("light", "dark");
          e.newDocument.documentElement.classList.add(savedTheme);
        }
      });

      // Complete progress bar immediately after DOM swap (before React hydration)
      // This prevents the bar from appearing "stuck" while client:only components load
      document.addEventListener("astro:after-swap", () => {
        const savedTheme = localStorage.getItem("takeoutfix_theme") || "light";
        if (savedTheme === "dark") {
          document.documentElement.classList.add("dark");
          document.documentElement.classList.remove("light");
        } else {
          document.documentElement.classList.add("light");
          document.documentElement.classList.remove("dark");
        }
        try { initTheme(); } catch (e) {}

        // Complete bar right at DOM swap — page visually ready
        const progress = document.getElementById("astro-nav-progress");
        const bar = document.getElementById("astro-nav-bar");
        if (progress && bar) {
          bar.style.width = "100%";
          setTimeout(() => {
            progress.style.opacity = "0";
            setTimeout(() => { bar.style.transition = "none"; bar.style.width = "0%"; }, 200);
          }, 150);
        }
      });

      // Hook for initial load and page-load transitions (React hydration complete)
      document.addEventListener("astro:page-load", () => {
        try { initTheme(); } catch (e) {}
        try { detectAndStoreCountry(); } catch (e) {}
        try { initMobileMenu(); } catch (e) {}
        try { syncUserUI(); } catch (e) {}
        try { renderNotifications(); } catch (e) {}
        try { setupInteractionEvents(); } catch (e) {}
        try { highlightActiveLinks(); } catch (e) {}
        try { checkAdBlock(); } catch (e) {}
      });

      // Stage 2: Wait for folder selection or restore button click
      window.addEventListener('takeoutfix-action-triggered', () => {
        setUserInteracted(true);
        checkAdBlock();
      });

      // PWA Service Worker Registration & Localhost Aggressive Cleanup
      if ("serviceWorker" in navigator) {
        const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
        if (isLocal) {
          navigator.serviceWorker.getRegistrations().then((registrations) => {
            for (const registration of registrations) {
              registration.unregister();
            }
          }).catch(() => {});
          if ("caches" in window) {
            caches.keys().then((keys) => {
              for (const key of keys) caches.delete(key);
            }).catch(() => {});
          }
        } else {
          // Purge stale service worker caches (v5 and below) from client browsers
          if ("caches" in window) {
            caches.keys().then((keys) => {
              for (const key of keys) {
                if (key.includes('v5') || key.includes('v4') || key.includes('v3') || key.includes('v2') || key.includes('v1')) {
                  caches.delete(key);
                }
              }
            }).catch(() => {});
          }
          window.addEventListener("load", () => {
            navigator.serviceWorker.register("/sw.js").then((reg) => {
              reg.update().catch(() => {});
            }).catch(() => {});
          });
        }
      }

    </script>
