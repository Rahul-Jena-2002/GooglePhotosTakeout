      @media (min-width: 1536px) {
        .sidebar-gutter-ad {
          width: var(--ad-gutter-width-2xl);
        }
      }
      .sidebar-gutter-ad:hover {
        opacity: 1 !important;
      }
      .sidebar-gutter-ad .ad-embed-container {
        min-height: 120px;
        max-height: 155px;
        width: 100%;
      }
      .sidebar-gutter-ad .ad-embed-container iframe {
        width: 100% !important;
        min-height: 120px !important;
        max-height: 150px !important;
        border: 0 !important;
