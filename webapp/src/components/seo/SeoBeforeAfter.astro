---
interface Props {
  title?: string;
  beforeTitle?: string;
  beforeItems: string[];
  afterTitle?: string;
  afterItems: string[];
}

const {
  title = "Before & After TakeoutFix",
  beforeTitle = "Before Restoration",
  beforeItems,
  afterTitle = "After TakeoutFix",
  afterItems,
} = Astro.props;
---

<div class="max-w-5xl mx-auto mb-20 relative z-10">
  <h2 class="text-2xl sm:text-3xl font-bold text-white text-center mb-10">{title}</h2>
  <div class="grid md:grid-cols-2 gap-6 sm:gap-8">
    <!-- Before Box -->
    <div class="bg-red-950/20 border border-red-500/20 rounded-2xl p-6 sm:p-8 space-y-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl">❌</span>
        <h3 class="text-lg font-bold text-red-400">{beforeTitle}</h3>
      </div>
      <ul class="space-y-2.5 text-xs sm:text-sm text-zinc-400">
        {beforeItems.map((item) => (
          <li class="flex items-start gap-2">
            <span class="text-red-400 mt-0.5">•</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- After Box -->
    <div class="bg-emerald-950/20 border border-emerald-500/20 rounded-2xl p-6 sm:p-8 space-y-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl">✅</span>
        <h3 class="text-lg font-bold text-emerald-400">{afterTitle}</h3>
      </div>
      <ul class="space-y-2.5 text-xs sm:text-sm text-zinc-300">
        {afterItems.map((item) => (
          <li class="flex items-start gap-2">
            <span class="text-emerald-400 mt-0.5">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>
