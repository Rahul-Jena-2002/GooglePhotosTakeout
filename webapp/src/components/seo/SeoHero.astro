---
interface Props {
  badgeText: string;
  gradientTitle: string;
  titleSuffix?: string;
  subtitle: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  gradientClass?: string;
}

const {
  badgeText,
  gradientTitle,
  titleSuffix = "",
  subtitle,
  primaryCtaText = "Start Restoring Free →",
  primaryCtaHref = "/tool",
  secondaryCtaText = "See How It Works",
  secondaryCtaHref = "/restore-data",
  gradientClass = "from-indigo-400 via-purple-400 to-pink-500",
} = Astro.props;
---

<div class="max-w-4xl mx-auto text-center mb-16 sm:mb-20 relative z-10">
  <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-zinc-900/90 border border-zinc-800 text-xs font-semibold text-zinc-300 mb-6 font-mono shadow-sm">
    <span>✨</span>
    <span>{badgeText}</span>
  </div>

  <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight">
    <span class={`text-transparent bg-clip-text bg-gradient-to-r ${gradientClass}`}>
      {gradientTitle}
    </span>
    {titleSuffix && ` ${titleSuffix}`}
  </h1>

  <p class="text-base sm:text-lg md:text-xl text-zinc-400 max-w-3xl mx-auto leading-relaxed mb-8">
    {subtitle}
  </p>

  <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
    <a href={primaryCtaHref} class="w-full sm:w-auto">
      <button class="w-full sm:w-auto glass-capsule interactive px-8 h-12 sm:h-14 font-semibold text-white flex items-center justify-center gap-2 shadow-lg shadow-indigo-500/10">
        <span>{primaryCtaText}</span>
      </button>
    </a>
    {secondaryCtaHref && (
      <a href={secondaryCtaHref} class="w-full sm:w-auto">
        <button class="w-full sm:w-auto glass-capsule interactive px-7 h-12 sm:h-14 font-semibold text-zinc-300 hover:text-white flex items-center justify-center">
          <span>{secondaryCtaText}</span>
        </button>
      </a>
    )}
  </div>
</div>
