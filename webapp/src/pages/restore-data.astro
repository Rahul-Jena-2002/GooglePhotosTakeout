---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Icon from "../components/ui/Icon.astro";
import AdUnit from "../components/monetization/AdUnit";

// Structured Schema.org data for SEO and Google Rich Results
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why does Google Takeout create separate JSON files?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Google Takeout exports Google Photos metadata—including original capture timestamps, GPS coordinates, descriptions, and album tags—into secondary .json sidecar files instead of embedding them directly into your photo and video headers."
      }
    },
    {
      "@type": "Question",
      "name": "Why are my photo dates wrong after downloading Google Takeout?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When you extract a Takeout ZIP archive, your operating system assigns the current extraction or download timestamp as the file's 'Date Created' filesystem attribute. Because the original date was stored in the separate JSON sidecar, image viewers that rely on filesystem dates show today's date."
      }
    },
    {
      "@type": "Question",
      "name": "Does TakeoutFix upload my photos or videos to any server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. TakeoutFix operates 100% locally on your computer using client-side Web Workers and the File System Access API. Your photos, videos, and metadata never leave your device."
      }
    },
    {
      "@type": "Question",
      "name": "Can TakeoutFix restore GPS locations and coordinates?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. If your Google Photos metadata JSON sidecar contains latitude and longitude data, TakeoutFix injects those coordinates back into standard EXIF GPS tags (GPSLatitude, GPSLongitude, and GPSAltitude)."
      }
    },
    {
      "@type": "Question",
      "name": "Will TakeoutFix compress or re-encode my photos and videos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. TakeoutFix performs lossless binary metadata injection. The underlying JPEG, HEIC, PNG, or video bitstreams are preserved bit-for-bit without lossy compression or transcoding."
      }
    },
    {
      "@type": "Question",
      "name": "Does TakeoutFix support Apple HEIC and Live Photos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. TakeoutFix supports Apple HEIC images and pairs both the still HEIC photo and its companion MOV video component with their respective Takeout sidecar metadata."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if a JSON sidecar file is missing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "TakeoutFix includes a resilient fallback system. If a sidecar JSON is absent, it inspects embedded filename date patterns (e.g., IMG_20230815_142335.jpg) or interpolates capture time from adjacent media in the same directory."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use TakeoutFix with multi-part Takeout archives?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Extract all Takeout ZIP parts into your folder structure, and TakeoutFix will scan across all nested album folders to pair media with their sidecars."
      }
    }
  ]
};
---

<Layout 
  title="Restore Google Photos Dates & Metadata | TakeoutFix Complete Guide" 
  description="Google Takeout separated your photo dates and GPS into JSON sidecars? Learn what TakeoutFix fixes, how it matches files locally in your browser, and how to safely restore your library."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-background text-foreground min-h-screen py-16 sm:py-24 px-4 sm:px-6 lg:px-8 relative overflow-hidden font-sans">
    
    <!-- ========================================================================= -->
    <!-- 1. HERO SECTION                                                          -->
    <!-- ========================================================================= -->
    <header class="max-w-7xl mx-auto text-center mb-16 relative">
      <!-- Trust Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs font-semibold text-zinc-800 dark:text-zinc-300 mb-6 font-mono shadow-xs">
        <Icon name="shield-check" class="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
        <span>100% Client-Side Engine • Zero Server Uploads</span>
      </div>

      <!-- Problem-Centric Main Headline -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-zinc-900 dark:text-white mb-6 leading-tight">
        <span class="inline-block">Restore Your Google Photos</span> <span class="inline-block">Dates &amp; Metadata</span>
      </h1>

      <!-- Clear Value Proposition -->
      <p class="text-base sm:text-lg md:text-xl text-zinc-600 dark:text-zinc-400 max-w-4xl mx-auto font-normal leading-relaxed mb-8">
        Google Takeout separates your photos and videos from their metadata into disconnected <code class="text-xs px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 font-mono font-bold">.json</code> sidecar files. TakeoutFix automatically pairs them back and restores original capture dates, GPS locations, and camera metadata — entirely on your device.
      </p>

      <!-- Scannable 5-Step Process Pill Strip -->
      <div class="inline-flex flex-wrap items-center justify-center gap-2 sm:gap-3 p-2.5 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 text-xs font-medium text-zinc-600 dark:text-zinc-400 mb-8 max-w-4xl mx-auto">
        <span class="flex items-center gap-1 font-semibold text-zinc-900 dark:text-zinc-200">1. Google Takeout</span>
        <span class="text-zinc-400 dark:text-zinc-600">→</span>
        <span class="flex items-center gap-1">2. Select Photos</span>
        <span class="text-zinc-400 dark:text-zinc-600">→</span>
        <span class="flex items-center gap-1">3. Download ZIP</span>
        <span class="text-zinc-400 dark:text-zinc-600">→</span>
        <span class="flex items-center gap-1 font-semibold text-zinc-900 dark:text-zinc-200">4. Open TakeoutFix</span>
        <span class="text-zinc-400 dark:text-zinc-600">→</span>
        <span class="flex items-center gap-1 text-emerald-600 dark:text-emerald-400 font-bold">5. Restored ✓</span>
      </div>

      <!-- Hero Call To Action -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-5">
        <a href="/tool" class="w-full sm:w-auto">
          <button class="btn-monochrome-primary px-8 h-13 font-bold rounded-xl transition-all flex items-center justify-center gap-2 w-full sm:w-auto cursor-pointer shadow-md hover:shadow-lg">
            <span>Restore My Takeout</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </button>
        </a>
        <a href="/download" class="w-full sm:w-auto">
          <button class="btn-monochrome-secondary px-6 h-13 font-semibold rounded-xl transition-all flex items-center justify-center gap-2 w-full sm:w-auto cursor-pointer">
            <Icon name="download" class="w-4 h-4" />
            <span>Download Desktop App</span>
          </button>
        </a>
      </div>

      <!-- Prominent Privacy Callout Right Below CTA -->
      <div class="flex items-center justify-center gap-2 text-xs font-medium text-zinc-500 dark:text-zinc-400">
        <span class="text-emerald-600 dark:text-emerald-400">🔒</span>
        <span>Your photos never leave your device. 100% local processing in your browser with zero server uploads.</span>
      </div>
    </header>

    <!-- Sponsored Recommendations: Top Guide Banner -->
    <section class="max-w-7xl mx-auto mb-12 relative z-10" aria-label="Sponsored recommendations">
      <AdUnit client:only="react" placement="ARTICLE_TOP" />
    </section>

    <!-- ========================================================================= -->
    <!-- 2. INTERACTIVE SIMULATION SANDBOX                                        -->
    <!-- ========================================================================= -->
    <section class="max-w-7xl mx-auto mb-24" aria-label="Interactive Sandbox Demo">
      <div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 shadow-sm relative overflow-hidden">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-6 mb-6 border-b border-zinc-100 dark:border-zinc-800/80 gap-4">
          <div>
            <div class="flex items-center gap-2 text-xs font-mono font-bold text-zinc-500 uppercase tracking-wider mb-1">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Live Restoration Simulation
            </div>
            <h2 class="text-xl font-bold text-zinc-900 dark:text-white">How TakeoutFix processes your library</h2>
          </div>
          <div class="text-xs font-mono font-bold px-3 py-1.5 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
            Engine Status: Ready
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Left: Input Tree Simulation -->
          <div class="p-4 rounded-xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800/80 font-mono text-xs text-zinc-600 dark:text-zinc-400 space-y-2">
            <div class="text-zinc-900 dark:text-zinc-200 font-bold flex items-center gap-1.5 pb-2 border-b border-zinc-200 dark:border-zinc-800">
              📁 Google Photos / Vacation 2023
            </div>
            <div class="flex items-center justify-between py-1 text-zinc-700 dark:text-zinc-300">
              <span>├── IMG_3021.heic</span>
              <span class="text-[10px] text-zinc-400">Media</span>
            </div>
            <div class="flex items-center justify-between py-1 text-zinc-500">
              <span>├── IMG_3021.heic.json</span>
              <span class="text-[10px] text-amber-500">Sidecar</span>
            </div>
            <div class="flex items-center justify-between py-1 text-zinc-700 dark:text-zinc-300">
              <span>├── IMG_3022-edited.jpg</span>
              <span class="text-[10px] text-zinc-400">Edited</span>
            </div>
            <div class="flex items-center justify-between py-1 text-zinc-500">
              <span>├── IMG_3022.jpg.json</span>
              <span class="text-[10px] text-amber-500">Sidecar</span>
            </div>
            <div class="flex items-center justify-between py-1 text-zinc-700 dark:text-zinc-300">
              <span>└── VID_20230815.mp4</span>
              <span class="text-[10px] text-zinc-400">Video</span>
            </div>
          </div>

          <!-- Right: Telemetry & Result -->
          <div class="flex flex-col justify-between p-4 rounded-xl bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800/80">
            <div class="space-y-3 font-mono text-xs">
              <div class="flex justify-between items-center text-zinc-600 dark:text-zinc-400">
                <span>Files Scanned</span>
                <span class="font-bold text-zinc-900 dark:text-zinc-200">1,824 files</span>
              </div>
              <div class="flex justify-between items-center text-zinc-600 dark:text-zinc-400">
                <span>Media Items Located</span>
                <span class="font-bold text-zinc-900 dark:text-zinc-200">912 items</span>
              </div>
              <div class="flex justify-between items-center text-emerald-600 dark:text-emerald-400 font-bold">
                <span>Metadata Matched &amp; Injected</span>
                <span>891 matched ✓</span>
              </div>
              <div class="flex justify-between items-center text-zinc-500">
                <span>Unmatched / No Sidecar</span>
                <span>21 fallback dates</span>
              </div>
              <div class="w-full bg-zinc-200 dark:bg-zinc-800 h-2 rounded-full overflow-hidden mt-2">
                <div class="bg-emerald-500 h-full rounded-full w-[97%]"></div>
              </div>
            </div>

            <div class="pt-4 mt-4 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-between text-xs">
              <span class="font-semibold text-zinc-900 dark:text-zinc-200">Output Folder:</span>
              <span class="px-2.5 py-1 rounded-md bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 font-mono font-bold text-[11px] border border-emerald-200 dark:border-emerald-800/50">
                891 files ready to import
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 3. WHAT PROBLEM DOES THIS SOLVE?                                         -->
    <!-- ========================================================================= -->
    <section class="max-w-7xl mx-auto mb-24" aria-label="Problem Statement">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-extrabold text-zinc-900 dark:text-white mb-4">
          What Problem Does TakeoutFix Solve?
        </h2>
        <p class="text-base text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto">
          Google specifically documents that downloaded files can receive new filesystem timestamps and that additional metadata appears in separate JSON files (<a href="https://support.google.com/photos/answer/3024190" target="_blank" rel="noopener noreferrer" class="underline hover:text-zinc-900 dark:hover:text-white font-medium">Google Help</a>).
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 items-stretch">
        <!-- Before Card -->
        <div class="p-6 sm:p-8 rounded-2xl bg-red-50/40 dark:bg-red-950/10 border border-red-200/80 dark:border-red-900/40 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 font-mono text-xs font-bold text-red-600 dark:text-red-400 uppercase tracking-wider mb-4">
              <span class="w-2 h-2 rounded-full bg-red-500"></span>
              Your Google Takeout Right Now
            </div>
            <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-3">Disconnected Media &amp; Broken Timestamps</h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-6 leading-relaxed">
              When you download your archive, all your photos are dumped alongside matching <code class="text-xs px-1.5 py-0.5 rounded bg-white dark:bg-zinc-800 border border-red-200 dark:border-red-900/50 font-mono">.json</code> files. Your operating system sets the file creation date to <em>today</em>, flattening your photo timeline completely.
            </p>
            
            <div class="p-4 rounded-xl bg-white dark:bg-zinc-900 border border-red-200/80 dark:border-red-900/40 space-y-2.5 font-mono text-xs">
              <div class="text-zinc-700 dark:text-zinc-300">📁 IMG_3021.jpg <span class="text-red-500 font-bold block sm:inline sm:float-right text-[11px]">Date: Today (Broken)</span></div>
              <div class="text-zinc-400 dark:text-zinc-500">📄 IMG_3021.jpg.supplemental-metadata.json</div>
              <div class="text-zinc-700 dark:text-zinc-300 pt-2 border-t border-zinc-100 dark:border-zinc-800">📁 IMG_3022.jpg <span class="text-red-500 font-bold block sm:inline sm:float-right text-[11px]">GPS: Stripped</span></div>
              <div class="text-zinc-400 dark:text-zinc-500">📄 IMG_3022.jpg.supplemental-metadata.json</div>
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-red-200/60 dark:border-red-900/30 text-xs text-red-700 dark:text-red-400">
            Result: Importing into Apple Photos or Google Photos scatters your library out of chronological order.
          </div>
        </div>

        <!-- After Card -->
        <div class="p-6 sm:p-8 rounded-2xl bg-emerald-50/40 dark:bg-emerald-950/10 border border-emerald-200/80 dark:border-emerald-900/40 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 font-mono text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider mb-4">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              After TakeoutFix
            </div>
            <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-3">Re-Embedded EXIF &amp; Restored Timeline</h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-6 leading-relaxed">
              TakeoutFix parses the JSON sidecar, extracts the true capture time and GPS coordinates, and writes them directly into the photo or video's binary EXIF headers. The JSON files are cleaned up, leaving ready-to-use media files.
            </p>

            <div class="p-4 rounded-xl bg-white dark:bg-zinc-900 border border-emerald-200/80 dark:border-emerald-900/40 space-y-2.5 font-mono text-xs">
              <div class="text-zinc-800 dark:text-zinc-200 font-bold">
                ✓ IMG_3021.jpg
                <span class="text-emerald-600 dark:text-emerald-400 block sm:inline sm:float-right text-[11px]">Date: 14 Aug 2019</span>
              </div>
              <div class="text-[11px] text-zinc-500 pl-3">↳ GPS: 40.7128° N, 74.0060° W • EXIF Restored</div>
              <div class="text-zinc-800 dark:text-zinc-200 font-bold pt-2 border-t border-zinc-100 dark:border-zinc-800">
                ✓ IMG_3022.jpg
                <span class="text-emerald-600 dark:text-emerald-400 block sm:inline sm:float-right text-[11px]">Date: 22 Dec 2021</span>
              </div>
              <div class="text-[11px] text-zinc-500 pl-3">↳ GPS: Restored • Camera: iPhone 13 Pro</div>
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-emerald-200/60 dark:border-emerald-900/30 text-xs text-emerald-700 dark:text-emerald-400">
            Result: Photos appear in perfect chronological order on iPhone, Mac, Android, and Windows.
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 4. IS THIS SAFE? (EARLY TRUST SECTION)                                    -->
    <!-- ========================================================================= -->
    <section class="max-w-7xl mx-auto mb-24" aria-label="Privacy and Safety Reassurance">
      <div class="p-8 sm:p-10 rounded-2xl bg-white dark:bg-zinc-900 text-zinc-900 dark:text-white border border-zinc-200 dark:border-zinc-800 shadow-sm">


        <div class="flex items-center gap-3 mb-6">
          <div class="w-12 h-12 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
            <Icon name="shield-check" class="w-6 h-6" />
          </div>
          <div>
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Privacy &amp; Data Security</span>
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">Is my photo library uploaded to your servers?</h2>
          </div>
        </div>

        <div class="space-y-4 text-zinc-600 dark:text-zinc-300 text-sm sm:text-base leading-relaxed">
          <p class="text-lg font-semibold text-zinc-900 dark:text-white">
            <strong>No. TakeoutFix operates entirely within your browser or on your desktop. Your photos, videos, and JSON metadata are never uploaded to any cloud or server.</strong>
          </p>
          <p>
            When you choose a folder in the web application, your browser uses the modern, standard <strong>File System Access API</strong> to grant temporary, local-only read/write access to that specific directory. Processing occurs inside isolated client-side Web Workers. You can even disconnect your internet connection while TakeoutFix runs and it will continue repairing your files without interruption.
          </p>
        </div>

        <!-- Before you start callout -->
        <div class="mt-8 p-4 rounded-xl bg-zinc-100 dark:bg-zinc-800/90 border border-zinc-200 dark:border-zinc-700/80 flex items-start gap-3 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300">
          <Icon name="alert-triangle" class="w-5 h-5 text-amber-400 flex-shrink-0 mt-0.5" />
          <div>
            <strong class="text-zinc-900 dark:text-white block mb-0.5">Safety Best Practice: Keep your original Takeout archive</strong>
            TakeoutFix creates repaired copies in a separate output directory. We recommend preserving your original unedited Google Takeout ZIP files as an immutable backup.
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 5. SCANNABLE 01–06 RESTORATION FLOW WITH EXPANDABLE DETAILS               -->
    <!-- ========================================================================= -->
    <section class="max-w-7xl mx-auto mb-24" id="dates-guide" aria-label="Restoration Steps">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-extrabold text-zinc-900 dark:text-white mb-4">
          Step-by-Step Restoration Guide
        </h2>
        <p class="text-base text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto">
          Follow these six quick steps to export from Google and restore your entire library.
        </p>
      </div>

      <div class="space-y-4">
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 shadow-xs transition-all">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-xl bg-zinc-100 dark:bg-zinc-800 font-mono text-xs font-bold text-zinc-900 dark:text-zinc-200">
              01
            </div>
            <div class="flex-1">
              <h3 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-white">
                Export Google Photos
              </h3>
              <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">
                Open <a href="https://takeout.google.com" target="_blank" rel="noopener noreferrer" class="underline font-semibold text-zinc-900 dark:text-white">takeout.google.com</a> and select <strong>Google Photos</strong> only.
              </p>
              
              <details class="mt-3 group">
                <summary class="text-xs font-semibold text-zinc-600 dark:text-zinc-400 cursor-pointer hover:text-zinc-900 dark:hover:text-white inline-flex items-center gap-1 select-none">
                  <span>Detailed export instructions</span>
                  <span class="group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <div class="pt-3 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed space-y-2 border-t border-zinc-100 dark:border-zinc-800/80 mt-2">
                  <p>By default, Google selects every service in your Google Account. Click <strong>"Deselect all"</strong> at the top of the list, then scroll down to check <strong>Google Photos</strong> only. This prevents downloading unrelated emails, drive files, or maps history.</p>
                  <p>You can also click "All photo albums included" to deselect auto-generated year folders if you only want specific albums.</p>
                </div>
              </details>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 shadow-xs transition-all">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-xl bg-zinc-100 dark:bg-zinc-800 font-mono text-xs font-bold text-zinc-900 dark:text-zinc-200">
              02
            </div>
            <div class="flex-1">
              <h3 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-white">
                Download your archive
              </h3>
              <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">
                Choose your archive split size and download all generated ZIP parts.
              </p>

              <details class="mt-3 group">
                <summary class="text-xs font-semibold text-zinc-600 dark:text-zinc-400 cursor-pointer hover:text-zinc-900 dark:hover:text-white inline-flex items-center gap-1 select-none">
                  <span>Split size recommendations</span>
                  <span class="group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <div class="pt-3 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed space-y-2 border-t border-zinc-100 dark:border-zinc-800/80 mt-2">
                  <p>We recommend selecting <strong>10GB or 50GB</strong> archive sizes if you have a large library. The default 2GB split can leave you with dozens of separate ZIP downloads. Make sure every part has finished downloading completely before extracting.</p>
                </div>
              </details>
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 shadow-xs transition-all">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 flex items-center justify-center w-10 h-10 rounded-xl bg-zinc-100 dark:bg-zinc-800 font-mono text-xs font-bold text-zinc-900 dark:text-zinc-200">
              03
