---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import AdUnit from "../components/monetization/AdUnit";
import Compare from "../components/ui/Compare";
---

<Layout 
  title="TakeoutFix – Merge Google Photos JSON Metadata & Fix Export Dates"
  description="TakeoutFix merges Google Photos JSON sidecar metadata back into your photos and videos. Fix dates, GPS coordinates, and album timestamps offline in your browser with zero command-line tools."
  showSideAds={false}
>
  <div class="flex flex-col items-center bg-background text-foreground w-full overflow-x-hidden aceternity-grid">
    
    <!-- 1. HERO SECTION -->
    <section class="w-full max-w-7xl mx-auto px-6 pt-32 pb-20 relative z-10 font-sans">
      <div class="grid lg:grid-cols-12 gap-12 items-center text-left">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-zinc-100 dark:bg-zinc-900 rounded-full border border-zinc-200 dark:border-zinc-800 text-xs font-semibold text-zinc-900 dark:text-zinc-100 uppercase tracking-wider">
            ✓ Free to use · No subscription required
          </div>
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-foreground leading-tight">
            Restore your Google Takeout photos with TakeoutFix.
          </h1>
          <p class="text-lg sm:text-xl text-zinc-500 font-normal leading-relaxed max-w-2xl">
            Start restoring your photos for free, directly on your computer. Google Takeout separates dates and locations into .json files—TakeoutFix glues them back together so your memories stay in the correct order.
          </p>
          
          <!-- Mobile Image -->
          <div class="block lg:hidden relative animate-fade-in my-6">
            <div class="absolute inset-0 bg-zinc-500/5 blur-[120px] rounded-full"></div>
            <img 
              src="/hero-graphic-light.webp" 
              alt="TakeoutFix local workspace metadata restoration tool interface screenshot" 
              class="relative rounded-lg border border-zinc-200 dark:border-zinc-800 shadow-none w-full object-cover max-h-[300px] block dark:hidden"
              fetchpriority="high"
              width="1024"
              height="1024"
              decoding="sync"
            />
            <img 
              src="/hero-graphic-dark.webp" 
              alt="TakeoutFix local workspace metadata restoration tool interface screenshot" 
              class="relative rounded-lg border border-zinc-200 dark:border-zinc-800 shadow-none w-full object-cover max-h-[300px] hidden dark:block"
              fetchpriority="high"
              width="1024"
              height="1024"
              decoding="async"
            />
          </div>

          <div class="flex flex-col sm:flex-row gap-4 pt-2 items-center">
            <a href="/restore-data" class="text-zinc-500 hover:text-foreground transition-colors flex items-center justify-center h-14 font-bold px-6 w-full sm:w-auto">
              Restore Guide
            </a>
            <a href="/tool" class="w-full sm:w-auto">
              <button class="btn-monochrome-primary rounded-lg px-8 h-14 font-bold transition-all w-full sm:w-auto cursor-pointer flex items-center justify-center gap-2">
                Restore My Data
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </button>
            </a>
          </div>
        </div>
        <div class="hidden lg:block lg:col-span-5 relative animate-fade-in">
          <div class="absolute inset-0 bg-zinc-500/5 blur-[120px] rounded-full"></div>
          <img 
            src="/hero-graphic-light.webp" 
            alt="TakeoutFix local workspace metadata restoration tool interface screenshot" 
            class="relative rounded-lg border border-zinc-200 dark:border-zinc-800 shadow-none w-full object-cover max-h-[450px] block dark:hidden"
            fetchpriority="high"
            width="1024"
            height="1024"
            decoding="sync"
          />
          <img 
            src="/hero-graphic-dark.webp" 
            alt="TakeoutFix local workspace metadata restoration tool interface screenshot" 
            class="relative rounded-lg border border-zinc-200 dark:border-zinc-800 shadow-none w-full object-cover max-h-[450px] hidden dark:block"
            fetchpriority="high"
            width="1024"
            height="1024"
            decoding="async"
          />
        </div>
      </div>

      <!-- TRUST BAR / CHECKLIST (IMMEDIATELY BELOW HERO) -->
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-4 text-sm font-semibold text-zinc-700 dark:text-zinc-300 px-4 py-8 border-y border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-950/20 mt-16 rounded-lg">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-zinc-900 dark:text-zinc-100 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Free to get started</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-zinc-900 dark:text-zinc-100 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Process your photos locally</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-zinc-900 dark:text-zinc-100 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Restore original dates &amp; locations</span>
        </div>
      </div>
      <p class="mt-8 text-sm sm:text-base text-zinc-500 max-w-4xl mx-auto leading-relaxed">
        Fix wrong Google Takeout dates by restoring JSON sidecar metadata directly into your files, including EXIF timestamps and GPS coordinates, while staying fully offline. Start with the <a href="/restore-data" class="text-zinc-800 dark:text-zinc-200 underline underline-offset-4">restoration guide</a>, then use the focused help pages for <a href="/fix-google-takeout-dates" class="text-zinc-800 dark:text-zinc-200 underline underline-offset-4">date fixes</a>, <a href="/restore-gps-google-takeout" class="text-zinc-800 dark:text-zinc-200 underline underline-offset-4">GPS restoration</a>, and the <a href="/metadata-fixer" class="text-zinc-800 dark:text-zinc-200 underline underline-offset-4">metadata fixer workflow</a>.
      </p>
    </section>

    <!-- 2. RESTORATION COVERAGE SNAPSHOT -->
    <section class="w-full relative z-10">
      <div class="flex items-center justify-end max-w-7xl mx-auto px-4 pt-8 pb-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-zinc-300 dark:border-zinc-700 bg-zinc-100/60 dark:bg-zinc-900/60 text-xs font-bold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider">
          <span>What gets restored</span>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-4 pb-4 grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 text-center">
        <div class="glass-card p-5 sm:p-8 flex flex-col items-center justify-center">
          <div class="text-lg sm:text-2xl md:text-3xl font-black mb-2 sm:mb-3 text-foreground">Capture Dates</div>
          <div class="text-[10px] sm:text-xs md:text-sm font-bold text-zinc-400 uppercase tracking-widest">DateTimeOriginal &amp; related tags</div>
        </div>
        <div class="glass-card p-5 sm:p-8 flex flex-col items-center justify-center">
          <div class="text-lg sm:text-2xl md:text-3xl font-black mb-2 sm:mb-3 text-foreground">GPS Coordinates</div>
          <div class="text-[10px] sm:text-xs md:text-sm font-bold text-zinc-400 uppercase tracking-widest">Latitude / longitude from sidecars</div>
        </div>
        <div class="glass-card p-5 sm:p-8 flex flex-col items-center justify-center">
          <div class="text-lg sm:text-2xl md:text-3xl font-black mb-2 sm:mb-3 text-foreground">EXIF Metadata</div>
          <div class="text-[10px] sm:text-xs md:text-sm font-bold text-zinc-400 uppercase tracking-widest">Header metadata re-embedded</div>
        </div>
        <div class="glass-card p-5 sm:p-8 flex flex-col items-center justify-center">
          <div class="text-lg sm:text-2xl md:text-3xl font-black mb-2 sm:mb-3 text-foreground">Local Processing</div>
          <div class="text-[10px] sm:text-xs md:text-sm font-bold text-zinc-400 uppercase tracking-widest">No cloud upload required</div>
        </div>
      </div>
    </section>

    <!-- Sponsored Deals: Below Telemetry -->
    <section class="w-full max-w-7xl mx-auto px-4 py-4 relative z-10" aria-label="Sponsored recommendations">
      <!-- BEGIN AADS AD UNIT 2456560 -->
      <div id="frame" style="width: 100%; margin: auto; position: relative; z-index: 99998;">
        <iframe data-aa='2456560' loading='lazy' src='//acceptable.a-ads.com/2456560/?size=Adaptive'
          style='border:0; padding:0; width:100%; height:90px; overflow:hidden; display:block; margin:auto'></iframe>
      </div>
      <!-- END AADS AD UNIT 2456560 -->
    </section>

    <!-- 3. PROBLEM SECTION -->
    <section class="w-full max-w-7xl mx-auto px-4 py-24 sm:py-32 grid md:grid-cols-2 gap-16 items-center relative z-10">
      <div>
        <h2 class="text-4xl md:text-5xl font-bold tracking-tighter mb-6">The Google Takeout Problem.</h2>
        <div class="space-y-6 text-lg sm:text-xl text-zinc-500 leading-relaxed">
          <p>When you download your photos from Google, the dates and locations get separated from the pictures. Because of this, all your old photos show up as being taken 'Today' instead of years ago. TakeoutFix glues them back together so your memories stay in the correct order.</p>
        </div>
      </div>
      <div class="relative">
        <div class="absolute inset-0 bg-zinc-500/5 blur-[100px] rounded-full"></div>
        <div class="relative bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-lg p-6 sm:p-8 flex flex-col gap-4 shadow-none">
          <div class="flex items-center justify-between p-4 bg-zinc-100 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
            <span class="font-mono text-xs sm:text-sm truncate mr-2 text-foreground">IMG_20140812.jpg</span>
            <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="flex justify-center">
            <svg class="w-6 h-6 text-zinc-400 dark:text-zinc-600 rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
          <div class="flex items-center justify-between p-4 bg-zinc-100 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
            <span class="font-mono text-xs sm:text-sm truncate mr-2 text-foreground">IMG_20140812.jpg.json</span>
            <svg class="w-5 h-5 text-amber-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="mt-4 text-center text-sm text-red-500 font-medium bg-red-500/10 border border-red-500/20 py-2 rounded-lg">Separated Dates &amp; Locations</div>
        </div>
      </div>
    </section>

    <!-- 4. SOLUTION (BEFORE / AFTER - INTERACTIVE COMPARE SLIDER) -->
    <section class="w-full py-24 sm:py-32 relative z-10">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h2 class="text-4xl md:text-5xl font-bold tracking-tighter mb-16">The TakeoutFix Solution</h2>
        <Compare client:idle />
      </div>
    </section>

    <!-- Sponsored Deals: Below Solution -->
    <section class="w-full max-w-7xl mx-auto px-4 py-4 relative z-10" aria-label="Sponsored recommendations">
      <AdUnit client:only="react" placement="HOMEPAGE_MIDDLE" />
    </section>

    <!-- 5. PRIVACY SECTION -->
    <section class="w-full max-w-7xl mx-auto px-4 py-24 sm:py-32 text-center relative z-10">
      <svg class="w-16 h-16 sm:w-20 sm:h-20 text-zinc-900 dark:text-zinc-100 mx-auto mb-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      <h2 class="text-4xl sm:text-5xl font-bold tracking-tighter mb-6">Your Photos Never Leave Your Computer.</h2>
      <p class="text-xl sm:text-2xl text-zinc-500 max-w-3xl mx-auto leading-relaxed mb-12">
        Your photos are 100% safe. The tool works directly on your computer, meaning your photos never get uploaded to the internet or our servers. We literally cannot see your pictures.
      </p>
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto text-left">
        <div class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 p-6 rounded-xl">
          <h3 class="text-xl font-bold mb-2">1. Select your files</h3>
          <p class="text-zinc-500 text-sm leading-relaxed">Choose the Google Takeout folder you downloaded onto your computer.</p>
        </div>
        <div class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 p-6 rounded-xl">
          <h3 class="text-xl font-bold mb-2">2. Match the details</h3>
          <p class="text-zinc-500 text-sm leading-relaxed">TakeoutFix automatically finds the hidden date and location files and matches them to your photos.</p>
        </div>
        <div class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 p-6 rounded-xl">
          <h3 class="text-xl font-bold mb-2">3. Fix your photos</h3>
          <p class="text-zinc-500 text-sm leading-relaxed">Click "Restore" and your photos will instantly have their correct dates and locations back!</p>
        </div>
      </div>
    </section>

    <!-- 6. HOW IT WORKS DIAGRAM -->
    <section class="w-full py-36 text-center relative overflow-hidden z-10">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-4xl font-bold tracking-tighter mb-16">How It Works</h2>
        
        {/* Timeline Navigation Controls */}
        <div class="flex justify-center items-center gap-3 mb-6 max-w-4xl mx-auto px-6">
          <button id="timeline-arrow-left" class="w-10 h-10 rounded-full border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 bg-background flex items-center justify-center text-foreground transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer" aria-label="Previous step">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <button id="timeline-play-pause" class="w-10 h-10 rounded-full border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 bg-background flex items-center justify-center text-foreground transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer" aria-label="Pause auto-scroll">
            <svg id="play-pause-icon" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
            </svg>
          </button>

          <button id="timeline-arrow-right" class="w-10 h-10 rounded-full border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 bg-background flex items-center justify-center text-foreground transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer" aria-label="Next step">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>

        <!-- Timeline slider container -->
        <div class="relative max-w-4xl mx-auto px-6">
          <!-- Center Focus Target Frame Indicator -->
          <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[280px] h-[210px] border-2 border-zinc-400/20 dark:border-zinc-600/20 rounded-lg pointer-events-none z-20 bg-zinc-500/[0.02]"></div>

          <!-- Scrollable Track (Only 4 cards, no cycles) -->
          <div id="timeline-track" class="timeline-scroll-track flex flex-row items-center gap-6 overflow-x-auto no-scrollbar w-full py-12 select-none">
            <div class="slider-card bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 p-8 rounded-lg w-64 min-w-[256px] h-48 flex-shrink-0 transition-all duration-300 flex flex-col justify-center text-center scroll-snap-align-center" data-step="0">
              <div class="text-3xl font-black text-foreground mb-2 tracking-tight">Takeout</div>
              <div class="text-zinc-500 text-sm font-semibold">Photos + JSON</div>
            </div>
            <div class="slider-card bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 p-8 rounded-lg w-64 min-w-[256px] h-48 flex-shrink-0 transition-all duration-300 flex flex-col justify-center text-center scroll-snap-align-center" data-step="1">
              <div class="text-3xl font-black text-foreground mb-2 tracking-tight">Matching</div>
              <div class="text-zinc-500 text-sm font-semibold">Fuzzy Logic Engine</div>
            </div>
            <div class="slider-card bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 p-8 rounded-lg w-64 min-w-[256px] h-48 flex-shrink-0 transition-all duration-300 flex flex-col justify-center text-center scroll-snap-align-center" data-step="2">
              <div class="text-3xl font-black text-foreground mb-2 tracking-tight">Injection</div>
              <div class="text-zinc-500 text-sm font-semibold">EXIF Header Rebuild</div>
            </div>
            <div class="slider-card bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 p-8 rounded-lg w-64 min-w-[256px] h-48 flex-shrink-0 transition-all duration-300 flex flex-col justify-center text-center scroll-snap-align-center" data-step="3">
              <div class="text-3xl font-black text-foreground mb-2 tracking-tight">Restored</div>
              <div class="text-zinc-500 text-sm font-semibold font-sans">Perfect Timelines</div>
            </div>
          </div>
        </div>

        <div class="mt-16">
          <a href="/restore-data">
            <button class="btn-monochrome-primary px-8 py-3 rounded-lg text-sm font-semibold transition-all cursor-pointer">See here for more details</button>
          </a>
        </div>
      </div>
    </section>

    <!-- 7. COMPLETE PHOTOGRAPHY & ARCHIVAL TOOLKIT SECTION -->
    <section class="w-full max-w-7xl mx-auto px-4 py-20 relative z-10 border-t border-zinc-200 dark:border-zinc-800/80">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-purple-500/10 dark:bg-purple-950/30 rounded-full border border-purple-500/20 text-xs font-semibold text-purple-600 dark:text-purple-300 uppercase tracking-wider mb-4">
          All-in-One Archival Suite
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-foreground">
          More than Takeout: The Complete Photo Toolkit.
        </h2>
        <p class="text-base sm:text-lg text-zinc-500 dark:text-zinc-400 mt-4 leading-relaxed">
          While TakeoutFix was born to solve the Google Photos metadata crisis, we've expanded with specialized, 100% private client-side tools to organize, edit, and safeguard your entire library.
        </p>
      </div>

      <!-- Tools Grid: Focused Google Photos Restorer -->
      <div class="max-w-3xl mx-auto">
        
        <!-- Tool: TakeoutFix Core -->
        <div class="rounded-2xl border border-indigo-500/30 bg-zinc-50 dark:bg-zinc-950/80 p-8 flex flex-col justify-between shadow-xl relative overflow-hidden group">
          <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-500/5 rounded-full blur-3xl -z-10 pointer-events-none"></div>
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
              </div>
              <span class="text-xs px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold border border-emerald-500/20">
                100% Free &amp; Offline
              </span>
            </div>
            <h3 class="text-2xl font-bold text-foreground">
              Google Photos Takeout Restorer
            </h3>
            <p class="text-base text-zinc-500 dark:text-zinc-400 mt-3 leading-relaxed">
              Google Photos JSON sidecar metadata injector. Merges original capture dates, GPS coordinates, descriptions, and camera tags back into your photos and videos directly in your browser. No cloud uploads, complete privacy.
            </p>
          </div>
          <div class="pt-8">
            <a href="/tool" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm shadow-md transition-all">
              Launch Restoration Tool &rarr;
            </a>
          </div>
        </div>

      </div>

      <!-- Desktop App Spotlight Banner -->
      <div class="mt-12 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-gradient-to-r from-zinc-100 via-zinc-50 to-zinc-100 dark:from-zinc-900/90 dark:via-zinc-950 dark:to-zinc-900/90 p-8 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-left max-w-2xl">
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-md bg-zinc-200 dark:bg-zinc-800 text-xs font-mono font-semibold text-zinc-800 dark:text-zinc-300">
            Native Desktop App · Windows / macOS / Linux
          </div>
          <h3 class="text-2xl font-bold text-foreground">
            Have 100,000+ photos or a 500 GB Takeout archive?
          </h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">
            Download TakeoutFix Studio for desktop. Built in high-performance Java with native hardware acceleration, zero browser RAM limitations, and direct parallel filesystem I/O.
          </p>
        </div>
        <div class="flex-shrink-0">
          <a href="/download">
            <button class="btn-monochrome-primary px-6 py-3 rounded-lg text-sm font-bold flex items-center gap-2 cursor-pointer">
              Download Studio Desktop
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
            </button>
          </a>
        </div>
      </div>
    </section>

    <!-- Sponsored Deals & Recommendations: Above FAQ (2 Ads Grid) -->
    <section class="w-full max-w-7xl mx-auto px-4 py-4 relative z-10" aria-label="Sponsored recommendations">
      <div id="frame-bottom" style="width: 100%; margin: auto; position: relative; z-index: 99998;">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full">
          <div class="w-full bg-zinc-50/80 dark:bg-zinc-900/60 rounded-xl border border-zinc-200/80 dark:border-zinc-800 p-1.5 overflow-hidden flex items-center justify-center min-h-[96px]">
            <iframe data-aa='2456619' loading='lazy' src='//acceptable.a-ads.com/2456619/?size=Adaptive'
              style='border:0; padding:0; width:100%; height:90px; overflow:hidden; display:block; margin:auto'></iframe>
          </div>
          <div class="w-full bg-zinc-50/80 dark:bg-zinc-900/60 rounded-xl border border-zinc-200/80 dark:border-zinc-800 p-1.5 overflow-hidden flex items-center justify-center min-h-[96px]">
            <iframe data-aa='2456620' loading='lazy' src='//acceptable.a-ads.com/2456620/?size=Adaptive'
              style='border:0; padding:0; width:100%; height:90px; overflow:hidden; display:block; margin:auto'></iframe>
          </div>
        </div>
      </div>
