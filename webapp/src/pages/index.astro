---
import Layout from "../layouts/Layout.astro";
import AdUnit from "../components/AdUnit";
import { PLAN_PRICES } from "../contexts/AuthContext";

// Fallback pricing tier region default
const prices = PLAN_PRICES.us;
---

<Layout title="TakeoutFix | Google Takeout EXIF Metadata Merger & Photo Restorer">
  <div class="flex flex-col items-center bg-black text-white w-full overflow-x-hidden">
    
    <!-- 1. HERO SECTION -->
    <section class="w-full max-w-7xl mx-auto px-4 pt-48 pb-36 text-center relative z-10">
      <h1 class="text-4xl sm:text-6xl md:text-[90px] font-bold tracking-tighter mb-8 leading-[0.95] animate-fade-in">
        Restore Metadata <br class="hidden md:block"/>
        <span class="text-white/40">From Google Takeout</span>
      </h1>
      
      <p class="text-lg sm:text-xl md:text-2xl text-white/60 mb-12 max-w-3xl mx-auto font-normal tracking-tight leading-relaxed">
        Effortlessly repair missing photo details, timestamps, and locations in your exported Google Photos with intelligent metadata reconstruction.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-20 px-4 max-w-xs sm:max-w-none mx-auto w-full">
        <a href="/tool" class="w-full sm:w-auto">
          <button class="glass-capsule interactive w-full sm:w-auto px-6 sm:px-12 font-bold h-14 sm:h-16 text-base sm:text-xl text-white whitespace-nowrap">Restore My Metadata</button>
        </a>
        <a href="/how-it-works" class="w-full sm:w-auto">
          <button class="glass-capsule interactive w-full sm:w-auto px-6 sm:px-12 font-bold h-14 sm:h-16 text-base sm:text-xl text-white whitespace-nowrap">How It Works</button>
        </a>
      </div>

      <!-- TRUST BAR -->
      <div class="flex flex-wrap justify-center gap-x-4 gap-y-3 text-xs sm:text-sm md:text-base font-semibold text-white/80 px-2">
        <div class="glass-capsule px-4 py-2 sm:px-6 sm:py-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-green-400"></span> Files Never Leave Your Device
        </div>
        <div class="glass-capsule px-4 py-2 sm:px-6 sm:py-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-green-400"></span> No Cloud Processing
        </div>
        <div class="glass-capsule px-4 py-2 sm:px-6 sm:py-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-green-400"></span> Deep EXIF Injection
        </div>
        <div class="glass-capsule px-4 py-2 sm:px-6 sm:py-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-green-400"></span> Works Directly In Browser
        </div>
      </div>
    </section>

    <div class="w-full max-w-4xl mx-auto px-6 my-8">
      <AdUnit client:load type="horizontal" />
    </div>

    <!-- 2. STATS SECTION -->
    <section class="w-full relative">
      <div class="absolute top-4 right-4 flex items-center gap-2 px-3 py-1 bg-green-500/10 rounded-full border border-green-500/20 z-20">
        <div class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></div>
        <span class="text-xs font-bold text-green-400 uppercase tracking-widest">Realtime Telemetry</span>
      </div>
      <div class="max-w-7xl mx-auto px-4 py-24 sm:py-36 grid grid-cols-2 lg:grid-cols-5 gap-4 sm:gap-8 text-center">
        <div class="glass-card p-5 sm:p-10 flex flex-col items-center justify-center">
          <div id="stat-users" class="text-2xl sm:text-4xl md:text-5xl font-black mb-2 sm:mb-4 text-white">5</div>
          <div class="text-[10px] sm:text-xs md:text-sm font-bold text-white/40 uppercase tracking-widest">Registered Users</div>
        </div>
        <div class="glass-card p-5 sm:p-10 flex flex-col items-center justify-center">
          <div id="stat-restored" class="text-2xl sm:text-4xl md:text-5xl font-black mb-2 sm:mb-4 text-white">11,347</div>
          <div class="text-[10px] sm:text-xs md:text-sm font-bold text-white/40 uppercase tracking-widest">Files Restored</div>
        </div>
        <div class="glass-card p-5 sm:p-10 flex flex-col items-center justify-center">
          <div id="stat-bytes" class="text-2xl sm:text-4xl md:text-5xl font-black mb-2 sm:mb-4 text-white">13.6 GB</div>
          <div class="text-[10px] sm:text-xs md:text-sm font-bold text-white/40 uppercase tracking-widest">Data Processed</div>
        </div>
        <div class="glass-card p-5 sm:p-10 flex flex-col items-center justify-center">
          <div id="stat-success" class="text-2xl sm:text-4xl md:text-5xl font-black mb-2 sm:mb-4 text-white">100.0%</div>
          <div class="text-[10px] sm:text-xs md:text-sm font-bold text-white/40 uppercase tracking-widest">Success Rate</div>
        </div>
        <div class="glass-card p-5 sm:p-10 flex flex-col items-center justify-center col-span-2 lg:col-span-1">
          <div id="stat-resolved" class="text-2xl sm:text-4xl md:text-5xl font-black mb-2 sm:mb-4 text-white">1</div>
          <div class="text-[10px] sm:text-xs md:text-sm font-bold text-white/40 uppercase tracking-widest">Tickets Resolved</div>
        </div>
      </div>
    </section>

    <!-- 3. PROBLEM SECTION -->
    <section class="w-full max-w-7xl mx-auto px-4 py-36 grid md:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="text-4xl md:text-5xl font-bold tracking-tighter mb-6">The Google Takeout Problem.</h2>
        <div class="space-y-6 text-xl text-white/60 leading-relaxed">
          <p>When you export your data from Google Photos using Google Takeout, your files are systematically stripped of their most important context.</p>
          <p><strong class="text-white">Google Takeout separates metadata.</strong> Your original `.jpg` or `.mp4` is exported cleanly, but the timestamps and GPS coordinates are exiled to a completely separate `.json` sidecar file.</p>
          <p>Without intervention, <strong class="text-white">your photos lose dates and your gallery timelines break.</strong> Your precious memories from 2014 will show up as "Today" on your new device.</p>
        </div>
      </div>
      <div class="relative">
        <div class="absolute inset-0 bg-red-500/10 blur-[100px] rounded-full"></div>
        <div class="relative bg-black border border-white/10 rounded-2xl p-6 sm:p-8 flex flex-col gap-4 shadow-2xl">
          <div class="flex items-center justify-between p-4 bg-white/5 rounded-lg border border-white/5 overflow-hidden">
            <span class="font-mono text-xs sm:text-sm truncate mr-2">IMG_20140812.jpg</span>
            <svg class="w-5 h-5 text-red-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="flex justify-center">
            <svg class="w-6 h-6 text-white/20 rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
          <div class="flex items-center justify-between p-4 bg-white/5 rounded-lg border border-white/5 overflow-hidden">
            <span class="font-mono text-xs sm:text-sm truncate mr-2">IMG_20140812.jpg.json</span>
            <svg class="w-5 h-5 text-yellow-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="mt-4 text-center text-sm text-red-400 font-medium bg-red-400/10 py-2 rounded">Disconnected Metadata</div>
        </div>
      </div>
    </section>

    <div class="w-full max-w-4xl mx-auto px-6 my-8">
      <AdUnit client:load type="horizontal" />
    </div>

    <!-- 4. SOLUTION (BEFORE / AFTER) -->
    <section class="w-full py-36">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h2 class="text-4xl md:text-5xl font-bold tracking-tighter mb-16">The TakeoutFix Solution</h2>
        
        <div class="grid md:grid-cols-2 gap-12 max-w-4xl mx-auto">
          <!-- BEFORE -->
          <div class="bg-black/50 border border-white/10 rounded-2xl p-8 text-left shadow-xl">
            <div class="text-red-400 font-bold tracking-widest uppercase mb-6 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Before TakeoutFix
            </div>
            <div class="space-y-4">
              <div class="font-mono text-lg font-bold text-white mb-6">IMG_9942.jpg</div>
              <div class="flex justify-between border-b border-white/5 pb-2">
                <span class="text-white/40">Date Taken:</span>
                <span class="text-red-400 font-mono">Missing</span>
              </div>
              <div class="flex justify-between border-b border-white/5 pb-2">
                <span class="text-white/40">Location (GPS):</span>
                <span class="text-red-400 font-mono">Missing</span>
              </div>
              <div class="flex justify-between pb-2">
                <span class="text-white/40">Device:</span>
                <span class="text-red-400 font-mono">Missing</span>
              </div>
            </div>
          </div>

          <!-- AFTER -->
          <div class="bg-gradient-to-br from-indigo-500/10 to-purple-600/10 border border-indigo-500/30 rounded-2xl p-8 text-left shadow-[0_0_50px_rgba(99,102,241,0.1)] relative overflow-hidden">
            <div class="text-green-400 font-bold tracking-widest uppercase mb-6 flex items-center gap-2 relative z-10">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              After TakeoutFix
            </div>
            <div class="space-y-4 relative z-10">
              <div class="font-mono text-lg font-bold text-white mb-6">IMG_9942.jpg</div>
              <div class="flex justify-between border-b border-white/5 pb-2">
                <span class="text-white/40">Date Taken:</span>
                <span class="text-green-400 font-mono">Aug 12, 2014 14:30</span>
              </div>
              <div class="flex justify-between border-b border-white/5 pb-2">
                <span class="text-white/40">Location (GPS):</span>
                <span class="text-green-400 font-mono">48.8584° N, 2.2945° E</span>
              </div>
              <div class="flex justify-between pb-2">
                <span class="text-white/40">Device:</span>
                <span class="text-green-400 font-mono">iPhone 6</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="w-full max-w-4xl mx-auto px-6 my-8">
      <AdUnit client:load type="horizontal" />
    </div>

    <!-- 5. PRIVACY SECTION -->
    <section class="w-full max-w-7xl mx-auto px-4 py-36 text-center">
      <svg class="w-20 h-20 text-indigo-400 mx-auto mb-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      <h2 class="text-5xl font-bold tracking-tighter mb-6">Your Files Never Leave Your Device.</h2>
      <p class="text-2xl text-white/60 max-w-3xl mx-auto leading-relaxed mb-12">
        We built TakeoutFix to run <strong>entirely inside your web browser</strong>. When you select your Takeout folder, our engine reads the files, matches the metadata, and writes the restored files directly to your hard drive. <br/><br/>
        <strong class="text-white">Zero uploads. Zero cloud processing. Ultimate privacy.</strong>
      </p>
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto text-left">
        <div class="bg-white/5 border border-white/10 p-6 rounded-xl">
          <h3 class="text-xl font-bold mb-2">Local Computing</h3>
          <p class="text-white/50 text-sm leading-relaxed">Harnessing the power of HTML5 File System Access APIs, we process gigabytes of data locally utilizing your machine's CPU.</p>
        </div>
        <div class="bg-white/5 border border-white/10 p-6 rounded-xl">
          <h3 class="text-xl font-bold mb-2">Direct Write</h3>
          <p class="text-white/50 text-sm leading-relaxed">Restored files are injected with EXIF data and saved directly back to your local storage without ever touching an external server.</p>
        </div>
        <div class="bg-white/5 border border-white/10 p-6 rounded-xl">
          <h3 class="text-xl font-bold mb-2">Cryptographic Safety</h3>
          <p class="text-white/50 text-sm leading-relaxed">No tracking, no telemetry on your personal files. Your private memories remain strictly under your control.</p>
        </div>
      </div>
    </section>

    <div class="w-full max-w-4xl mx-auto px-6 my-8">
      <AdUnit client:load type="horizontal" />
    </div>

    <!-- 6. HOW IT WORKS DIAGRAM -->
    <section class="w-full py-36 text-center">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-4xl font-bold tracking-tighter mb-16">How It Works</h2>
        <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-8 max-w-5xl mx-auto">
          <div class="bg-black border border-white/10 p-6 rounded-2xl w-full md:w-64">
            <div class="text-2xl font-bold text-white mb-2">Takeout</div>
            <div class="text-white/50 text-sm">Photos + JSON</div>
          </div>
          <svg class="w-8 h-8 text-white/20 rotate-90 md:rotate-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
          <div class="bg-indigo-500/10 border border-indigo-500/30 p-6 rounded-2xl w-full md:w-64">
            <div class="text-2xl font-bold text-indigo-400 mb-2">Matching</div>
            <div class="text-white/50 text-sm">Fuzzy Logic Engine</div>
          </div>
          <svg class="w-8 h-8 text-white/20 rotate-90 md:rotate-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
          <div class="bg-purple-500/10 border border-purple-500/30 p-6 rounded-2xl w-full md:w-64">
            <div class="text-2xl font-bold text-purple-400 mb-2">Injection</div>
            <div class="text-white/50 text-sm">EXIF Header Rebuild</div>
          </div>
          <svg class="w-8 h-8 text-white/20 rotate-90 md:rotate-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
          <div class="bg-green-500/10 border border-green-500/30 p-6 rounded-2xl w-full md:w-64">
            <div class="text-2xl font-bold text-green-400 mb-2">Restored</div>
            <div class="text-white/50 text-sm">Perfect Timelines</div>
          </div>
        </div>
        <div class="mt-16">
          <a href="/how-it-works">
            <button class="px-8 py-3 rounded-full bg-transparent hover:bg-white/5 border border-white/20 text-white/70 hover:text-white transition-all text-sm font-semibold">Read the Technical Whitepaper</button>
          </a>
        </div>
      </div>
    </section>

    <!-- 7. REVIEWS TESTIMONIALS -->
    <section id="reviews-section" class="w-full max-w-7xl mx-auto px-4 py-36 text-center hidden">
      <h2 class="text-4xl font-bold tracking-tighter mb-16">Trusted by Thousands</h2>
      <div id="reviews-list-container" class="grid md:grid-cols-3 gap-8">
        <!-- Injected via JavaScript client-side -->
      </div>
      <div class="mt-12">
        <a href="/reviews">
          <button class="px-8 py-3 rounded-full bg-transparent hover:bg-white/5 border border-white/20 text-white/70 hover:text-white transition-all text-sm font-semibold">Read more reviews</button>
        </a>
      </div>
    </section>

    <!-- 8. PRICING PREVIEW -->
    <section class="w-full py-36">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h2 class="text-4xl font-bold tracking-tighter mb-4">Pricing That Makes Sense</h2>
        <p class="text-xl text-white/60 mb-16 max-w-2xl mx-auto">Choose a plan based on your volume. Every plan uses the exact same industry-leading recovery engine.</p>
        
        <div class="grid md:grid-cols-4 gap-6 max-w-6xl mx-auto text-left">
          <!-- Free -->
          <div class="glass-card p-8 flex flex-col justify-between">
            <div>
              <div class="text-xl font-bold mb-2 text-white">Free</div>
              <div class="text-3xl font-black mb-6 text-white">Free</div>
              <ul class="space-y-3 mb-8 text-sm text-white/60">
                <li>✓ 1GB / 1,000 files limit</li>
                <li>✓ Deep EXIF injection</li>
              </ul>
            </div>
            <a href="/tool" class="w-full">
              <button class="glass-capsule interactive w-full py-3 font-bold text-sm text-white">Start Free</button>
            </a>
          </div>

          <!-- Recovery Pass -->
          <div class="glass-card p-8 flex flex-col justify-between relative">
            <div class="absolute top-0 right-0 glass-capsule px-3 py-1 text-xs font-bold -translate-y-1/2 translate-x-2 text-white">20 GB LIMIT</div>
            <div>
              <div class="text-xl font-bold mb-2 text-white">Recovery Pass</div>
              <div class="text-3xl font-black mb-6 text-white">{prices.recovery_pass}</div>
              <ul class="space-y-3 mb-8 text-sm text-white/60">
                <li>✓ 20GB / 20k files batch</li>
                <li>✓ Folder organization</li>
                <li>✓ Standard support</li>
              </ul>
            </div>
            <a href="/checkout?plan=recovery_pass" class="w-full">
              <button class="glass-capsule interactive w-full py-3 font-bold text-sm text-white">Get Pass</button>
            </a>
          </div>

          <!-- Pro Lifetime -->
          <div class="glass-card p-8 flex flex-col justify-between relative transform md:-translate-y-4 !border-indigo-500/50 shadow-[0_0_50px_rgba(99,102,241,0.2)]">
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-indigo-500 text-white text-xs px-4 py-1 rounded-full font-bold shadow-[0_0_15px_rgba(99,102,241,0.5)]">MOST POPULAR</div>
            <div>
              <div class="text-xl font-bold mb-2 text-indigo-400">Pro Lifetime</div>
              <div class="text-3xl font-black mb-6 text-white">{prices.pro}</div>
              <ul class="space-y-3 mb-8 text-sm text-white/80">
                <li>✓ Unlimited files/GB</li>
                <li>✓ Recovery History log</li>
                <li>✓ Priority support queue</li>
              </ul>
            </div>
            <a href="/checkout?plan=pro" class="w-full">
              <button class="glass-capsule interactive w-full py-3 font-bold text-sm text-white !bg-indigo-500/20 !border-indigo-400/50 hover:!bg-indigo-500/40">Get Pro</button>
            </a>
          </div>

          <!-- Super Lifetime -->
          <div class="glass-card p-8 flex flex-col justify-between">
            <div>
              <div class="text-xl font-bold mb-2 text-amber-400">Super Lifetime</div>
              <div class="text-3xl font-black mb-6 text-white">{prices.super}</div>
              <ul class="space-y-3 mb-8 text-sm text-white/60">
                <li>✓ Ad-Free Restoration</li>
                <li>✓ Visual EXIF Viewer</li>
                <li>✓ Duplicate Detector</li>
              </ul>
            </div>
            <a href="/checkout?plan=super" class="w-full">
              <button class="glass-capsule interactive w-full py-3 font-bold text-sm text-white">Get Super</button>
            </a>
          </div>
        </div>
        
        <div class="mt-16 text-white/40 text-sm">
          Payments secured by Stripe. All transactions are local-first and encrypted.
        </div>
      </div>
    </section>

    <div class="w-full max-w-4xl mx-auto px-6 my-8">
      <AdUnit client:load type="horizontal" />
    </div>

    <!-- 9. FAQ ACCORDION -->
    <section class="w-full max-w-3xl mx-auto px-4 py-36">
      <h2 class="text-4xl font-bold tracking-tighter mb-12 text-center">Frequently Asked Questions</h2>
      <div class="space-y-2">
        <div class="faq-item border-b border-white/10 py-4">
          <button class="faq-toggle flex justify-between items-center w-full text-left font-medium text-lg focus:outline-none">
            <span>Are my photos uploaded to your servers?</span>
            <svg class="w-5 h-5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-answer hidden mt-4 text-white/60 text-base leading-relaxed">
            No. Never. The entire application runs locally inside your web browser using HTML5 File APIs. Your photos and metadata never leave your computer.
          </div>
        </div>
        <div class="faq-item border-b border-white/10 py-4">
          <button class="faq-toggle flex justify-between items-center w-full text-left font-medium text-lg focus:outline-none">
            <span>Does this work completely offline?</span>
            <svg class="w-5 h-5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-answer hidden mt-4 text-white/60 text-base leading-relaxed">
            Once the web app has loaded in your browser, you can disconnect from the internet and it will still process all your files locally.
          </div>
        </div>
        <div class="faq-item border-b border-white/10 py-4">
          <button class="faq-toggle flex justify-between items-center w-full text-left font-medium text-lg focus:outline-none">
            <span>What metadata can be recovered?</span>
            <svg class="w-5 h-5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-answer hidden mt-4 text-white/60 text-base leading-relaxed">
            We recover original creation dates (timestamps), GPS coordinates (latitude, longitude, altitude), and camera device information if it exists in the Google JSON sidecars.
          </div>
        </div>
        <div class="faq-item border-b border-white/10 py-4">
          <button class="faq-toggle flex justify-between items-center w-full text-left font-medium text-lg focus:outline-none">
            <span>Does it support videos?</span>
            <svg class="w-5 h-5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-answer hidden mt-4 text-white/60 text-base leading-relaxed">
            Yes! We support .mp4 and .mov files alongside standard image formats like .jpg, .heic, and .png.
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>

<script>
  import { db } from "../firebase";
  import { collection, query, where, getDocs } from "firebase/firestore";

  // 1. Fetch Stats from Cloudflare KV endpoint
  const loadKvStats = async () => {
    try {
      const res = await fetch("/api/stats");
      if (res.ok) {
        const stats = await res.json();
        
        const formatBytes = (bytes: number) => {
          if (bytes === 0) return '0 B';
          const k = 1024;
          const sizes = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
          const i = Math.floor(Math.log(bytes) / Math.log(k));
          return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
        };

        const usersEl = document.getElementById("stat-users");
        const restoredEl = document.getElementById("stat-restored");
        const bytesEl = document.getElementById("stat-bytes");
        const successEl = document.getElementById("stat-success");
        const resolvedEl = document.getElementById("stat-resolved");

        if (usersEl) usersEl.innerText = stats.usersCount.toLocaleString();
        if (restoredEl) restoredEl.innerText = stats.filesRestored.toLocaleString();
        if (bytesEl) bytesEl.innerText = formatBytes(stats.bytesProcessed);
        
        const successRate = stats.filesScanned > 0 
          ? (stats.filesRestored / stats.filesScanned) * 100 
          : 99.9;
        if (successEl) successEl.innerText = successRate.toFixed(1) + "%";
        
        if (resolvedEl) resolvedEl.innerText = stats.ticketsResolved.toLocaleString();
      }
    } catch (err) {
      console.warn("Failed to load global KV stats:", err);
    }
  };

  loadKvStats();

  // 2. Fetch Featured Reviews from Firestore
  const loadReviews = async () => {
    try {
      const q = query(collection(db, "reviews"), where("status", "==", "APPROVED"));
      const snap = await getDocs(q);
      const allApproved = snap.docs.map(d => ({ id: d.id, ...d.data() as any }));
      
      if (allApproved.length > 0) {
        allApproved.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
        const featured = allApproved.filter(r => r.featured);
        const displayList = featured.length > 0 ? featured.slice(0, 3) : allApproved.slice(0, 3);
        
        const reviewsSection = document.getElementById("reviews-section");
        const container = document.getElementById("reviews-list-container");
        
        if (reviewsSection && container) {
          reviewsSection.classList.remove("hidden");
          container.innerHTML = displayList.map(r => `
            <div class="bg-white/5 border border-white/10 p-8 rounded-2xl text-left relative overflow-hidden group">
              <div class="flex text-amber-400 mb-4">
                ${Array(r.rating || 5).fill('<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>').join("")}
              </div>
              <p class="text-white/70 italic mb-6 leading-relaxed">"${r.message}"</p>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-500 flex items-center justify-center font-bold text-lg">
                  ${(r.displayName || "U").charAt(0)}
                </div>
                <div>
                  <div class="font-bold text-white">${r.displayName || "Anonymous"}</div>
                  <div class="text-xs text-white/40">Verified Restoration</div>
                </div>
              </div>
            </div>
          `).join("");
        }
      }
    } catch (e) {
      console.warn("Failed to load verified reviews:", e);
    }
  };

  loadReviews();

  // 3. FAQ Accordion Click Handlers
  const setupFaqs = () => {
    const toggles = document.querySelectorAll(".faq-toggle");
    toggles.forEach(toggle => {
      toggle.addEventListener("click", () => {
        const item = toggle.closest(".faq-item");
        const answer = item?.querySelector(".faq-answer");
        const arrow = toggle.querySelector("svg");
        
        const isHidden = answer?.classList.contains("hidden");
        
        if (isHidden) {
          answer?.classList.remove("hidden");
          arrow?.classList.add("rotate-180");
        } else {
          answer?.classList.add("hidden");
          arrow?.classList.remove("rotate-180");
        }
      });
    });
  };

  setupFaqs();
</script>
