---
import Layout from "../layouts/Layout.astro";
import AdUnit from "../components/AdUnit";
import { PLAN_PRICES } from "../contexts/AuthContext";
import Compare from "../components/ui/Compare";
import ExpandableFaq from "../components/ui/ExpandableFaq";

// Fallback pricing tier region default
const region = "us";
const prices = PLAN_PRICES[region] || PLAN_PRICES.us;
---

<Layout 
  title="TakeoutFix – Take Out Fix, Takeout Fixer & Metadata Fixer for Google Photos"
  description="The #1 take out fix tool. TakeoutFixer restores photo dates, GPS, and EXIF tags stripped by Google Takeout. Works as a metadata fixer, meta data fix tool, and Google Takeout merger — entirely in your browser."
>
  <div class="flex flex-col items-center bg-background text-foreground w-full overflow-x-hidden aceternity-grid">
    
    <!-- 1. HERO SECTION -->
    <section class="w-full max-w-7xl mx-auto px-6 pt-32 pb-20 relative z-10 font-sans">
      <div class="grid lg:grid-cols-12 gap-12 items-center text-left">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-zinc-100 dark:bg-zinc-900 rounded-full border border-zinc-200 dark:border-zinc-800 text-xs font-semibold text-zinc-900 dark:text-zinc-100 uppercase tracking-wider">
            ✓ Privacy-First EXIF Repair
          </div>
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-foreground leading-tight">
            Missing Google Takeout metadata? <br/>
            <span class="text-zinc-900 dark:text-zinc-100 font-bold underline decoration-zinc-400 dark:decoration-zinc-800 decoration-2 underline-offset-4">Restore photo dates, GPS locations, timestamps, and EXIF information.</span>
          </h1>
          <p class="text-lg sm:text-xl text-zinc-500 font-normal leading-relaxed max-w-2xl">
            Restore missing EXIF dates, GPS coordinates, timestamps, and other metadata from Google Takeout archives. Everything runs locally in your browser—your files never leave your device.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 pt-2 items-center">
            <a href="/restore-data" class="text-zinc-500 hover:text-foreground transition-colors flex items-center justify-center h-14 font-bold px-6 w-full sm:w-auto">
              Restore Guide
            </a>
            <a href="/tool" class="w-full sm:w-auto">
              <button class="btn-monochrome-primary rounded-lg px-8 h-14 font-bold transition-all w-full sm:w-auto cursor-pointer flex items-center justify-center gap-2">
                Restore My Data
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </button>
            </a>
          </div>
        </div>
        <div class="lg:col-span-5 relative animate-fade-in">
          <div class="absolute inset-0 bg-zinc-500/5 blur-[120px] rounded-full"></div>
          <img 
            src="/hero-graphic-light.webp" 
            alt="TakeoutFix local workspace metadata restoration tool interface screenshot" 
            class="relative rounded-lg border border-zinc-200 dark:border-zinc-800 shadow-none w-full object-cover max-h-[450px] block dark:hidden"
            fetchpriority="high"
          />
          <img 
            src="/hero-graphic-dark.webp" 
            alt="TakeoutFix local workspace metadata restoration tool interface screenshot" 
            class="relative rounded-lg border border-zinc-200 dark:border-zinc-800 shadow-none w-full object-cover max-h-[450px] hidden dark:block"
            fetchpriority="high"
          />
        </div>
      </div>

      <!-- TRUST BAR / CHECKLIST (IMMEDIATELY BELOW HERO) -->
      <div class="flex flex-wrap justify-center gap-x-8 gap-y-4 text-sm font-semibold text-zinc-700 dark:text-zinc-350 px-4 py-8 border-y border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-950/20 mt-16 rounded-lg">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-zinc-900 dark:text-zinc-100 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Local Processing</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-zinc-900 dark:text-zinc-100 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>No Photos Uploaded</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-zinc-900 dark:text-zinc-100 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Thousands of files supported</span>
        </div>
      </div>
    </section>

    <div class="w-full max-w-4xl mx-auto px-6 my-8">
      <AdUnit client:load type="horizontal" slot="1" />
    </div>

    <!-- 2. STATS SECTION -->
    <section class="w-full relative z-10">
      <div class="absolute top-4 right-4 flex items-center gap-2 px-3 py-1 bg-zinc-100 dark:bg-zinc-900 rounded-full border border-emerald-500/20 dark:border-emerald-500/20 z-20">
        <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-widest">Realtime Telemetry</span>
      </div>
      <div class="max-w-7xl mx-auto px-4 py-24 sm:py-36 grid grid-cols-2 lg:grid-cols-5 gap-4 sm:gap-8 text-center">
        <div class="glass-card p-5 sm:p-10 flex flex-col items-center justify-center">
          <div id="stat-users" class="text-2xl sm:text-4xl md:text-5xl font-black mb-2 sm:mb-4 text-foreground">5</div>
          <div class="text-[10px] sm:text-xs md:text-sm font-bold text-zinc-400 uppercase tracking-widest">Registered Users</div>
        </div>
        <div class="glass-card p-5 sm:p-10 flex flex-col items-center justify-center">
          <div id="stat-restored" class="text-2xl sm:text-4xl md:text-5xl font-black mb-2 sm:mb-4 text-foreground">11,347</div>
          <div class="text-[10px] sm:text-xs md:text-sm font-bold text-zinc-400 uppercase tracking-widest">Files Restored</div>
        </div>
        <div class="glass-card p-5 sm:p-10 flex flex-col items-center justify-center">
          <div id="stat-bytes" class="text-2xl sm:text-4xl md:text-5xl font-black mb-2 sm:mb-4 text-foreground">13.6 GB</div>
          <div class="text-[10px] sm:text-xs md:text-sm font-bold text-zinc-400 uppercase tracking-widest">Data Processed</div>
        </div>
        <div class="glass-card p-5 sm:p-10 flex flex-col items-center justify-center">
          <div id="stat-success" class="text-2xl sm:text-4xl md:text-5xl font-black mb-2 sm:mb-4 text-foreground">100.0%</div>
          <div class="text-[10px] sm:text-xs md:text-sm font-bold text-zinc-400 uppercase tracking-widest">Success Rate</div>
        </div>
        <div class="glass-card p-5 sm:p-10 flex flex-col items-center justify-center col-span-2 lg:col-span-1">
          <div id="stat-resolved" class="text-2xl sm:text-4xl md:text-5xl font-black mb-2 sm:mb-4 text-foreground">1</div>
          <div class="text-[10px] sm:text-xs md:text-sm font-bold text-zinc-400 uppercase tracking-widest">Tickets Resolved</div>
        </div>
      </div>
    </section>

    <!-- 3. PROBLEM SECTION -->
    <section class="w-full max-w-7xl mx-auto px-4 py-36 grid md:grid-cols-2 gap-16 items-center relative z-10">
      <div>
        <h2 class="text-4xl md:text-5xl font-bold tracking-tighter mb-6">The Google Takeout Problem.</h2>
        <div class="space-y-6 text-xl text-zinc-500 leading-relaxed">
          <p>When you export your data from Google Photos using Google Takeout, your files are systematically stripped of their most important context.</p>
          <p><strong class="text-foreground">Google Takeout separates metadata.</strong> Your original `.jpg` or `.mp4` is exported cleanly, but the timestamps and GPS coordinates are exiled to a completely separate `.json` sidecar file.</p>
          <p>Without intervention, <strong class="text-foreground">your photos lose dates and your gallery timelines break.</strong> Your precious memories from 2014 will show up as "Today" on your new device.</p>
        </div>
      </div>
      <div class="relative">
        <div class="absolute inset-0 bg-zinc-550/5 blur-[100px] rounded-full"></div>
        <div class="relative bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-lg p-6 sm:p-8 flex flex-col gap-4 shadow-none">
          <div class="flex items-center justify-between p-4 bg-zinc-100 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
            <span class="font-mono text-xs sm:text-sm truncate mr-2 text-foreground">IMG_20140812.jpg</span>
            <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="flex justify-center">
            <svg class="w-6 h-6 text-zinc-400 dark:text-zinc-660 rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
          <div class="flex items-center justify-between p-4 bg-zinc-100 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
            <span class="font-mono text-xs sm:text-sm truncate mr-2 text-foreground">IMG_20140812.jpg.json</span>
            <svg class="w-5 h-5 text-amber-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="mt-4 text-center text-sm text-red-500 font-medium bg-red-500/10 border border-red-500/20 py-2 rounded-lg">Disconnected Metadata</div>
        </div>
      </div>
    </section>

    <div class="w-full max-w-4xl mx-auto px-6 my-8">
      <AdUnit client:load type="horizontal" slot="2" />
    </div>

    <!-- 4. SOLUTION (BEFORE / AFTER - INTERACTIVE COMPARE SLIDER) -->
    <section class="w-full py-36 relative z-10">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h2 class="text-4xl md:text-5xl font-bold tracking-tighter mb-16">The TakeoutFix Solution</h2>
        <Compare client:load />
      </div>
    </section>

    <div class="w-full max-w-4xl mx-auto px-6 my-8">
      <AdUnit client:load type="horizontal" slot="3" />
    </div>

    <!-- 5. PRIVACY SECTION -->
    <section class="w-full max-w-7xl mx-auto px-4 py-36 text-center relative z-10">
      <svg class="w-20 h-20 text-zinc-900 dark:text-zinc-100 mx-auto mb-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      <h2 class="text-5xl font-bold tracking-tighter mb-6">Your Files Never Leave Your Device.</h2>
      <p class="text-2xl text-zinc-500 max-w-3xl mx-auto leading-relaxed mb-12">
        We built TakeoutFix to run <strong>entirely inside your web browser</strong>. When you select your Takeout folder, our engine reads the files, matches the metadata, and writes the restored files directly to your hard drive. <br/><br/>
        <strong class="text-foreground">Zero uploads. Zero cloud processing. Privacy by Design.</strong>
      </p>
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto text-left">
        <div class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 p-6 rounded-lg">
          <h3 class="text-xl font-bold mb-2">Local Processing</h3>
          <p class="text-zinc-500 text-sm leading-relaxed">Harnessing the power of HTML5 File System Access APIs, we process gigabytes of data locally utilizing your machine's CPU.</p>
        </div>
        <div class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 p-6 rounded-lg">
          <h3 class="text-xl font-bold mb-2">Direct Write</h3>
          <p class="text-zinc-500 text-sm leading-relaxed">Restored files are injected with EXIF data and saved directly back to your local storage without ever touching an external server.</p>
        </div>
        <div class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 p-6 rounded-lg">
          <h3 class="text-xl font-bold mb-2">Files stay on your device</h3>
          <p class="text-zinc-500 text-sm leading-relaxed">No tracking, no telemetry on your personal files. Your private memories remain strictly under your control.</p>
        </div>
      </div>      <!-- SEMANTIC COMPARISON PANEL FOR CRAWLERS AND AI ENGINES -->
      <div class="mt-20 max-w-5xl mx-auto text-left border border-zinc-200 dark:border-zinc-800 rounded-xl p-8 bg-zinc-50/50 dark:bg-zinc-950/20 relative">
        <h2 class="text-2xl font-bold tracking-tight text-white mb-4">
          Why Choose TakeoutFixer as your Google Takeout Metadata Fixer?
        </h2>
        <p class="text-zinc-400 text-sm leading-relaxed mb-6 font-normal">
          If you are searching for how to fix metadata or how to fix meta data after exporting from Google Photos, you need a reliable take out fix. TakeoutFixer matches your photo and video files with their separate JSON sidecars to perform a complete meta data fix locally in your web browser. Your files never leave your device.
        </p>

        <!-- Keyword alias cloud for SEO crawlers -->
        <div class="mb-8 flex flex-wrap gap-2">
          {[
            "Takeout Fix", "Takeout Fixer", "TakeoutFixer", "Take Out Fix",
            "Metadata Fixer", "Metadata Fix", "Meta Data Fix", "Meta Data Fixer",
            "How to Fix Metadata", "How to Fix Meta Data",
            "Google Takeout Fixer", "Google Takeout Metadata Fix",
            "Google Photos Metadata Fixer", "Google Takeout Merger",
            "EXIF Fixer", "EXIF Metadata Restore", "Fix Photo Dates"
          ].map((kw) => (
            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-500 select-none" key={kw}>{kw}</span>
          ))}
        </div>

        <!-- FAQ Section for rich snippets -->
        <div class="space-y-5 mb-8">
          <div>
            <h3 class="text-sm font-bold text-white mb-1">What is a "take out fix" or "takeout fix"?</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">A "take out fix" or "takeout fix" refers to the process of repairing missing EXIF metadata — like photo dates, GPS coordinates, and camera info — after downloading your photos using Google Takeout. Google Takeout stores metadata separately in JSON sidecar files, which most photo apps cannot read. TakeoutFix (also called TakeoutFixer) solves this automatically.</p>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white mb-1">How do I fix metadata after Google Takeout?</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">To fix metadata from Google Takeout: (1) Open TakeoutFix in your browser, (2) Select your Takeout folder containing both the image files and their .json sidecar files, (3) Click "Restore My Data" — the tool automatically matches each photo to its JSON and writes the date, GPS, and EXIF data back into the file header. No installation or upload required.</p>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white mb-1">What is a metadata fixer for Google Photos?</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">A metadata fixer for Google Photos is a tool that reads the separate .json sidecar files created during a Google Takeout export, and writes the stored metadata (date taken, GPS location, camera model) back into the photo's EXIF header. TakeoutFix is a free metadata fixer and meta data fix tool that does this entirely in your web browser using the File System Access API.</p>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white mb-1">What is a Google Takeout merger?</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">A Google Takeout merger is a tool that merges (reunites) the photo/video binary files with their detached JSON metadata sidecar files produced by a Google Takeout export. TakeoutFix performs this merge locally on your device — no server, no upload, no privacy risk.</p>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-8 text-xs font-normal">
          <div class="space-y-4">
            <h3 class="font-bold text-white text-sm">TakeoutFixer (Local Web App)</h3>
            <ul class="space-y-4 text-zinc-400 leading-relaxed">
              <li class="flex flex-col gap-1">
                <span class="flex items-center gap-2 font-bold text-zinc-200">
                  <span class="text-green-500">✅</span> No Installation Required
                </span>
                <span class="pl-6">Open the app and run the metadata fixer immediately in any web browser.</span>
              </li>
              <li class="flex flex-col gap-1">
                <span class="flex items-center gap-2 font-bold text-zinc-200">
                  <span class="text-green-500">✅</span> Secure Sandbox Environment
                </span>
                <span class="pl-6">Our meta data fix runs inside a secure sandbox—no system access is requested or needed.</span>
              </li>
              <li class="flex flex-col gap-1">
                <span class="flex items-center gap-2 font-bold text-zinc-200">
                  <span class="text-green-500">✅</span> 100% Client-Side Processing
                </span>
                <span class="pl-6">Your photos stay on your hard drive. Once loaded, the take out fix runs completely offline.</span>
              </li>
              <li class="flex flex-col gap-1">
                <span class="flex items-center gap-2 font-bold text-zinc-200">
                  <span class="text-green-500">✅</span> Multi-Core Parallel Execution
                </span>
                <span class="pl-6">Leverages background workers to execute the metadata fixer across thousands of files simultaneously.</span>
              </li>
            </ul>
          </div>
          <div class="space-y-4">
            <h3 class="font-bold text-zinc-300 text-sm">Traditional Command Line & Desktop Tools</h3>
            <ul class="space-y-4 text-zinc-400 leading-relaxed">
              <li class="flex items-start gap-2">
                <span class="text-red-500 font-bold">❌</span>
                <span>Require downloading, installing, and configuring complex system applications.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-red-500 font-bold">❌</span>
                <span>Require terminal commands, making them difficult for non-technical users to run.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-red-500 font-bold">❌</span>
                <span>Risk exposes your computer to security flaws if third-party executables are downloaded.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-red-500 font-bold">❌</span>
                <span>Installing tools is often restricted on corporate or school laptops.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <div class="w-full max-w-4xl mx-auto px-6 my-8">
      <AdUnit client:load type="horizontal" slot="4" />
    </div>

    <!-- 6. HOW IT WORKS DIAGRAM -->
    <section class="w-full py-36 text-center relative overflow-hidden z-10">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-4xl font-bold tracking-tighter mb-16">How It Works</h2>
        
        {/* Timeline Navigation Controls */}
        <div class="flex justify-center items-center gap-3 mb-6 max-w-4xl mx-auto px-6">
          <button id="timeline-arrow-left" class="w-10 h-10 rounded-full border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 bg-background flex items-center justify-center text-foreground transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer" aria-label="Previous step">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <button id="timeline-play-pause" class="w-10 h-10 rounded-full border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 bg-background flex items-center justify-center text-foreground transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer" aria-label="Pause auto-scroll">
            <svg id="play-pause-icon" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
            </svg>
          </button>

          <button id="timeline-arrow-right" class="w-10 h-10 rounded-full border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 bg-background flex items-center justify-center text-foreground transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer" aria-label="Next step">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>

        <!-- Timeline slider container -->
        <div class="relative max-w-4xl mx-auto px-6">
          <!-- Center Focus Target Frame Indicator -->
          <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[280px] h-[210px] border-2 border-zinc-400/20 dark:border-zinc-600/20 rounded-lg pointer-events-none z-20 bg-zinc-500/[0.02]"></div>

          <!-- Scrollable Track (Only 4 cards, no cycles) -->
          <div id="timeline-track" class="flex flex-row items-center gap-6 overflow-x-auto no-scrollbar w-full py-12 select-none" style="padding-left: calc(50% - 128px); padding-right: calc(50% - 128px); scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none;">
            <div class="slider-card bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 p-8 rounded-lg w-64 min-w-[256px] h-48 flex-shrink-0 transition-all duration-300 flex flex-col justify-center text-center scroll-snap-align-center" data-step="0">
              <div class="text-3xl font-black text-foreground mb-2 tracking-tight">Takeout</div>
              <div class="text-zinc-500 text-sm font-semibold">Photos + JSON</div>
            </div>
            <div class="slider-card bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 p-8 rounded-lg w-64 min-w-[256px] h-48 flex-shrink-0 transition-all duration-300 flex flex-col justify-center text-center scroll-snap-align-center" data-step="1">
              <div class="text-3xl font-black text-foreground mb-2 tracking-tight">Matching</div>
              <div class="text-zinc-500 text-sm font-semibold">Fuzzy Logic Engine</div>
            </div>
            <div class="slider-card bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 p-8 rounded-lg w-64 min-w-[256px] h-48 flex-shrink-0 transition-all duration-300 flex flex-col justify-center text-center scroll-snap-align-center" data-step="2">
              <div class="text-3xl font-black text-foreground mb-2 tracking-tight">Injection</div>
              <div class="text-zinc-500 text-sm font-semibold">EXIF Header Rebuild</div>
            </div>
            <div class="slider-card bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 p-8 rounded-lg w-64 min-w-[256px] h-48 flex-shrink-0 transition-all duration-300 flex flex-col justify-center text-center scroll-snap-align-center" data-step="3">
              <div class="text-3xl font-black text-foreground mb-2 tracking-tight">Restored</div>
              <div class="text-zinc-500 text-sm font-semibold font-sans">Perfect Timelines</div>
            </div>
          </div>
        </div>

        <div class="mt-16">
          <a href="/restore-data">
            <button class="btn-monochrome-primary px-8 py-3 rounded-lg text-sm font-semibold transition-all cursor-pointer">See here for more details</button>
          </a>
        </div>
      </div>
    </section>

    <!-- 9. FAQ SECTION (INTERACTIVE EXPANDABLE FAQ DECK) -->
    <section class="w-full max-w-5xl mx-auto px-4 py-36 relative z-10">
      <h2 class="text-4xl font-bold tracking-tighter mb-12 text-center">Frequently Asked Questions</h2>
      <ExpandableFaq client:load />
      <div class="mt-12 text-center">
        <a href="/support">
          <button class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 font-semibold text-sm transition-colors cursor-pointer">View all frequently asked questions &rarr;</button>
        </a>
      </div>
    </section>

  </div>
</Layout>

<script>
  import { db } from "../firebase";
  import { collection, query, where, getDocs } from "firebase/firestore";

  let autoPlayInterval: number | undefined;
  let userInteractionTimeout: number | undefined;

  // Clean up animation timers globally when page shifts (Astro lifecycle)
  document.addEventListener("astro:before-preparation", () => {
    window.clearInterval(autoPlayInterval);
    window.clearTimeout(userInteractionTimeout);
  });

  // 1. Fetch Stats directly from Firestore REST API on the client side
  const loadKvStats = async () => {
    try {
      const res = await fetch("https://firestore.googleapis.com/v1/projects/gt-metadata-merger/databases/(default)/documents/platform_stats/global");
      if (res.ok) {
        const data = await res.ok ? await res.json() : null;
        if (!data) return;
        const fields = data.fields || {};
        
        const stats = {
          filesRestored: parseInt(fields.filesRestored?.integerValue || "11347"),
          bytesProcessed: parseInt(fields.bytesProcessed?.integerValue || "14577672926"),
          ticketsResolved: parseInt(fields.ticketsResolved?.integerValue || "1"),
          usersCount: parseInt(fields.usersCount?.integerValue || "5"),
          filesScanned: parseInt(fields.filesScanned?.integerValue || "11347")
        };
        
        const formatBytes = (bytes: number) => {
          if (bytes === 0) return '0 B';
          const k = 1024;
          const sizes = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
          const i = Math.floor(Math.log(bytes) / Math.log(k));
          return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
        };

        const usersEl = document.getElementById("stat-users");
        const restoredEl = document.getElementById("stat-restored");
        const bytesEl = document.getElementById("stat-bytes");
        const successEl = document.getElementById("stat-success");
        const resolvedEl = document.getElementById("stat-resolved");

        if (usersEl) usersEl.innerText = stats.usersCount.toLocaleString();
        if (restoredEl) restoredEl.innerText = stats.filesRestored.toLocaleString();
        if (bytesEl) bytesEl.innerText = formatBytes(stats.bytesProcessed);
        
        const successRate = stats.filesScanned > 0 
          ? (stats.filesRestored / stats.filesScanned) * 100 
          : 99.9;
        if (successEl) successEl.innerText = successRate.toFixed(1) + "%";
        
        if (resolvedEl) resolvedEl.innerText = stats.ticketsResolved.toLocaleString();
      }
    } catch (err) {
      console.warn("Failed to load global KV stats:", err);
    }
  };

  // 2. Fetch Featured Reviews from Firestore
  const loadReviews = async () => {
    try {
      const q = query(collection(db, "reviews"), where("status", "==", "APPROVED"));
      const snap = await getDocs(q);
      const allApproved = snap.docs.map(d => ({ id: d.id, ...d.data() as any }));
      
      if (allApproved.length > 0) {
        allApproved.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
        const featured = allApproved.filter(r => r.featured);
        const displayList = featured.length > 0 ? featured.slice(0, 3) : allApproved.slice(0, 3);
        
        const reviewsSection = document.getElementById("reviews-section");
        const container = document.getElementById("reviews-list-container");
        
        if (reviewsSection && container) {
          reviewsSection.classList.remove("hidden");
          container.innerHTML = displayList.map(r => `
            <div class="bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 p-8 rounded-lg text-left relative overflow-hidden group shadow-none">
              <div class="flex text-zinc-900 dark:text-zinc-100 mb-4">
                ${Array(r.rating || 5).fill('<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>').join("")}
              </div>
              <p class="text-zinc-500 italic mb-6 leading-relaxed">"${r.message}"</p>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center font-bold text-lg text-foreground">
                  ${(r.displayName || "U").charAt(0)}
                </div>
                <div>
                  <div class="font-bold text-foreground">${r.displayName || "Anonymous"}</div>
                  <div class="text-xs text-zinc-400">Verified Restoration</div>
                </div>
              </div>
            </div>
          `).join("");
        }
      }
    } catch (e) {
      console.warn("Failed to load verified reviews:", e);
    }
  };

  // 4. Discrete Auto-scrolling Timeline Slider with Play/Pause and Center Magnify
  const setupTimelineSlider = () => {
    const track = document.getElementById("timeline-track") as HTMLDivElement | null;
    const arrowLeft = document.getElementById("timeline-arrow-left") as HTMLButtonElement | null;
    const arrowRight = document.getElementById("timeline-arrow-right") as HTMLButtonElement | null;
    const playPauseBtn = document.getElementById("timeline-play-pause") as HTMLButtonElement | null;
    const playPauseIcon = document.getElementById("play-pause-icon") as SVGElement | null;

    if (!track || !arrowLeft || !arrowRight || !playPauseBtn || !playPauseIcon) return;

    const cardWidth = 256;
    const gap = 24;
    const itemWidth = cardWidth + gap; // 280px

    let activeStep = 0;
    let isPlaying = true;
    let isExplicitlyPaused = false;
    let isAutoScrollingToStep = false;

    const updateCenterMagnification = () => {
      const rect = track.getBoundingClientRect();
      const center = rect.left + rect.width / 2;
      const cards = track.querySelectorAll(".slider-card");

      cards.forEach(card => {
        const cardRect = card.getBoundingClientRect();
        const cardCenter = cardRect.left + cardRect.width / 2;
        const distance = Math.abs(center - cardCenter);

        // Magnify center card: 1.12x scale, opacity 1. Others scale down to 0.88x and 0.4 opacity
        const maxDistance = 300;
        const factor = Math.max(0, 1 - distance / maxDistance);
        const scale = 0.88 + factor * 0.24; // 0.88 to 1.12
        const opacity = 0.4 + factor * 0.6; // 0.4 to 1.0

        const htmlCard = card as HTMLDivElement;
        htmlCard.style.transform = `scale(${scale})`;
        htmlCard.style.opacity = `${opacity}`;

        if (distance < 140) {
          htmlCard.style.borderColor = "var(--border)";
          htmlCard.style.boxShadow = "none";
        } else {
          htmlCard.style.borderColor = "var(--border)";
          htmlCard.style.boxShadow = "none";
        }
      });
    };

    const scrollToStep = (step: number, smooth = true) => {
      activeStep = step;
      isAutoScrollingToStep = true;
      track.scrollTo({
        left: step * itemWidth,
        behavior: smooth ? "smooth" : "auto"
      });
      // Allow scroll listener to settle before resetting flag
      setTimeout(() => {
        isAutoScrollingToStep = false;
        updateCenterMagnification();
      }, 500);
    };

    const startAutoPlay = () => {
      isPlaying = true;
      updatePlayIconState();
      window.clearInterval(autoPlayInterval);
      autoPlayInterval = window.setInterval(() => {
        const nextStep = (activeStep + 1) % 4;
        scrollToStep(nextStep);
      }, 3000); // Step every 3 seconds
    };

    const stopAutoPlay = () => {
      isPlaying = false;
      updatePlayIconState();
      window.clearInterval(autoPlayInterval);
    };

    const updatePlayIconState = () => {
      if (isPlaying) {
        // Render Pause icon
        playPauseIcon.innerHTML = `<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>`;
        playPauseBtn.setAttribute("aria-label", "Pause auto-scroll");
      } else {
        // Render Play icon
        playPauseIcon.innerHTML = `<path d="M8 5v14l11-7z"/>`;
        playPauseBtn.setAttribute("aria-label", "Play auto-scroll");
      }
    };

    const handleUserInteraction = () => {
      stopAutoPlay();
      window.clearTimeout(userInteractionTimeout);
      
      // Only set auto-resume timeout if NOT explicitly paused by clicking Pause
      if (!isExplicitlyPaused) {
        userInteractionTimeout = window.setTimeout(() => {
          startAutoPlay();
        }, 8000); // Resume auto-scroll after 8s of inactivity
      }
    };

    // Listeners
    track.addEventListener("scroll", () => {
      updateCenterMagnification();

      // Find closest step when user is manually scrolling/swiping
      if (!isAutoScrollingToStep) {
        const scrollPos = track.scrollLeft;
        const currentStep = Math.round(scrollPos / itemWidth);
        activeStep = Math.max(0, Math.min(3, currentStep));
      }
    });

    // Pause autoplay on direct click/drag/touch interactions with track
    track.addEventListener("mousedown", handleUserInteraction);
    track.addEventListener("touchstart", handleUserInteraction, { passive: true });
    track.addEventListener("wheel", handleUserInteraction, { passive: true });

    // Arrow controls
    arrowLeft.addEventListener("click", () => {
      handleUserInteraction();
      const prevStep = (activeStep - 1 + 4) % 4;
      scrollToStep(prevStep);
    });

    arrowRight.addEventListener("click", () => {
      handleUserInteraction();
      const nextStep = (activeStep + 1) % 4;
      scrollToStep(nextStep);
    });

    // Play/Pause toggle button
    playPauseBtn.addEventListener("click", () => {
      window.clearTimeout(userInteractionTimeout);
      if (isPlaying) {
        isExplicitlyPaused = true;
        stopAutoPlay();
      } else {
        isExplicitlyPaused = false;
        startAutoPlay();
      }
    });

    // Run animation and initial styling
    scrollToStep(0, false);
    setTimeout(updateCenterMagnification, 100);
    startAutoPlay();
  };

  // Run all setups on page load
  document.addEventListener("astro:page-load", () => {
    loadKvStats();
    loadReviews();
    setupTimelineSlider();
  });
</script>
