---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import DashboardPage from "../react-pages/DashboardPage";
---

<Layout title="TakeoutFix | User Dashboard" description="Access your TakeoutFix restoration history, manage account credentials, check volume metrics, and active session slots.">
  <DashboardPage client:only="react">
    <div slot="fallback" class="min-h-[70vh] max-w-5xl mx-auto px-6 py-16 animate-pulse space-y-8">
      <div class="space-y-3">
        <div class="h-4 w-32 rounded-full bg-zinc-200 dark:bg-zinc-800"></div>
        <div class="h-10 w-64 rounded-xl bg-zinc-200 dark:bg-zinc-800"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
        <div class="h-32 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800"></div>
        <div class="h-32 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800"></div>
        <div class="h-32 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800"></div>
      </div>
      <div class="h-64 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800"></div>
    </div>
  </DashboardPage>
</Layout>
