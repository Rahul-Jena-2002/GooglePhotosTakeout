import { AuthProvider } from "../contexts/AuthContext";
import DashboardPage from "../react-pages/DashboardPage";
import { ToastContainer } from "../components/ui/toast";
---

<Layout title="TakeoutFix | User Dashboard" description="Access your TakeoutFix restoration history, manage account credentials, check volume metrics, and active session slots.">
