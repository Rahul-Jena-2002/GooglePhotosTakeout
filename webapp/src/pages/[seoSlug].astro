---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import AdUnit from "../components/monetization/AdUnit";
import Icon from "../components/ui/Icon.astro";
import { CURATED_SEO_PAGES } from "../config/seoPages";

export function getStaticPaths() {
  const paths = [];

  // Register exclusively curated, high-intent SEO pages with substantial unique value
  for (const slug of Object.keys(CURATED_SEO_PAGES)) {
    paths.push({ params: { seoSlug: slug } });
  }

  return paths;
}

const { seoSlug } = Astro.params;
const slug = (seoSlug || "").toLowerCase();

const curated = CURATED_SEO_PAGES[slug];

if (!curated) {
  return Astro.redirect("/restore-data", 301);
}

const pageTitle = curated.title;
const pageDescription = curated.description;
const badgeText = curated.badge;
const badgeColor = curated.badgeColor;
const headlineGrad = curated.headlineGradient;
const headlineRest = curated.headlineText;
const introText = curated.intro;
const ctaButtonText = curated.ctaText;
const ctaButtonLink = curated.ctaLink;
const robotsDirective = "index, follow"; // Curated pages are indexed for SEO

const matchedAction = "Restore";
const matchedTarget = "EXIF Metadata";
const matchedSource = "Google Takeout";
---

<Layout title={pageTitle} description={pageDescription} robots={robotsDirective}>
  <div class="bg-black text-zinc-100 min-h-screen py-24 px-4 sm:px-6 lg:px-8 relative overflow-hidden font-sans">

    <!-- BreadcrumbList Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://takeoutfix.pages.dev/" },
        { "@type": "ListItem", "position": 2, "name": "Restore Data", "item": "https://takeoutfix.pages.dev/restore-data" },
        { "@type": "ListItem", "position": 3, "name": pageTitle.replace(' | TakeoutFix', '') }
      ]
    })} />
    
    <!-- Background neon glows -->
    <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-indigo-900/10 blur-[150px] rounded-full pointer-events-none"></div>
    <div class="absolute bottom-20 right-1/4 w-[600px] h-[600px] bg-purple-900/10 blur-[150px] rounded-full pointer-events-none"></div>

    <!-- Hero Section -->
    <div class="max-w-4xl mx-auto text-center mb-20 relative z-10">
      <div class={`inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-semibold ${badgeColor} mb-6 font-mono`}>
        <Icon name="shield-check" class="w-4 h-4" />
        {badgeText}
      </div>
      
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight animate-fade-in">
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-500">{headlineGrad}</span>{headlineRest}
      </h1>
      
      <p class="text-lg md:text-xl text-zinc-400 max-w-3xl mx-auto font-normal leading-relaxed mb-8">
        {introText}
      </p>

      <div class="flex justify-center">
        <a href={ctaButtonLink}>
          <button class="glass-capsule interactive px-10 h-14 font-semibold text-white flex items-center gap-2">
            {ctaButtonText} <Icon name="arrow-right" class="w-5 h-5" />
          </button>
        </a>
      </div>
    </div>

    <!-- Grid Content Sections -->
    <div class="max-w-6xl mx-auto relative z-10 space-y-16">
      
      <!-- Comparison Showcase (Before / After) -->
      <div class="bg-zinc-950/40 border border-white/5 backdrop-blur-md rounded-2xl overflow-hidden shadow-2xl">
        <div class="border-b border-white/5 py-4 px-6">
          <h2 class="text-sm font-sans font-bold tracking-tight text-zinc-300 flex items-center gap-2">
            <Icon name="eye" class="w-4 h-4 text-indigo-400" />
            Dynamic EXIF Header Verification Matrix
          </h2>
        </div>
        <div class="p-8">
          <div class="compare-container">
            <!-- BEFORE -->
            <div class="compare-card compare-card-before">
              <div class="compare-header compare-header-before">
                <Icon name="alert-triangle" class="w-4 h-4" /> Before TakeoutFix
              </div>
              
              <div class="compare-file-badge compare-file-badge-before">
                <div class="compare-file-icon-before">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <span class="compare-file-name">IMG_3012.JPG</span>
                  <span class="compare-file-desc">3.1 MB · Camera Original</span>
                </div>
              </div>

              <div class="compare-list">
                <div class="compare-item">
                  <span class="compare-item-label">Date Taken</span>
                  <span class="compare-item-value-missing">Missing (Today's Date)</span>
                </div>
                <div class="compare-item">
                  <span class="compare-item-label">GPS Coordinates</span>
                  <span class="compare-item-value-missing">None (0.0, 0.0)</span>
                </div>
                <div class="compare-item">
                  <span class="compare-item-label">Camera Model</span>
                  <span class="compare-item-value-missing">Stripped</span>
                </div>
              </div>
            </div>

            <!-- AFTER -->
            <div class="compare-card compare-card-after">
              <div class="compare-header compare-header-after">
                <Icon name="check-circle-2" class="w-4 h-4" /> After TakeoutFix
              </div>

              <div class="compare-file-badge compare-file-badge-after">
                <div class="compare-file-icon-after">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <span class="compare-file-name">IMG_3012.JPG</span>
                  <span class="compare-file-desc">3.1 MB · EXIF Restored</span>
                </div>
              </div>

              <div class="compare-list">
                <div class="compare-item">
                  <span class="compare-item-label">Date Taken</span>
                  <span class="compare-item-value-fixed">2018:04:12 18:32:04</span>
                </div>
                <div class="compare-item">
                  <span class="compare-item-label">GPS Coordinates</span>
                  <span class="compare-item-value-fixed">40.7128° N, 74.0060° W</span>
                </div>
                <div class="compare-item">
                  <span class="compare-item-label">Camera Model</span>
                  <span class="compare-item-value-fixed">Apple iPhone X</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Detailed Explanation Grid -->
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-zinc-950/40 border border-white/5 backdrop-blur-md p-6 rounded-2xl flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center mb-3">
              <Icon name="cpu" class="w-5 h-5 text-indigo-400" />
            </div>
            <h3 class="text-lg text-white font-bold mb-4">Why {matchedSource} Stripped Your {matchedTarget}</h3>
            <p class="text-sm text-zinc-450 leading-relaxed space-y-4 font-normal">
              When exporting your photo library via {matchedSource}, the platform separates your media binary files from their descriptive headers. Instead of writing metadata directly inside the photo headers, it creates individual sidecar files ending in <code>.json</code>.
            </p>
            <p class="text-sm text-zinc-450 leading-relaxed mt-4 font-normal">
              As a result, importing these files into new systems (like Apple Photos, Windows Gallery, or Synology) displays them with wrong dates (often showing the date of your takeout export itself) and strips out GPS location tracking maps.
            </p>
          </div>
        </div>

        <div class="bg-zinc-950/40 border border-white/5 backdrop-blur-md p-6 rounded-2xl flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-lg bg-purple-500/10 border border-purple-500/20 flex items-center justify-center mb-3">
              <Icon name="hard-drive" class="w-5 h-5 text-purple-400" />
            </div>
            <h3 class="text-lg text-white font-bold mb-4">How TakeoutFix Resolves the Bug Locally</h3>
            <p class="text-sm text-zinc-450 leading-relaxed mb-4 font-normal">
              TakeoutFix's client-side compilation engine bypasses network servers. By keeping file matching 100% on your device:
            </p>
            <ul class="space-y-2.5">
              <li class="flex items-center gap-2 text-zinc-300 text-sm font-normal">
                <Icon name="check-circle-2" class="w-4 h-4 text-purple-400 flex-shrink-0" />
                <span>Recursively traverses directories to locate sidecar JSONs.</span>
              </li>
              <li class="flex items-center gap-2 text-zinc-300 text-sm font-normal">
                <Icon name="check-circle-2" class="w-4 h-4 text-purple-400 flex-shrink-0" />
                <span>Executes name-hash matching to link edited and copy versions.</span>
              </li>
              <li class="flex items-center gap-2 text-zinc-300 text-sm font-normal">
                <Icon name="check-circle-2" class="w-4 h-4 text-purple-400 flex-shrink-0" />
                <span>Writes binary headers directly without quality loss or recompression.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Step-by-Step Recovery Guide -->
      <div class="text-center py-10">
        <h2 class="text-2xl font-bold mb-10 text-white">3 Steps to {matchedAction} {matchedTarget}</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-zinc-950/20 border border-zinc-900 rounded-xl p-5 text-left relative overflow-hidden">
            <span class="absolute right-4 top-2 text-5xl font-extrabold text-white/5 font-mono select-none">1</span>
            <h4 class="font-bold text-white mb-2">Select Folders</h4>
            <p class="text-xs text-zinc-450 leading-relaxed font-normal">
              Provide your {matchedSource} directory. TakeoutFix scans files recursively entirely within your local browser sandbox.
            </p>
          </div>
          
          <div class="bg-zinc-950/20 border border-zinc-900 rounded-xl p-5 text-left relative overflow-hidden">
            <span class="absolute right-4 top-2 text-5xl font-extrabold text-white/5 font-mono select-none">2</span>
            <h4 class="font-bold text-white mb-2">Run Matcher</h4>
            <p class="text-xs text-zinc-450 leading-relaxed font-normal">
              Our dynamic heuristic resolver maps modified, truncated, and multi-copy suffix filenames back to their parent JSON descriptors.
            </p>
          </div>
          
          <div class="bg-zinc-950/20 border border-zinc-900 rounded-xl p-5 text-left relative overflow-hidden">
            <span class="absolute right-4 top-2 text-5xl font-extrabold text-white/5 font-mono select-none">3</span>
            <h4 class="font-bold text-white mb-2">Inject Headers</h4>
            <p class="text-xs text-zinc-450 leading-relaxed font-normal">
              Timestamps, GPS coordinates, and camera info are written directly into binary headers, exporting clean folders for immediate import.
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- Related Guides & Knowledge Base -->
    <div class="max-w-4xl mx-auto mb-20 relative z-10">
      <div class="bg-zinc-950/40 border border-white/5 backdrop-blur-md rounded-2xl p-8">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-white">Authoritative Guides & Deep Dives</h2>
          <a href="/guides" class="text-xs font-semibold text-indigo-400 hover:text-indigo-300">View All Guides &rarr;</a>
        </div>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
          <a href="/guides/google-takeout-json-metadata-explained" class="block p-4 bg-zinc-900/50 rounded-lg border border-zinc-800 hover:border-indigo-500/40 transition-colors">
            <div class="text-sm font-semibold text-zinc-200 mb-1">JSON Sidecars Explained</div>
            <div class="text-xs text-zinc-400">Deep technical breakdown of Google Takeout JSON files</div>
          </a>
          <a href="/guides/how-to-save-takeout-photos-to-hard-drive-nas-cloud" class="block p-4 bg-zinc-900/50 rounded-lg border border-zinc-800 hover:border-emerald-500/40 transition-colors">
            <div class="text-sm font-semibold text-zinc-200 mb-1">Save to USB, NAS & Cloud</div>
            <div class="text-xs text-zinc-400">Store on USB drives, home NAS, or any cloud provider</div>
          </a>
          <a href="/guides/google-takeout-common-errors-fix" class="block p-4 bg-zinc-900/50 rounded-lg border border-zinc-800 hover:border-amber-500/40 transition-colors">
            <div class="text-sm font-semibold text-zinc-200 mb-1">Troubleshooting Errors</div>
            <div class="text-xs text-zinc-400">Fix truncated names, missing GPS, and timezone shifts</div>
          </a>
          <a href="/restore-data" class="block p-4 bg-zinc-900/50 rounded-lg border border-zinc-800 hover:border-purple-500/40 transition-colors">
            <div class="text-sm font-semibold text-zinc-200 mb-1">Full Technical Specs</div>
            <div class="text-xs text-zinc-400">EXIF 2.32, TIFF, and WebAssembly architecture</div>
          </a>
          <a href="/about" class="block p-4 bg-zinc-900/50 rounded-lg border border-zinc-800 hover:border-pink-500/40 transition-colors">
            <div class="text-sm font-semibold text-zinc-200 mb-1">About TakeoutFix</div>
            <div class="text-xs text-zinc-400">Our team, mission, and local-first principles</div>
          </a>
          <a href="/contact" class="block p-4 bg-zinc-900/50 rounded-lg border border-zinc-800 hover:border-emerald-500/40 transition-colors">
            <div class="text-sm font-semibold text-zinc-200 mb-1">Support & Help Desk</div>
            <div class="text-xs text-zinc-400">Contact the developer & engineering team directly</div>
          </a>
        </div>
      </div>
    </div>

    <!-- Call to Action Footer -->
    <div class="max-w-4xl mx-auto text-center mt-32 py-16 border-t border-zinc-900 relative z-10">
      <h2 class="text-3xl font-bold tracking-tight mb-4 text-white">Rebuild Your {matchedSource} Photos Today</h2>
      <p class="text-zinc-500 mb-8 max-w-md mx-auto">
        Start recovering your {matchedTarget.toLowerCase()} in seconds. Absolutely no sign-ups or software installation required.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/tool">
          <button class="glass-capsule interactive px-10 h-14 font-semibold text-white flex items-center gap-2">
            Restore My Data <Icon name="arrow-right" class="w-5 h-5" />
          </button>
        </a>
        <a href="/download">
          <button class="glass-capsule interactive px-8 h-14 font-semibold text-zinc-300 hover:text-white">
            Download Desktop App
          </button>
        </a>
      </div>
    </div>
  </div>
</Layout>
