---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import AuthPage from "../react-pages/auth/AuthPage";
---

<Layout 
  title="Create Account | TakeoutFix" 
  description="Create your free TakeoutFix account and start restoring Google Takeout EXIF metadata, timestamps, and GPS coordinates."
  isAuthPage={true}
>
  <AuthPage client:only="react">
    <div slot="fallback" class="min-h-[85vh] flex items-center justify-center px-4 py-12">
      <div class="w-full max-w-md bg-white dark:bg-zinc-900/95 border border-zinc-200/80 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-2xl backdrop-blur-xl animate-pulse space-y-6">
        <div class="text-center space-y-2">
          <div class="h-7 w-44 mx-auto rounded-xl bg-zinc-200 dark:bg-zinc-800"></div>
          <div class="h-4 w-64 mx-auto rounded-lg bg-zinc-200 dark:bg-zinc-800"></div>
        </div>
        <div class="h-10 rounded-2xl bg-zinc-100 dark:bg-zinc-800/80"></div>
        <div class="h-12 rounded-xl bg-zinc-100 dark:bg-zinc-800"></div>
        <div class="space-y-4 pt-2">
          <div class="h-11 rounded-xl bg-zinc-100 dark:bg-zinc-800"></div>
          <div class="h-11 rounded-xl bg-zinc-100 dark:bg-zinc-800"></div>
          <div class="h-12 rounded-xl bg-indigo-600/30"></div>
        </div>
      </div>
    </div>
  </AuthPage>
</Layout>
