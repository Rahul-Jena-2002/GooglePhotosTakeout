---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
---

<Layout 
  title="404: Page Not Found – TakeoutFix" 
  description="The requested page could not be found. Return to TakeoutFix home or view our Google Takeout restoration guide."
  robots="noindex, nofollow"
  showSideAds={false}
>
  <main class="min-h-[75vh] flex items-center justify-center px-4 sm:px-6 py-20">
    <div class="max-w-xl w-full text-center space-y-8 animate-fade-in">
      
      <!-- 404 Visual Icon & Pill -->
      <div class="flex flex-col items-center gap-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-500/10 text-rose-500 dark:text-rose-400 border border-rose-500/20 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
          Error 404 • Not Found
        </div>
        
        <div class="relative mt-4">
          <div class="text-8xl sm:text-9xl font-black tracking-tight text-zinc-200 dark:text-zinc-800/60 select-none font-mono">
            404
          </div>
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="text-4xl sm:text-5xl">🧭</span>
          </div>
        </div>
      </div>

      <!-- Heading & Explanation -->
      <div class="space-y-3">
        <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
          Page Not Found
        </h1>
        <p class="text-base text-zinc-600 dark:text-zinc-400 max-w-md mx-auto leading-relaxed">
          The link you followed may be broken, or the page may have been moved or removed. All your photos and metadata remain safe on your device.
        </p>
      </div>

      <!-- Action Navigation Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <a 
          href="/" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 font-semibold text-sm hover:opacity-90 transition-all shadow-sm"
        >
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          Go to Home
        </a>

        <a 
          href="/restore-data" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 text-zinc-800 dark:text-zinc-200 hover:bg-zinc-200 dark:hover:bg-zinc-700 font-semibold text-sm border border-zinc-200 dark:border-zinc-700 transition-all"
        >
          Restore Guide
        </a>

        <a 
          href="/support" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 text-zinc-800 dark:text-zinc-200 hover:bg-zinc-200 dark:hover:bg-zinc-700 font-semibold text-sm border border-zinc-200 dark:border-zinc-700 transition-all"
        >
          Support & FAQ
        </a>
      </div>

      <!-- Helpful Links Grid -->
      <div class="pt-8 border-t border-zinc-200 dark:border-zinc-800/80 text-xs text-zinc-500 dark:text-zinc-400 flex flex-wrap items-center justify-center gap-4">
        <span>Quick Links:</span>
        <a href="/pricing" class="hover:text-zinc-900 dark:hover:text-white underline underline-offset-4">Pricing</a>
        <a href="/download" class="hover:text-zinc-900 dark:hover:text-white underline underline-offset-4">Download Desktop App</a>
        <a href="/reviews" class="hover:text-zinc-900 dark:hover:text-white underline underline-offset-4">Customer Reviews</a>
        <a href="/refund" class="hover:text-zinc-900 dark:hover:text-white underline underline-offset-4">Refund Policy</a>
      </div>

    </div>
  </main>
</Layout>
