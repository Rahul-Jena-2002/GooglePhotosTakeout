---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Icon from "../components/ui/Icon.astro";
---

<Layout title="TakeoutFix | Privacy Policy" description="Learn what account and operational data TakeoutFix handles, how Google sign-in works, and how to delete your account.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mt-12 font-sans">
    
    <!-- Hero Header -->
    <div class="text-center mb-16 relative">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-900 dark:text-zinc-100 text-xs font-semibold uppercase tracking-wider mb-6 font-mono">
        <Icon name="shield" class="w-4 h-4 text-zinc-900 dark:text-zinc-100" />
        Data Privacy &amp; Security
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-zinc-900 dark:text-white mb-4">Privacy Policy</h1>
      <p class="text-lg md:text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto">Your files are yours. They never leave your device.</p>
      <p class="text-xs text-zinc-500 mt-2">Last updated: October 14, 2026</p>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-3 max-w-xl mx-auto leading-relaxed">
        TakeoutFix is an independent software utility. Google Takeout™ and Google Photos™ are trademarks of Google LLC.
        TakeoutFix is not affiliated with, endorsed by, or sponsored by Google LLC.
      </p>
    </div>

    <!-- 2-Column Responsive Layout (Main Content + Sticky Sidebar) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Main Content (lg:col-span-8) -->
      <div class="lg:col-span-8 space-y-12 leading-relaxed">
        
        <section id="guarantee" class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 relative overflow-hidden shadow-sm">
          <div class="absolute top-0 left-0 w-1.5 h-full bg-zinc-900 dark:bg-white"></div>
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3">The TakeoutFix Guarantee</h2>
          <p class="text-base sm:text-lg text-zinc-700 dark:text-zinc-300">
            <strong class="text-zinc-900 dark:text-white">TakeoutFix never uploads your files.</strong> We believe in local processing. Your photos, videos, and metadata remain strictly on your local device at all times.
          </p>
        </section>

        <section id="not-collected" class="space-y-4">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">Data We DO NOT Collect</h2>
          <ul class="grid sm:grid-cols-2 gap-4">
            {['Photos', 'Videos', 'EXIF metadata', 'GPS coordinates', 'File contents', 'Folder contents', 'Album contents', 'Personal media'].map(item => (
              <li class="flex items-center gap-3 bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 rounded-xl p-4 text-sm font-semibold">
                <Icon name="shield-alert" class="w-5 h-5 text-red-500 flex-shrink-0" />
                {item}
              </li>
            ))}
          </ul>
        </section>

        <section id="collected" class="space-y-4">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">Data We DO Collect</h2>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm">We collect the information needed to provide accounts, support, billing, security, and advertising:</p>
          <ul class="list-disc pl-6 space-y-2 text-zinc-600 dark:text-zinc-400 text-sm">
            <li><strong class="text-zinc-900 dark:text-white">Google sign-in information:</strong> When you choose Google sign-in, Firebase Authentication receives your Google account identifier, email address, name, and profile image (when provided). We use this information for authentication, your TakeoutFix profile, and account features. We do not request access to Google Drive, Google Photos, Gmail, or other Google user content.</li>
            <li><strong class="text-zinc-900 dark:text-white">Profile and account records:</strong> Names and usernames you enter, account settings, plan status, usage totals, restoration history, and account security/session records.</li>
            <li><strong class="text-zinc-900 dark:text-white">Support Inquiries:</strong> Any information you voluntarily provide when contacting customer support.</li>
            <li><strong class="text-zinc-900 dark:text-white">Diagnostics and hosting logs:</strong> Error reports and standard request/security metadata (such as IP address, browser details, requested URL, and request time) may be processed by our diagnostic and hosting providers.</li>
            <li><strong class="text-zinc-900 dark:text-white">Billing records:</strong> Purchase, transaction, and payment status information needed to provide paid features and receipts. Payment providers handle payment processing under their own privacy terms.</li>
            <li><strong class="text-zinc-900 dark:text-white">Advertising information:</strong> Ad providers may process browser/device details and ad impressions or interactions when ads are shown.</li>
            <li><strong class="text-zinc-900 dark:text-white">Media content:</strong> We do not receive the photos, videos, filenames, or metadata processed by the browser restoration tool.</li>
          </ul>
        </section>

        <section id="coppa" class="space-y-4">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">Children's Privacy</h2>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed">
            TakeoutFix is not directed to children under 13. If you believe a child has provided personal information through an account or support request, contact us so we can review and address the request.
          </p>
        </section>

        <section id="local-processing" class="space-y-4">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">Local Processing</h2>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed">
            The media processing tool runs in your browser using local file access and browser workers. Media file contents are processed on your device and are not uploaded by the restoration flow. Account, support, payment, diagnostics, and advertising features use separate network services described below.
          </p>
        </section>

        <section id="cookies" class="space-y-4">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">Cookies, Browser Storage &amp; Third-Party Services</h2>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed mb-4">
            Cookies are small values stored by a website or its providers. Firebase Authentication may use cookies or browser storage to maintain your sign-in session. TakeoutFix also uses local storage and IndexedDB for preferences and local workspace or processing state; this browser storage stays on your device unless a feature explicitly sends account data to a service. Clearing browser storage can sign you out or remove local workspace data. We do not sell or rent your personal data.
          </p>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed mb-4">
            We integrate trusted third-party service providers to support our operations:
          </p>
          <ul class="list-disc pl-6 space-y-2 mb-4 text-zinc-600 dark:text-zinc-400 text-sm">
            <li><strong class="text-zinc-900 dark:text-white">Firebase (Google LLC):</strong> Authentication, hosting, and operational database services.</li>
            <li><strong class="text-zinc-900 dark:text-white">Sentry:</strong> Error reporting and diagnostic context used to identify application defects.</li>
            <li><strong class="text-zinc-900 dark:text-white">Cloudflare Pages:</strong> Hosting and content delivery; its infrastructure may process request and security logs.</li>
            <li><strong class="text-zinc-900 dark:text-white">Google AdSense and A-Ads:</strong> Advertising providers may use cookies or similar technologies and process ad impressions or interactions when their ads are shown. Their practices and available controls are described in their own privacy materials.</li>
            <li><strong class="text-zinc-900 dark:text-white">Payment providers:</strong> Payment processors handle checkout and may retain transaction records under their own terms and legal obligations.</li>
          </ul>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed">The exact cookies, storage keys, and retention periods vary by provider, browser, and region. Use the “Privacy &amp; cookie choices” link in the footer to reopen Google's consent message when it is available and change your choice. You can manage browser storage in your browser settings and review Google's ad personalization choices in <a href="https://adssettings.google.com" target="_blank" rel="noopener noreferrer" class="text-zinc-900 dark:text-white underline font-semibold">Google Ads Settings</a>. The Google AdSense account's Privacy &amp; messaging settings control the consent message presented by Google's publisher tools; this policy page alone does not collect or record consent. Google requires publishers serving personalized ads in the EEA, UK, or Switzerland to use a Google-certified CMP integrated with the IAB TCF. See <a href="https://support.google.com/adsense/answer/13554020" target="_blank" rel="noopener noreferrer" class="text-zinc-900 dark:text-white underline font-semibold">Google's CMP requirements</a> and confirm the message is configured in the AdSense account before serving those ads.</p>
        </section>

        <section id="account-deletion" class="space-y-4">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">Account deletion and data requests</h2>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed">To delete your TakeoutFix account, sign in and open <a href="/profile" class="text-zinc-900 dark:text-white underline font-semibold">Profile Settings</a>, then choose <strong class="text-zinc-900 dark:text-white">Delete my account</strong>. This removes the Firebase sign-in account and associated TakeoutFix profile, recovery history, transaction, support-ticket, purchase-log, and active-session records handled by the deletion flow. Records held separately by payment or support providers may require a separate request or be retained where required by law. You may also review or remove TakeoutFix's connection in your Google Account settings; that action alone does not delete your TakeoutFix account. For data requests, contact <a href="mailto:takeoutfix.support@gmail.com" class="text-zinc-900 dark:text-white underline font-semibold">takeoutfix.support@gmail.com</a>. Files and browser data stored only on your device remain under your control.</p>
        </section>

        <section id="google-data" class="space-y-4">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">Google user data</h2>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed">Google sign-in data is used only to authenticate you and provide TakeoutFix account features. We do not sell Google user data or transfer it to advertising networks or data brokers. Account data is handled by Firebase services over encrypted connections and is subject to Google's applicable privacy and security terms.</p>
        </section>

        <section id="advertising" class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">Google AdSense &amp; Advertising Cookies</h2>
          <p class="mb-3 text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed">
            If ads are enabled on this site, Google and its advertising partners may use cookies or similar technologies to serve, limit, and measure advertising. Availability and personalization depend on your location, consent choices, and browser settings.
          </p>
          <ul class="list-disc pl-6 space-y-2 mb-4 text-sm text-zinc-600 dark:text-zinc-400">
            <li>
              <strong class="text-zinc-900 dark:text-white">Advertising partners:</strong> Google and other vendors may process information about visits and ad interactions under their own privacy terms.
            </li>
            <li>
              <strong class="text-zinc-900 dark:text-white">Ad choices:</strong> Where available, users can review or change Google's ad personalization settings in <a href="https://adssettings.google.com" target="_blank" rel="noopener noreferrer" class="text-zinc-900 dark:text-white underline font-semibold">Google Ads Settings</a>.
            </li>
            <li>
              <strong class="text-zinc-900 dark:text-white">Third-Party Ad Network Opt-Out:</strong> Alternatively, users can opt out of a third-party vendor's use of cookies for personalized advertising by visiting <a href="https://www.aboutads.info" target="_blank" rel="noopener noreferrer" class="text-zinc-900 dark:text-white underline font-semibold">www.aboutads.info</a> or the European Interactive Digital Advertising Alliance (EDAA) consumer choice page at <a href="https://www.youronlinechoices.eu" target="_blank" rel="noopener noreferrer" class="text-zinc-900 dark:text-white underline font-semibold">youronlinechoices.eu</a>.
            </li>
          </ul>
        </section>

        <section id="contact" class="space-y-4">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">Contact</h2>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed">
            If you have questions about this privacy policy, please contact us via our <a href="/contact" class="text-zinc-900 dark:text-white underline font-semibold">Contact Page</a> or directly via email at <a href="mailto:takeoutfix.support@gmail.com" class="text-zinc-900 dark:text-white underline font-semibold">takeoutfix.support@gmail.com</a>.
          </p>
        </section>

      </div>

      <!-- Sticky Quick-Navigation Sidebar (lg:col-span-4) -->
      <div class="lg:col-span-4 space-y-6">
        <div class="sticky top-28 space-y-6">
          
          <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 shadow-sm">
            <h3 class="text-sm font-bold uppercase tracking-wider text-zinc-900 dark:text-white mb-4 flex items-center gap-2">
              <Icon name="book-open" class="w-4 h-4 text-zinc-900 dark:text-white" />
              On This Page
            </h3>
            <nav class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
              <a href="#guarantee" class="block hover:text-zinc-900 dark:hover:text-white transition-colors py-1">1. The TakeoutFix Guarantee</a>
              <a href="#not-collected" class="block hover:text-zinc-900 dark:hover:text-white transition-colors py-1">2. Data We DO NOT Collect</a>
              <a href="#collected" class="block hover:text-zinc-900 dark:hover:text-white transition-colors py-1">3. Data We DO Collect</a>
              <a href="#coppa" class="block hover:text-zinc-900 dark:hover:text-white transition-colors py-1">4. Children's Privacy (COPPA)</a>
              <a href="#local-processing" class="block hover:text-zinc-900 dark:hover:text-white transition-colors py-1">5. Local Processing</a>
              <a href="#cookies" class="block hover:text-zinc-900 dark:hover:text-white transition-colors py-1">6. Cookies &amp; Third Parties</a>
              <a href="#advertising" class="block hover:text-zinc-900 dark:hover:text-white transition-colors py-1">7. Google AdSense &amp; Ads</a>
              <a href="#account-deletion" class="block hover:text-zinc-900 dark:hover:text-white transition-colors py-1">8. Account Deletion</a>
              <a href="#contact" class="block hover:text-zinc-900 dark:hover:text-white transition-colors py-1">9. Contact Desk</a>
            </nav>
          </div>

          <!-- Privacy Guarantee Badge Card -->
          <div class="bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 rounded-2xl p-6 shadow-md">
            <div class="flex items-center gap-3 mb-3">
              <Icon name="shield-check" class="w-6 h-6 text-emerald-400 dark:text-emerald-600" />
              <h4 class="font-bold text-base">Zero-Upload Guarantee</h4>
            </div>
            <p class="text-xs leading-relaxed text-zinc-300 dark:text-zinc-600 mb-4">
              All files are processed entirely in your web browser. No photos, videos, or metadata ever touch our servers.
            </p>
            <a 
              href="/tool" 
              class="inline-flex items-center gap-2 text-xs font-semibold px-4 py-2 rounded-xl bg-white/10 dark:bg-zinc-100 hover:bg-white/20 dark:hover:bg-zinc-200 transition-colors"
            >
              Test Offline Tool &rarr;
            </a>
          </div>

        </div>
      </div>

    </div>

  </div>
</Layout>
