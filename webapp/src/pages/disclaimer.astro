---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Icon from "../components/ui/Icon.astro";
---

<Layout 
  title="Legal Disclaimer & Trademark Disclosures – TakeoutFix" 
  description="Read the official TakeoutFix legal disclaimers, trademark notices, and limitations regarding Google LLC, Apple Inc., and local file handling."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mt-12 font-sans">
    
    <!-- Hero Header -->
    <div class="text-center mb-16 relative">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-semibold uppercase tracking-wider mb-6 font-mono">
        <Icon name="alert-triangle" class="w-4 h-4 text-amber-600 dark:text-amber-400" />
        Legal Notices &amp; Disclosures
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-zinc-900 dark:text-white mb-4">
        Disclaimer &amp; Disclosures
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400">Last updated: September 28, 2026</p>
    </div>

    <!-- 2-Column Responsive Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Main Content (lg:col-span-8) -->
      <div class="lg:col-span-8 space-y-10 leading-relaxed text-sm font-normal">
        
        <!-- Primary Non-Affiliation Box -->
        <section id="disclaimer-affiliation" class="bg-amber-500/5 border border-amber-500/20 rounded-2xl p-8 relative overflow-hidden shadow-sm">
          <div class="absolute top-0 left-0 w-1.5 h-full bg-amber-500"></div>
          <h2 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white mb-3 flex items-center gap-2">
            <Icon name="shield-alert" class="w-6 h-6 text-amber-500 flex-shrink-0" />
            Independent Software Notice &amp; Non-Affiliation
          </h2>
          <p class="text-zinc-700 dark:text-zinc-300 leading-relaxed mb-3">
            <strong>TakeoutFix is an independent utility software project.</strong> TakeoutFix is not affiliated with, sponsored by, endorsed by, authorized by, or in any way officially connected with <strong>Google LLC</strong>, <strong>Alphabet Inc.</strong>, <strong>Apple Inc.</strong>, or any of their subsidiaries or affiliates.
          </p>
          <p class="text-zinc-700 dark:text-zinc-300 leading-relaxed">
            The names <em>Google Takeout™</em>, <em>Google Photos™</em>, <em>Google Drive™</em>, and <em>Android™</em> are registered trademarks of Google LLC. The names <em>Apple Photos™</em>, <em>iCloud™</em>, <em>macOS™</em>, and <em>iOS™</em> are registered trademarks of Apple Inc. The use of these trademarks on this website is strictly nominative to describe file compatibility and export processes.
          </p>
        </section>

        <!-- As-Is Warranty -->
        <section id="disclaimer-warranty" class="space-y-4">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white">1. "As-Is" Software Provision</h2>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            TakeoutFix is provided on an "as is" and "as available" basis without warranties of any kind, whether express or implied, including, but not limited to, implied warranties of merchantability, fitness for a particular purpose, or non-infringement.
          </p>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            While our matching algorithms and EXIF writers are comprehensively tested against millions of photo combinations, we do not warrant that the software will be uninterrupted, error-free, or compatible with every possible hardware and corrupted archive configuration.
          </p>
        </section>

        <!-- Data Backup Recommendation -->
        <section id="disclaimer-backup" class="space-y-4">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white">2. Data Safety &amp; Backup Responsibility</h2>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Users are strongly encouraged to maintain an unaltered backup copy of their original Google Takeout ZIP archives or exported directory before initiating any metadata write operations. 
          </p>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            TakeoutFix processes files locally on your machine and writes metadata tags into headers. Although our operations are non-destructive and preserve raw image pixel arrays, the user bears ultimate responsibility for ensuring adequate backup redundancies for their personal data.
          </p>
        </section>

        <!-- Informational Content Disclaimer -->
        <section id="disclaimer-informational" class="space-y-4">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white">3. Informational &amp; Educational Content</h2>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            All tutorials, guides, articles, and troubleshooting steps published on TakeoutFix are provided for informational and educational purposes. While we strive to ensure technical accuracy regarding EXIF specifications, QuickTime atom structures, and platform behaviors, digital storage platforms and operating systems frequently update their software behaviors.
          </p>
        </section>

        <!-- Limitation of Liability -->
        <section id="disclaimer-liability" class="space-y-4">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white">4. Limitation of Liability</h2>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            To the maximum extent permitted by applicable law, in no event shall TakeoutFix, its creator (Rahul Jena), contributors, or affiliates be liable for any direct, indirect, incidental, special, consequential, or punitive damages, including loss of data, photos, profits, or goodwill arising out of or in connection with the use or inability to use this utility.
          </p>
        </section>

      </div>

      <!-- Sticky Quick-Navigation Sidebar (lg:col-span-4) -->
      <div class="lg:col-span-4 space-y-6">
        <div class="sticky top-28 space-y-6">
          
          <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 shadow-sm">
            <h3 class="text-sm font-bold uppercase tracking-wider text-zinc-900 dark:text-white mb-4 flex items-center gap-2">
              <Icon name="book-open" class="w-4 h-4 text-zinc-900 dark:text-white" />
              On This Page
            </h3>
            <nav class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
              <a href="#disclaimer-affiliation" class="block hover:text-zinc-900 dark:hover:text-white transition-colors py-1">Non-Affiliation Notice</a>
              <a href="#disclaimer-warranty" class="block hover:text-zinc-900 dark:hover:text-white transition-colors py-1">1. "As-Is" Software</a>
              <a href="#disclaimer-backup" class="block hover:text-zinc-900 dark:hover:text-white transition-colors py-1">2. Data Safety &amp; Backup</a>
              <a href="#disclaimer-informational" class="block hover:text-zinc-900 dark:hover:text-white transition-colors py-1">3. Educational Content</a>
              <a href="#disclaimer-liability" class="block hover:text-zinc-900 dark:hover:text-white transition-colors py-1">4. Limitation of Liability</a>
            </nav>
          </div>

          <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 shadow-sm">
            <h4 class="font-bold text-zinc-900 dark:text-white text-base mb-2">Have Questions?</h4>
            <p class="text-xs leading-relaxed text-zinc-600 dark:text-zinc-400 mb-4">
              Reach out to our support and engineering team with any questions.
            </p>
            <a 
              href="/contact" 
              class="inline-flex items-center gap-2 text-xs font-semibold px-4 py-2.5 rounded-xl bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 hover:opacity-90 transition-opacity"
            >
              Contact Support &rarr;
            </a>
          </div>

        </div>
      </div>

    </div>

  </div>
</Layout>
