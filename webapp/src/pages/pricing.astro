---
import Layout from "../layouts/Layout.astro";
import AdUnit from "../components/AdUnit";
import { PLAN_PRICES } from "../contexts/AuthContext";

const region = "us";
const prices = PLAN_PRICES[region] || PLAN_PRICES.us;
---

<Layout title="TakeoutFix | Pricing Plans" description="Choose the perfect metadata restoration plan for your Google Takeout archive. Free, single-use, and lifetime options available.">
  <div class="w-full max-w-7xl mx-auto px-6 py-24 font-sans select-none">
    <div class="text-center mb-12 flex flex-col items-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-white tracking-tight font-semibold animate-fade-in">
        Simple Pricing
      </h1>
      <p class="text-lg text-zinc-300 max-w-2xl mx-auto leading-relaxed">
        Every plan works completely on your computer to restore your photos safely and privately.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16 items-stretch">
      
      <!-- FREE PLAN -->
      <div class="flex flex-col bg-zinc-950/45 border border-zinc-900 rounded-2xl p-6 h-full justify-between hover:border-zinc-800 transition-all">
        <div>
          <div class="mb-6">
            <h2 class="text-2xl font-bold text-white font-semibold">Free</h2>
            <p class="text-zinc-500 text-xs mt-1">Try before you buy</p>
          </div>
          <div class="space-y-6">
            <div>
              <div class="text-4xl font-bold text-white"><span class="price-free">$0</span></div>
              <p class="text-[11px] text-zinc-400 mt-1 leading-relaxed">Test with a small set of photos to see how easy it is.</p>
            </div>
            <div class="space-y-2.5">
              <div class="text-[10px] text-zinc-400 uppercase tracking-widest font-bold mb-1">Includes</div>
              <ul class="space-y-2 text-xs text-zinc-300">
                <li class="flex items-center gap-1.5"><span class="text-green-400 font-bold">✓</span> Up to 1,000 photos (1 GB max)</li>
                <li class="flex items-center gap-1.5"><span class="text-green-400 font-bold">✓</span> Restores original dates & times</li>
                <li class="flex items-center gap-1.5"><span class="text-green-400 font-bold">✓</span> Works directly in your browser</li>
                <li class="flex items-center gap-1.5"><span class="text-green-400 font-bold">✓</span> Photos stay 100% private</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="mt-8">
          <a href="/tool" class="w-full">
            <button class="btn-monochrome-primary w-full py-3 rounded-xl font-bold text-xs cursor-pointer transition-all">Start Free Fix</button>
          </a>
        </div>
      </div>

      <!-- RECOVERY PASS -->
      <div class="flex flex-col bg-zinc-950/45 border border-zinc-900 rounded-2xl p-6 h-full justify-between hover:border-zinc-800 transition-all">
        <div>
          <div class="mb-6">
            <h2 class="text-2xl font-bold text-white font-semibold">Recovery Pass</h2>
            <p class="text-zinc-500 text-xs mt-1">Best for a single takeout download</p>
          </div>
          <div class="space-y-6">
            <div>
              <div class="text-4xl font-bold text-white"><span class="price-recovery-pass">{prices.recovery_pass}</span></div>
              <p class="text-[11px] text-zinc-400 mt-1 leading-relaxed">Fix one large folder of photos without any subscription details.</p>
            </div>
            <div class="space-y-2.5">
              <div class="text-[10px] text-zinc-400 uppercase tracking-widest font-bold mb-1">Everything in Free plus:</div>
              <ul class="space-y-2 text-xs text-zinc-350 dark:text-zinc-300">
                <li class="flex items-center gap-1.5 recovery-pass-highlight"><span class="font-bold">✓</span> Up to 10,000 photos (20 GB max)</li>
                <li class="flex items-center gap-1.5"><span class="text-zinc-600 dark:text-zinc-400 font-bold">✓</span> Friendly support help desk</li>
                <li class="flex items-center gap-1.5"><span class="text-zinc-600 dark:text-zinc-400 font-bold">✓</span> Download clean file update logs</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="mt-8">
          <a href={`/checkout?plan=recovery_pass&region=${region}`} class="w-full link-checkout-recovery-pass">
            <button class="btn-monochrome-primary w-full py-3 rounded-xl font-bold text-xs cursor-pointer transition-all">Get Recovery Pass</button>
          </a>
        </div>
      </div>

      <!-- PRO LIFETIME -->
      <div class="flex flex-col bg-zinc-950/45 border border-blue-500/30 rounded-2xl p-6 h-full relative justify-between scale-105 hover:border-blue-500/50 transition-all shadow-xl shadow-blue-500/5">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-blue-600 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-sm">
          Most Popular
        </div>
        <div>
          <div class="mb-6">
            <h2 class="text-2xl font-bold text-blue-500 dark:text-blue-400 font-semibold">Pro Lifetime</h2>
            <p class="text-blue-400 dark:text-blue-300 text-xs mt-1">For large photo collections</p>
          </div>
          <div class="space-y-6">
            <div>
              <div class="text-4xl font-bold text-white"><span class="price-pro">{prices.pro}</span></div>
              <p class="text-[11px] text-blue-500 dark:text-blue-300 mt-1 leading-relaxed">Use forever · On up to 2 devices</p>
            </div>
            <div class="space-y-2.5">
              <div class="text-[10px] text-zinc-400 uppercase tracking-widest font-bold mb-1">Everything in Pass plus:</div>
              <ul class="space-y-2 text-xs text-zinc-350 dark:text-zinc-300">
                <li class="flex items-center gap-1.5 font-semibold text-blue-500 dark:text-blue-400"><span class="text-blue-500 dark:text-blue-400 font-bold">✓</span> Unlimited photos & videos</li>
                <li class="flex items-center gap-1.5 font-semibold"><span class="text-blue-500 dark:text-blue-400 font-bold">✓</span> Keep history of your runs</li>
                <li class="flex items-center gap-1.5 font-semibold"><span class="text-blue-500 dark:text-blue-400 font-bold">✓</span> Priority support messages</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="mt-8">
          <a href={`/checkout?plan=pro&region=${region}`} class="w-full link-checkout-pro">
            <button class="btn-pro-blue w-full py-3 rounded-xl font-bold text-xs cursor-pointer transition-all">Go Pro</button>
          </a>
        </div>
      </div>

      <!-- SUPER LIFETIME -->
      <div class="flex flex-col bg-zinc-950/45 border border-amber-500/30 rounded-2xl p-6 h-full justify-between hover:border-amber-500/50 transition-all">
        <div>
          <div class="mb-6">
            <h2 class="text-2xl font-bold text-amber-500 font-semibold">Super Lifetime</h2>
            <p class="text-amber-300 text-xs mt-1">Advanced tools for photographers</p>
          </div>
          <div class="space-y-6">
            <div>
              <div class="text-4xl font-bold text-white"><span class="price-super">{prices.super}</span></div>
              <p class="text-[11px] text-amber-400 mt-1 leading-relaxed">Use forever · On up to 3 devices</p>
            </div>
            <div class="space-y-2.5">
              <div class="text-[10px] text-zinc-400 uppercase tracking-widest font-bold mb-1">Everything in Pro plus:</div>
              <ul class="space-y-2 text-xs text-zinc-300">
                <li class="flex items-center gap-1.5 font-semibold text-amber-500"><span class="text-amber-500 font-bold">✓</span> Complete ad-free experience</li>
                <li class="flex items-center gap-1.5 font-semibold"><span class="text-amber-500 font-bold">✓</span> View hidden photo details</li>
                <li class="flex items-center gap-1.5 font-semibold"><span class="text-amber-500 font-bold">✓</span> Find and clean duplicates</li>
                <li class="flex items-center gap-1.5 font-semibold"><span class="text-amber-500 font-bold">✓</span> Compare before & after logs</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="mt-8">
          <a href={`/checkout?plan=super&region=${region}`} class="w-full link-checkout-super">
            <button class="btn-super-orange w-full py-3 rounded-xl font-bold text-xs cursor-pointer transition-all">Go Super</button>
          </a>
        </div>
      </div>

    </div>

    <div class="w-full max-w-4xl mx-auto px-4 my-12">
      <AdUnit client:load type="horizontal" />
    </div>

    <!-- DETAILED COMPARISON TABLE -->
    <div class="mt-32">
      <h2 class="text-3xl font-bold text-center mb-12 text-white font-semibold">Compare Plans</h2>
      <div class="overflow-x-auto bg-zinc-950/20 border border-zinc-900 rounded-2xl">
        <table class="w-full text-left border-collapse min-w-[800px] text-sm text-zinc-300">
          <thead>
            <tr class="border-b border-zinc-900 bg-zinc-950/40">
              <th class="py-4 px-6 font-semibold text-zinc-400 w-1/3">Feature</th>
              <th class="py-4 px-6 font-bold text-center">Free</th>
              <th class="py-4 px-6 font-bold text-center">Single Pass</th>
              <th class="py-4 px-6 font-bold text-center text-indigo-400">Pro Lifetime</th>
              <th class="py-4 px-6 font-bold text-center text-amber-500">Super Lifetime</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-zinc-900 hover:bg-white/[0.01]">
              <td class="py-4 px-6 font-medium text-white">Device Limit</td>
              <td class="py-4 px-6 text-center text-zinc-300 font-normal">1 device</td>
              <td class="py-4 px-6 text-center text-zinc-300 font-normal">1 device</td>
              <td class="py-4 px-6 text-center text-zinc-300 font-bold">2 devices</td>
              <td class="py-4 px-6 text-center text-zinc-300 font-bold">3 devices</td>
            </tr>
            <tr class="border-b border-zinc-900 hover:bg-white/[0.01]">
              <td class="py-4 px-6 font-medium text-white">Processing Limit</td>
              <td class="py-4 px-6 text-center text-zinc-300 font-normal">1 GB (1,000 files)</td>
              <td class="py-4 px-6 text-center text-zinc-300 font-normal">20 GB (10,000 files)</td>
              <td class="py-4 px-6 text-center text-green-400 font-bold">Unlimited</td>
              <td class="py-4 px-6 text-center text-green-400 font-bold">Unlimited</td>
            </tr>
            <tr class="border-b border-zinc-900 hover:bg-white/[0.01]">
              <td class="py-4 px-6 font-medium text-white">Photo Matching</td>
              <td class="py-4 px-6 text-center text-zinc-300 font-normal">100% Complete</td>
              <td class="py-4 px-6 text-center text-zinc-300 font-normal">100% Complete</td>
              <td class="py-4 px-6 text-center text-zinc-300 font-normal">100% Complete</td>
              <td class="py-4 px-6 text-center text-zinc-300 font-normal">100% Complete</td>
            </tr>
            <tr class="border-b border-zinc-900 hover:bg-white/[0.01]">
              <td class="py-4 px-6 font-medium text-white">Advanced Media Tools</td>
              <td class="py-4 px-6 text-center text-zinc-500">—</td>
              <td class="py-4 px-6 text-center text-zinc-500">—</td>
              <td class="py-4 px-6 text-center text-zinc-500">—</td>
              <td class="py-4 px-6 text-center text-amber-500 font-bold">Included</td>
            </tr>
            <tr class="border-b border-zinc-900 hover:bg-white/[0.01]">
              <td class="py-4 px-6 font-medium text-white">No Ads Window</td>
              <td class="py-4 px-6 text-center text-zinc-500">—</td>
              <td class="py-4 px-6 text-center text-zinc-500">—</td>
              <td class="py-4 px-6 text-center text-zinc-500">—</td>
              <td class="py-4 px-6 text-center text-green-400 font-bold">✓ Enabled</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-20 max-w-2xl mx-auto" style="text-align: center !important;">
      <h2 class="text-2xl font-bold mb-8 text-white font-semibold" style="text-align: center !important;">Plan Limits & Guarantee Conditions</h2>
      
      <div class="bg-zinc-950/45 border border-zinc-900 p-8 rounded-2xl space-y-8" style="text-align: center !important;">
        <div style="text-align: center !important;">
          <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-3" style="text-align: center !important;">Enforcement of Limits</h3>
          <p class="text-xs text-zinc-300 leading-relaxed max-w-md mx-auto" style="text-align: center !important; margin: 0 auto;">
            Limits on <strong>Free</strong> (1,000 files/1 GB) and <strong>Recovery Pass</strong> (10,000 files/20 GB) are enforced on a <strong>"whichever comes first"</strong> basis. Device limits are tied to your browser installation environment. Paid lifetime licenses allow activation on up to 2 or 3 separate devices simultaneously.
          </p>
        </div>
        
        <div class="border-t border-zinc-900 pt-6" style="text-align: center !important;">
          <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-3" style="text-align: center !important;">7-Day Refund Policy</h3>
          <p class="text-xs text-zinc-300 leading-relaxed max-w-md mx-auto" style="text-align: center !important; margin: 0 auto;">
            We offer a 100% Recovery Guarantee: if a verified technical issue prevents your restoration, and our support desk is unable to resolve it, we will issue a full refund within 7 days of purchase. Refunds are not available for change of mind or successfully completed recoveries.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  let globalSettings = {
    t3_recovery_pass: 4.99,
    t3_pro: 29.00,
    t3_super: 49.00,
    
    t2_recovery_pass: 3.99,
    t2_pro: 19.00,
    t2_super: 39.00,
    
    t1_recovery_pass: 1.49,
    t1_pro: 9.99,
    t1_super: 19.99,
    
    in_recovery_pass: 99,
    in_pro: 799,
    in_super: 1499
  };

  function getRegionFromCountry(countryCode) {
    const country = countryCode.toUpperCase();
    if (country === 'IN') return 'in';
    const lowTiers = ["PK", "BD", "NP", "LK", "ID", "VN", "PH", "NG", "KE", "EG", "CN"];
    const midTiers = ["MY", "TH", "MX", "BR", "TR", "ZA", "AR", "CL", "PL", "RO"];
    if (lowTiers.includes(country)) return 't1';
    if (midTiers.includes(country)) return 't2';
    return 't3';
  }

  function calculatePrices(countryCode) {
    const regionKey = getRegionFromCountry(countryCode);

    if (regionKey === 'in') {
      return {
        free: "₹0",
        recovery_pass: `₹${globalSettings.in_recovery_pass}`,
        pro: `₹${globalSettings.in_pro}`,
        super: `₹${globalSettings.in_super}`
      };
    }

    if (regionKey === 't2') {
      return {
        free: "$0",
        recovery_pass: `$${globalSettings.t2_recovery_pass.toFixed(2)}`,
        pro: `$${globalSettings.t2_pro}`,
        super: `$${globalSettings.t2_super}`
      };
    }

    if (regionKey === 't1') {
      return {
        free: "$0",
        recovery_pass: `$${globalSettings.t1_recovery_pass.toFixed(2)}`,
        pro: `$${globalSettings.t1_pro}`,
        super: `$${globalSettings.t1_super}`
      };
    }

    return {
      free: "$0",
      recovery_pass: `$${globalSettings.t3_recovery_pass.toFixed(2)}`,
      pro: `$${globalSettings.t3_pro}`,
      super: `$${globalSettings.t3_super}`
    };
  }

  function updatePrices(countryCode) {
    const prices = calculatePrices(countryCode);
    const region = getRegionFromCountry(countryCode);

    document.querySelectorAll(".price-free").forEach(el => el.textContent = prices.free);
    document.querySelectorAll(".price-recovery-pass").forEach(el => el.textContent = prices.recovery_pass);
    document.querySelectorAll(".price-pro").forEach(el => el.textContent = prices.pro);
    document.querySelectorAll(".price-super").forEach(el => el.textContent = prices.super);
    
    document.querySelectorAll(".link-checkout-recovery-pass").forEach(el => el.setAttribute("href", `/checkout?plan=recovery_pass&region=${region}`));
    document.querySelectorAll(".link-checkout-pro").forEach(el => el.setAttribute("href", `/checkout?plan=pro&region=${region}`));
    document.querySelectorAll(".link-checkout-super").forEach(el => el.setAttribute("href", `/checkout?plan=super&region=${region}`));
  }

  async function fetchSettingsAndInit() {
    try {
      const res = await fetch("https://firestore.googleapis.com/v1/projects/gt-metadata-merger/databases/(default)/documents/settings/global");
      if (res.ok) {
        const json = await res.json();
        const fields = json.fields || {};
        
        const getNum = (fieldObj) => {
          if (!fieldObj) return null;
          if (fieldObj.doubleValue !== undefined) return Number(fieldObj.doubleValue);
          if (fieldObj.integerValue !== undefined) return Number(fieldObj.integerValue);
          if (fieldObj.stringValue !== undefined) return Number(fieldObj.stringValue);
          return null;
        };

        globalSettings.t3_recovery_pass = getNum(fields.t3_recovery_pass) ?? globalSettings.t3_recovery_pass;
        globalSettings.t3_pro = getNum(fields.t3_pro) ?? globalSettings.t3_pro;
        globalSettings.t3_super = getNum(fields.t3_super) ?? globalSettings.t3_super;

        globalSettings.t2_recovery_pass = getNum(fields.t2_recovery_pass) ?? globalSettings.t2_recovery_pass;
        globalSettings.t2_pro = getNum(fields.t2_pro) ?? globalSettings.t2_pro;
        globalSettings.t2_super = getNum(fields.t2_super) ?? globalSettings.t2_super;

        globalSettings.t1_recovery_pass = getNum(fields.t1_recovery_pass) ?? globalSettings.t1_recovery_pass;
        globalSettings.t1_pro = getNum(fields.t1_pro) ?? globalSettings.t1_pro;
        globalSettings.t1_super = getNum(fields.t1_super) ?? globalSettings.t1_super;

        globalSettings.in_recovery_pass = getNum(fields.in_recovery_pass) ?? globalSettings.in_recovery_pass;
        globalSettings.in_pro = getNum(fields.in_pro) ?? globalSettings.in_pro;
        globalSettings.in_super = getNum(fields.in_super) ?? globalSettings.in_super;
      }
    } catch (e) {
      console.warn("Failed to fetch settings from Firestore:", e);
    }

    let countryCode = localStorage.getItem("takeoutfix_selected_country") || "";
    
    if (!countryCode) {
      // 1. Try Cloudflare cdn-cgi trace first
      try {
        const res = await fetch("/cdn-cgi/trace");
        if (res.ok) {
          const text = await res.text();
          const lines = text.split("\n");
          for (const line of lines) {
            const parts = line.split("=");
            if (parts[0] === "loc" && parts[1]) {
              countryCode = parts[1].trim().toUpperCase();
              break;
            }
          }
        }
      } catch (e) {}
    }

    if (!countryCode) {
      // 2. Try freeipapi
      try {
        const res = await fetch("https://freeipapi.com/api/json");
        if (res.ok) {
          const data = await res.json();
          countryCode = data.countryCode || "";
        }
      } catch (e) {}
    }

    if (!countryCode) {
      // 3. Fallback based on timezone
      try {
        const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
        if (tz) {
          const lowerTz = tz.toLowerCase();
          if (lowerTz.includes("kolkata") || lowerTz.includes("calcutta") || lowerTz.includes("india")) countryCode = "IN";
          else if (lowerTz.includes("tokyo") || lowerTz.includes("japan")) countryCode = "JP";
          else if (lowerTz.includes("shanghai") || lowerTz.includes("beijing") || lowerTz.includes("china")) countryCode = "CN";
          else if (lowerTz.includes("london") || lowerTz.includes("paris") || lowerTz.includes("berlin") || lowerTz.includes("rose")) countryCode = "GB";
        }
      } catch (e) {}
    }

    if (!countryCode) {
      countryCode = "US";
    }

    countryCode = countryCode.toUpperCase();
    updatePrices(countryCode);
  }

  let priceUpdateDone = false;
  async function initWrapper() {
    if (priceUpdateDone) return;
    priceUpdateDone = true;
    await fetchSettingsAndInit();
  }

  // Listen to Astro page transitions
  document.addEventListener("astro:page-load", () => {
    priceUpdateDone = false;
    initWrapper();
  });

  // Listen for dynamic country detection events
  window.addEventListener("takeoutfix-country-detected", (e: any) => {
    updatePrices(e.detail);
  });

  // Trigger on hover/touch instantly
  window.addEventListener("mouseover", initWrapper, { once: true });
  window.addEventListener("touchstart", initWrapper, { once: true });
</script>
