---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Icon from "../components/ui/Icon.astro";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact TakeoutFix Support & Inquiries",
  "description": "Get in touch with the TakeoutFix technical support, customer care, and developer team for help with Google Takeout metadata restoration.",
  "url": "https://takeoutfix.pages.dev/contact",
  "mainEntity": {
    "@type": "Organization",
    "name": "TakeoutFix",
    "url": "https://takeoutfix.pages.dev",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "takeoutfix.support@gmail.com",
      "contactType": "Customer Support",
      "availableLanguage": ["English"]
    }
  }
};
---

<Layout 
  title="Contact Us – TakeoutFix Customer & Technical Support" 
  description="Need help with your Google Takeout photo metadata restoration? Contact the TakeoutFix engineering team directly for prompt technical assistance."
>
  <!-- Schema.org JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mt-12 font-sans">
    
    <!-- Hero Section -->
    <div class="text-center mb-16 relative">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-900 dark:text-zinc-100 text-xs font-semibold uppercase tracking-wider mb-6 font-mono">
        <Icon name="mail" class="w-4 h-4 text-zinc-900 dark:text-zinc-100" />
        Get in Touch
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-zinc-900 dark:text-white mb-6 leading-tight">
        How Can We <br class="hidden sm:inline" />
        <span class="text-zinc-500 dark:text-zinc-400">Help You Today?</span>
      </h1>
      <p class="text-base sm:text-lg md:text-xl text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed font-normal">
        Have a question about restoring your photo dates, migrating to Apple Photos, or encountering an unhandled Takeout format? Our engineering desk is here to help.
      </p>
    </div>

    <!-- Contact Channels Bento (3-Card Full-Width Grid) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      
      <!-- Direct Email -->
      <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 hover:border-zinc-400 dark:hover:border-zinc-600 transition-all flex flex-col justify-between shadow-sm">
        <div>
          <div class="w-12 h-12 rounded-xl bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center mb-5 text-zinc-900 dark:text-white">
            <Icon name="mail" class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-2">Direct Email Support</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal mb-6">
            For technical issues, format questions, and debug logs. We reply to all engineering inquiries within 24 to 48 business hours.
          </p>
        </div>
        <a 
          href="mailto:takeoutfix.support@gmail.com" 
          class="text-sm font-semibold text-zinc-900 dark:text-white hover:underline break-all transition-colors inline-flex items-center gap-2 pt-4 border-t border-zinc-200 dark:border-zinc-800"
        >
          takeoutfix.support@gmail.com
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>

      <!-- Technical Documentation -->
      <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 hover:border-zinc-400 dark:hover:border-zinc-600 transition-all flex flex-col justify-between shadow-sm">
        <div>
          <div class="w-12 h-12 rounded-xl bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center mb-5 text-zinc-900 dark:text-white">
            <Icon name="book-open" class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-2">Technical Guides &amp; Docs</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal mb-6">
            Browse troubleshooting manuals, sidecar matching explanations, and step-by-step storage migration tutorials.
          </p>
        </div>
        <a 
          href="/guides" 
          class="text-sm font-semibold text-zinc-900 dark:text-white hover:underline transition-colors inline-flex items-center gap-2 pt-4 border-t border-zinc-200 dark:border-zinc-800"
        >
          Browse Knowledge Base
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>

      <!-- Support Center -->
      <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 hover:border-zinc-400 dark:hover:border-zinc-600 transition-all flex flex-col justify-between shadow-sm">
        <div>
          <div class="w-12 h-12 rounded-xl bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center mb-5 text-zinc-900 dark:text-white">
            <Icon name="help-circle" class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-2">Support &amp; FAQ</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal mb-6">
            Manage your support tickets, view system status, and browse curated answers to common Takeout questions.
          </p>
        </div>
        <a 
          href="/support" 
          class="text-sm font-semibold text-zinc-900 dark:text-white hover:underline transition-colors inline-flex items-center gap-2 pt-4 border-t border-zinc-200 dark:border-zinc-800"
        >
          Visit Support Center
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>

    </div>

    <!-- Contact Form & FAQ Container (12-Column Grid) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-16">
      
      <!-- Contact Form (lg:col-span-7) -->
      <div class="lg:col-span-7 bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 sm:p-10 shadow-sm">
        <h2 class="text-2xl sm:text-3xl font-bold text-zinc-900 dark:text-white mb-2">Send Us a Direct Message</h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-8 font-normal">
          Fill out this form and your message will be forwarded directly to our engineering desk.
        </p>

        <form id="contact-page-form" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="contact-name" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-2">
                Your Name
              </label>
              <input 
                type="text" 
                id="contact-name" 
                name="name" 
                required
                placeholder="e.g. Sarah Connor"
                class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 rounded-xl px-4 py-3 text-sm text-zinc-900 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 transition-all"
              />
            </div>

            <div>
              <label for="contact-email" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-2">
                Email Address
              </label>
              <input 
                type="email" 
                id="contact-email" 
                name="email" 
                required
                placeholder="e.g. sarah@example.com"
                class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 rounded-xl px-4 py-3 text-sm text-zinc-900 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 transition-all"
              />
            </div>
          </div>

          <div>
            <label for="contact-category" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-2">
              Inquiry Type
            </label>
            <select 
              id="contact-category" 
              name="category"
              class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 rounded-xl px-4 py-3 text-sm text-zinc-900 dark:text-white focus:outline-none focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 transition-all"
            >
              <option value="technical">Technical Support / Takeout Error</option>
              <option value="feature">Feature Request / Format Support</option>
              <option value="feedback">Feedback / Improvement Suggestion</option>
              <option value="partnership">Press / Partnership / Other</option>
            </select>
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-2">
              Your Message
            </label>
            <textarea 
              id="contact-message" 
              name="message" 
              rows="5" 
              required
              placeholder="Please describe your issue or question in detail (include OS, browser, or camera model if applicable)..."
              class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 rounded-xl px-4 py-3 text-sm text-zinc-900 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-zinc-500 focus:ring-1 focus:ring-zinc-500 transition-all resize-y"
            ></textarea>
          </div>

          <div id="contact-status" class="hidden text-xs py-3 px-4 rounded-xl"></div>

          <button 
            type="submit" 
            id="contact-submit-btn"
            class="w-full py-4 px-6 rounded-xl bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 hover:opacity-90 font-semibold text-sm transition-opacity shadow-sm cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Send Message</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </button>
        </form>

        <script is:inline>
          document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('contact-page-form');
            const statusEl = document.getElementById('contact-status');

            if (form && statusEl) {
              form.addEventListener('submit', (e) => {
                e.preventDefault();
                const name = document.getElementById('contact-name').value;
                const email = document.getElementById('contact-email').value;
                const category = document.getElementById('contact-category').value;
                const message = document.getElementById('contact-message').value;

                const subject = encodeURIComponent(`[TakeoutFix Contact - ${category}] From: ${name}`);
                const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\nCategory: ${category}\n\nMessage:\n${message}`);
                
                statusEl.className = "text-xs py-3 px-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 block font-medium";
                statusEl.textContent = "Opening your email client... You can also email us directly at takeoutfix.support@gmail.com.";
                
                window.location.href = `mailto:takeoutfix.support@gmail.com?subject=${subject}&body=${body}`;
              });
            }
          });
        </script>
      </div>

      <!-- Quick FAQs & Telemetry Note (lg:col-span-5) -->
      <div class="lg:col-span-5 space-y-6">
        <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">Frequently Asked Questions</h3>

        <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 shadow-sm">
          <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-2 flex items-center gap-2">
            <Icon name="help-circle" class="w-4 h-4 text-zinc-700 dark:text-zinc-300 flex-shrink-0" />
            Do my photos get uploaded to your servers?
          </h4>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal">
            No, never. TakeoutFix operates entirely inside your local browser sandbox or desktop runtime. Your photos never leave your device.
          </p>
        </div>

        <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 shadow-sm">
          <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-2 flex items-center gap-2">
            <Icon name="help-circle" class="w-4 h-4 text-zinc-700 dark:text-zinc-300 flex-shrink-0" />
            Why did my photos have wrong dates?
          </h4>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal">
            Google Takeout stores original capture dates in detached JSON sidecar files. TakeoutFix merges the timestamps directly into the image EXIF tags.
          </p>
        </div>

        <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 shadow-sm">
          <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-2 flex items-center gap-2">
            <Icon name="help-circle" class="w-4 h-4 text-zinc-700 dark:text-zinc-300 flex-shrink-0" />
            Is TakeoutFix completely free to use?
          </h4>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal">
            Yes, TakeoutFix is 100% free and open. All metadata restoration runs entirely within your browser with zero paywalls, subscriptions, or file limits.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30 text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
          <p>
            <strong>Note:</strong> We are an independent software engineering team. For official Google Account or Google One storage recovery, please consult Google's official support directly.
          </p>
        </div>
      </div>

    </div>

    <!-- Trust Strip Matching Homepage -->
    <div class="flex flex-wrap justify-center gap-x-8 gap-y-4 text-sm font-semibold text-zinc-700 dark:text-zinc-300 px-6 py-6 border-y border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-950/20 rounded-xl">
      <div class="flex items-center gap-2">
        <Icon name="check" class="w-4 h-4 text-zinc-900 dark:text-zinc-100 flex-shrink-0" />
        <span>100% Free &amp; Private</span>
      </div>
      <div class="flex items-center gap-2">
        <Icon name="check" class="w-4 h-4 text-zinc-900 dark:text-zinc-100 flex-shrink-0" />
        <span>Local Client Processing</span>
      </div>
      <div class="flex items-center gap-2">
        <Icon name="check" class="w-4 h-4 text-zinc-900 dark:text-zinc-100 flex-shrink-0" />
        <span>Zero Server Uploads</span>
      </div>
    </div>

  </div>
</Layout>
