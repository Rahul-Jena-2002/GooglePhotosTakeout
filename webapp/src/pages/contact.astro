---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Icon from "../components/ui/Icon.astro";

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact TakeoutFix Support & Inquiries",
  "description": "Get in touch with the TakeoutFix technical support, customer care, and developer team for help with Google Takeout metadata restoration.",
  "url": "https://takeoutfix.pages.dev/contact",
  "mainEntity": {
    "@type": "Organization",
    "name": "TakeoutFix",
    "url": "https://takeoutfix.pages.dev",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "takeoutfix.support@gmail.com",
      "contactType": "Customer Support",
      "availableLanguage": ["English"]
    }
  }
};
---

<Layout 
  title="Contact Us – TakeoutFix Customer & Technical Support" 
  description="Need help with your Google Takeout photo metadata restoration? Contact the TakeoutFix engineering team directly for prompt technical assistance."
>
  <!-- Schema.org JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mt-12 font-sans">
    
    <!-- Hero Section -->
    <div class="text-center mb-16 relative">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-6 font-mono">
        <Icon name="mail" class="w-4 h-4" />
        Get in Touch
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-white mb-6 leading-tight">
        How Can We <br class="hidden sm:inline" />
        <span class="text-indigo-600 dark:text-indigo-400">Help You Today?</span>
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed font-normal">
        Have a question about restoring your photo dates, migrating to Apple Photos, or encountering an unhandled Takeout format? We're here to help.
      </p>
    </div>

    <!-- Contact Channels Bento -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      
      <!-- Direct Email -->
      <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 hover:border-indigo-500/30 transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center mb-4 text-indigo-600 dark:text-indigo-400">
            <Icon name="mail" class="w-6 h-6" />
          </div>
          <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-2">Direct Email Support</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal mb-4">
            For technical issues, bug reports, and account questions. We reply to all inquiries within 24 to 48 business hours.
          </p>
        </div>
        <a 
          href="mailto:takeoutfix.support@gmail.com" 
          class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:underline break-all transition-colors flex items-center gap-1.5"
        >
          takeoutfix.support@gmail.com &rarr;
        </a>
      </div>

      <!-- Technical Documentation -->
      <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 hover:border-indigo-500/30 transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center mb-4 text-indigo-600 dark:text-indigo-400">
            <Icon name="book-open" class="w-6 h-6" />
          </div>
          <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-2">Technical Guides &amp; Docs</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal mb-4">
            Browse troubleshooting manuals, sidecar matching explanations, and step-by-step migration tutorials.
          </p>
        </div>
        <a 
          href="/guides" 
          class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:underline transition-colors flex items-center gap-1.5"
        >
          Browse Knowledge Base &rarr;
        </a>
      </div>

      <!-- Support Center -->
      <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 hover:border-indigo-500/30 transition-all flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center mb-4 text-indigo-600 dark:text-indigo-400">
            <Icon name="help-circle" class="w-6 h-6" />
          </div>
          <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-2">Support &amp; FAQ</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal mb-4">
            Manage your support tickets, view system status, and browse curated answers to common questions.
          </p>
        </div>
        <a 
          href="/support" 
          class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:underline transition-colors flex items-center gap-1.5"
        >
          Visit Support Center &rarr;
        </a>
      </div>

    </div>

    <!-- Contact Form & FAQ Container -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16">
      
      <!-- Contact Form -->
      <div class="lg:col-span-7 bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 sm:p-8">
        <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-2">Send Us a Direct Message</h2>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-6 font-normal">
          Fill out this form and your message will be forwarded directly to our engineering desk.
        </p>

        <form id="contact-page-form" class="space-y-4">
          <div>
            <label for="contact-name" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
              Your Name
            </label>
            <input 
              type="text" 
              id="contact-name" 
              name="name" 
              required
              placeholder="e.g. Sarah Connor"
              class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 rounded-xl px-4 py-3 text-sm text-zinc-900 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all"
            />
          </div>

          <div>
            <label for="contact-email" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
              Email Address
            </label>
            <input 
              type="email" 
              id="contact-email" 
              name="email" 
              required
              placeholder="e.g. sarah@example.com"
              class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 rounded-xl px-4 py-3 text-sm text-zinc-900 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all"
            />
          </div>

          <div>
            <label for="contact-category" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
              Inquiry Type
            </label>
            <select 
              id="contact-category" 
              name="category"
              class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 rounded-xl px-4 py-3 text-sm text-zinc-900 dark:text-white focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all"
            >
              <option value="technical">Technical Support / Takeout Error</option>
              <option value="feature">Feature Request / Format Support</option>
              <option value="feedback">Feedback / Improvement Suggestion</option>
              <option value="partnership">Press / Partnership / Other</option>
            </select>
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
              Your Message
            </label>
            <textarea 
              id="contact-message" 
              name="message" 
              rows="4" 
              required
              placeholder="Please describe your issue or question in detail (include OS, browser, or camera model if applicable)..."
              class="w-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 rounded-xl px-4 py-3 text-sm text-zinc-900 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all resize-y"
            ></textarea>
          </div>

          <div id="contact-status" class="hidden text-xs py-2 px-3 rounded-lg"></div>

          <button 
            type="submit" 
            id="contact-submit-btn"
            class="w-full py-3.5 px-6 rounded-xl bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 hover:opacity-90 font-semibold text-sm transition-opacity shadow-sm cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Send Message</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </button>
        </form>

        <script is:inline>
          document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('contact-page-form');
            const statusEl = document.getElementById('contact-status');
            const submitBtn = document.getElementById('contact-submit-btn');

            if (form) {
              form.addEventListener('submit', (e) => {
                e.preventDefault();
                const name = document.getElementById('contact-name').value;
                const email = document.getElementById('contact-email').value;
                const category = document.getElementById('contact-category').value;
                const message = document.getElementById('contact-message').value;

                // Open direct mailto fallback or submit
                const subject = encodeURIComponent(`[TakeoutFix Contact - ${category}] From: ${name}`);
                const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\nCategory: ${category}\n\nMessage:\n${message}`);
                
                statusEl.className = "text-xs py-2.5 px-3 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 block font-medium";
                statusEl.innerHTML = "Opening your email client... You can also email us directly at <strong>takeoutfix.support@gmail.com</strong>.";
                
                window.location.href = `mailto:takeoutfix.support@gmail.com?subject=${subject}&body=${body}`;
              });
            }
          });
        </script>
      </div>

      <!-- Quick FAQs -->
      <div class="lg:col-span-5 space-y-4">
        <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-4">Frequently Asked Questions</h3>

        <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5">
          <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-2 flex items-center gap-2">
            <Icon name="help-circle" class="w-4 h-4 text-indigo-600 dark:text-indigo-400 flex-shrink-0" />
            Do my photos get uploaded to your servers?
          </h4>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal">
            No, never. TakeoutFix operates entirely inside your local browser sandbox or desktop runtime. Your photos never leave your device.
          </p>
        </div>

        <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5">
          <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-2 flex items-center gap-2">
            <Icon name="help-circle" class="w-4 h-4 text-indigo-600 dark:text-indigo-400 flex-shrink-0" />
            Why did my photos have wrong dates?
          </h4>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal">
            Google Takeout stores original capture dates in detached JSON sidecar files. TakeoutFix merges the timestamps directly into the image EXIF tags.
          </p>
        </div>

        <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-5">
          <h4 class="text-sm font-semibold text-zinc-900 dark:text-white mb-2 flex items-center gap-2">
            <Icon name="help-circle" class="w-4 h-4 text-indigo-600 dark:text-indigo-400 flex-shrink-0" />
            Is TakeoutFix completely free to use?
          </h4>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal">
            Yes, TakeoutFix is 100% free and open. All metadata restoration runs entirely within your browser with zero paywalls, subscriptions, or file limits.
          </p>
        </div>

        <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30 text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
          <p>
            <strong>Note:</strong> We are an independent software engineering team. For official Google Account or Google One storage recovery, please consult Google's official support directly.
          </p>
        </div>
      </div>

    </div>

  </div>
</Layout>
