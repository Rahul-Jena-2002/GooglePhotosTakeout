---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Icon from "../components/ui/Icon.astro";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "TakeoutFix",
  "url": "https://takeoutfix.pages.dev",
  "logo": "https://takeoutfix.pages.dev/favicon-192x192.png",
  "founder": {
    "@type": "Person",
    "name": "Rahul Jena",
    "jobTitle": "Lead Software Engineer & Creator",
    "url": "https://github.com/Rahul-Jena-2002"
  },
  "sameAs": [
    "https://github.com/Rahul-Jena-2002/GooglePhotosTakeout",
    "https://github.com/sponsors/Rahul-Jena-2002"
  ],
  "description": "Independent software utility provider specializing in privacy-first, client-side metadata restoration and multimedia file organization for Google Takeout photo archives."
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About TakeoutFix",
  "description": "Learn about the mission, engineering architecture, and team behind TakeoutFix — the privacy-first Google Takeout photo metadata restorer.",
  "url": "https://takeoutfix.pages.dev/about",
  "mainEntity": organizationSchema
};
---

<Layout 
  title="About Us – The Mission & Team Behind TakeoutFix" 
  description="Learn about TakeoutFix, our local-first engineering philosophy, and how we help users restore missing photo EXIF metadata from Google Takeout exports safely and privately."
>
  <!-- Schema.org JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mt-12 font-sans">
    
    <!-- Hero Section -->
    <div class="text-center mb-16 relative">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-6 font-mono">
        <Icon name="info" class="w-4 h-4" />
        About Our Project & Team
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight">
        Preserving Digital Memories with <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-500">
          Privacy-First Engineering
        </span>
      </h1>
      <p class="text-lg md:text-xl text-zinc-400 max-w-3xl mx-auto leading-relaxed font-normal">
        TakeoutFix was founded to solve a frustrating problem faced by millions: when you download your photo archives from Google Takeout, your photos lose their capture dates, camera tags, and GPS coordinates. We built a fast, zero-upload tool to reunite them.
      </p>
    </div>

    <!-- Core Philosophy Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      
      <div class="bg-zinc-950/40 border border-white/10 rounded-2xl p-6 backdrop-blur-md relative overflow-hidden group hover:border-indigo-500/30 transition-all">
        <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center mb-5 text-indigo-400">
          <Icon name="shield-check" class="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold text-white mb-2">100% Local-First</h3>
        <p class="text-sm text-zinc-400 leading-relaxed font-normal">
          Your personal photos and memories never leave your device. All parsing, file matching, and EXIF injection execute inside your browser sandbox via WebAssembly and Web Workers.
        </p>
      </div>

      <div class="bg-zinc-950/40 border border-white/10 rounded-2xl p-6 backdrop-blur-md relative overflow-hidden group hover:border-purple-500/30 transition-all">
        <div class="w-12 h-12 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center mb-5 text-purple-400">
          <Icon name="cpu" class="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold text-white mb-2">Lossless Integrity</h3>
        <p class="text-sm text-zinc-400 leading-relaxed font-normal">
          We never recompress, re-encode, or alter your photo pixels. We directly write standard EXIF, IPTC, and QuickTime headers into file metadata segments with bit-for-bit preservation.
        </p>
      </div>

      <div class="bg-zinc-950/40 border border-white/10 rounded-2xl p-6 backdrop-blur-md relative overflow-hidden group hover:border-pink-500/30 transition-all">
        <div class="w-12 h-12 rounded-xl bg-pink-500/10 border border-pink-500/20 flex items-center justify-center mb-5 text-pink-400">
          <Icon name="zap" class="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold text-white mb-2">Multi-Platform Reach</h3>
        <p class="text-sm text-zinc-400 leading-relaxed font-normal">
          Whether you prefer our zero-install web application or high-throughput standalone desktop utilities for Windows and macOS, we offer tools for libraries of any scale.
        </p>
      </div>

    </div>

    <!-- The Problem We Solve (In-Depth Technical Story) -->
    <div class="bg-zinc-950/60 border border-white/10 rounded-3xl p-8 sm:p-12 mb-16 backdrop-blur-xl">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-6">
        Why Was TakeoutFix Built?
      </h2>
      <div class="space-y-5 text-zinc-300 text-base leading-relaxed font-normal">
        <p>
          Google Takeout is the primary tool Google provides for users exercising their data portability rights to export their stored Google Photos archives. However, instead of baking the capture timestamps, geolocation data, and camera settings directly into each media file's EXIF header, Google separates this crucial information into companion files ending in <code class="text-indigo-300 bg-indigo-950/60 px-2 py-0.5 rounded font-mono text-sm">.json</code>.
        </p>
        <p>
          When you subsequently attempt to import these photos into Apple Photos, Synology Photos, Windows Photo Gallery, or Lightroom, these programs cannot read Google's proprietary JSON sidecars. As a consequence, thousands of irreplaceable family memories appear scrambled, all sharing the date you downloaded the zip archive instead of the year they were captured.
        </p>
        <p>
          Traditional solutions required running complex Python scripts or terminal tools like ExifTool, which are intimidating and inaccessible for everyday users. TakeoutFix was engineered to provide an accessible, beautiful, and completely secure solution: a high-performance metadata restorer that runs right in your browser with no cloud uploads required.
        </p>
      </div>
    </div>

    <!-- Meet the Creator & Engineering Standards -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16 items-center">
      
      <div class="lg:col-span-5 bg-gradient-to-br from-indigo-950/30 via-zinc-950 to-purple-950/30 border border-white/10 rounded-3xl p-8 text-center sm:text-left">
        <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white text-2xl font-bold mx-auto sm:mx-0 mb-6 shadow-lg shadow-indigo-500/20">
          RJ
        </div>
        <h3 class="text-2xl font-bold text-white mb-1">Rahul Jena</h3>
        <p class="text-indigo-400 font-mono text-xs font-semibold mb-4">Founder & Lead Software Engineer</p>
        <p class="text-sm text-zinc-450 leading-relaxed font-normal mb-6">
          A software engineer specializing in systems architecture, web technologies, and multimedia processing. Creator of the open-source GooglePhotosTakeout toolkit and the TakeoutFix client engine.
        </p>
        <div class="flex flex-wrap gap-3 justify-center sm:justify-start">
          <a 
            href="https://github.com/Rahul-Jena-2002" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-semibold text-white transition-all"
          >
            GitHub Profile
          </a>
          <a 
            href="https://github.com/sponsors/Rahul-Jena-2002" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-pink-500/10 hover:bg-pink-500/20 border border-pink-500/30 text-xs font-semibold text-pink-400 transition-all"
          >
            Sponsor on GitHub
          </a>
        </div>
      </div>

      <div class="lg:col-span-7 space-y-6">
        <h3 class="text-2xl font-bold text-white">Our Engineering & Quality Standards</h3>
        <ul class="space-y-4 text-sm text-zinc-300 font-normal">
          <li class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 flex-shrink-0 mt-0.5">
              <Icon name="check" class="w-3.5 h-3.5" />
            </div>
            <span>
              <strong class="text-white">Extensive Format Testing:</strong> Our algorithms are rigorously verified across JPEG, PNG, WebP, Apple HEIC/HEIF, Canon CR2/CR3, Nikon NEF, Sony ARW, and MP4/MOV QuickTime files.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 flex-shrink-0 mt-0.5">
              <Icon name="check" class="w-3.5 h-3.5" />
            </div>
            <span>
              <strong class="text-white">Edge Case Handling:</strong> We handle real-world Takeout anomalies including truncated JSON filenames (e.g., <code>IMG_1234(1).JPG</code> vs <code>IMG_1234.JPG(1).json</code>), edited suffixes, and timezone offsets.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 flex-shrink-0 mt-0.5">
              <Icon name="check" class="w-3.5 h-3.5" />
            </div>
            <span>
              <strong class="text-white">Zero Telemetry of Personal Data:</strong> We never log, track, or collect file names, photo thumbnails, or EXIF metadata. Our servers only handle operational metrics and licensing.
            </span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Legal Transparency & Trademark Disclosure -->
    <div class="border border-white/10 rounded-2xl p-6 sm:p-8 bg-zinc-900/30 text-xs text-zinc-450 leading-relaxed font-normal">
      <h4 class="text-sm font-bold text-white mb-2 uppercase tracking-wider">Independent Organization Disclosure</h4>
      <p class="mb-3">
        Google Takeout™ and Google Photos™ are registered trademarks of Google LLC. Apple Photos™ and iCloud™ are registered trademarks of Apple Inc. 
        TakeoutFix is an independent utility software project and is <strong>not affiliated with, endorsed by, sponsored by, or associated with Google LLC or Apple Inc.</strong>
      </p>
      <p>
        For inquiries, press, or technical questions, please visit our <a href="/contact" class="text-indigo-400 hover:underline">Contact Page</a> or review our <a href="/disclaimer" class="text-indigo-400 hover:underline">Full Legal Disclaimer</a>.
      </p>
    </div>

  </div>
</Layout>
