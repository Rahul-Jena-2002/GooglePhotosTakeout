---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Icon from "../components/ui/Icon.astro";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "TakeoutFix",
  "url": "https://takeoutfix.pages.dev",
  "logo": "https://takeoutfix.pages.dev/favicon-192x192.png",
  "founder": {
    "@type": "Person",
    "name": "Rahul Jena",
    "url": "https://rahuljena.is-a.dev/"
  },
  "description": "Independent software utility provider specializing in privacy-first, client-side metadata restoration and multimedia file organization for Google Takeout photo archives."
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About TakeoutFix",
  "description": "Learn about TakeoutFix, an independent browser tool for restoring available photo metadata from Google Takeout exports.",
  "url": "https://takeoutfix.pages.dev/about",
  "mainEntity": organizationSchema
};
---

<Layout 
  title="About Us – The Mission & Team Behind TakeoutFix" 
description="Learn about TakeoutFix, its local-first approach, available restore features, and the independent project maintainer."
>
  <!-- Schema.org JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mt-12 font-sans">
    
    <!-- Hero Section -->
    <div class="text-center mb-16 relative">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-900 dark:text-zinc-100 text-xs font-semibold uppercase tracking-wider mb-6 font-mono">
        <Icon name="info" class="w-4 h-4 text-zinc-900 dark:text-zinc-100" />
        About TakeoutFix
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-zinc-900 dark:text-white mb-6 leading-tight">
        Keep your photo memories in order <br class="hidden sm:inline" />
        <span class="text-zinc-500 dark:text-zinc-400">with TakeoutFix</span>
      </h1>
      <p class="text-base sm:text-lg md:text-xl text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed font-normal">
        Some photos downloaded from Google Takeout may show the wrong date or be missing a location in another photo app. TakeoutFix helps restore the details available in your download. Your selected photos stay on your device while the tool works.
      </p>
    </div>

    <!-- Core Philosophy Bento Grid (3 Cards Full-Width) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      
      <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 hover:border-zinc-400 dark:hover:border-zinc-600 transition-all flex flex-col shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center mb-6 text-zinc-900 dark:text-white">
          <Icon name="shield-check" class="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-3">Your photos stay on your device</h3>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal">
          The restore tool works in your browser. The photos you select are not uploaded to our servers.
        </p>
      </div>

      <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 hover:border-zinc-400 dark:hover:border-zinc-600 transition-all flex flex-col shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center mb-6 text-zinc-900 dark:text-white">
          <Icon name="cpu" class="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-3">The picture stays the same</h3>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal">
          TakeoutFix updates supported photo details without changing how the picture looks. Keep a copy of your original download before you begin.
        </p>
      </div>

      <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 hover:border-zinc-400 dark:hover:border-zinc-600 transition-all flex flex-col shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center mb-6 text-zinc-900 dark:text-white">
          <Icon name="zap" class="w-6 h-6" />
        </div>
        <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-3">Choose how to restore</h3>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal">
          Use the browser tool for everyday restores. A desktop app is available for people who prefer a separate application.
        </p>
      </div>

    </div>

    <!-- The problem TakeoutFix solves -->
    <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 sm:p-12 mb-16 shadow-sm">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-white mb-6">
        Why Was TakeoutFix Built?
      </h2>
      <div class="space-y-6 text-zinc-700 dark:text-zinc-300 text-sm sm:text-base leading-relaxed font-normal">
        <p>
          Google Takeout lets you download a copy of your Google Photos. Some extra details, such as comments, may be saved in separate files ending in <code class="text-xs font-mono px-2 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 border border-zinc-300 dark:border-zinc-700">.json</code>. These are text files that can hold information about a photo.
        </p>
        <p>
          Some photo apps do not use those extra files when importing photos. As a result, a photo may show the download date instead of the day it was taken. The exact result depends on the files in your download and the app you use.
        </p>
        <p>
          TakeoutFix was made to make this process easier. Choose your Takeout folder, select where to save the restored copies, and review the results. The selected photos are handled on your device.
        </p>
      </div>
    </div>

    <!-- Meet the Creator & Engineering Standards (12-Column Grid) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-16 items-start">
      
      <div class="lg:col-span-5 bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 text-center sm:text-left shadow-sm">
        <div class="w-16 h-16 rounded-2xl bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 flex items-center justify-center text-xl font-bold mx-auto sm:mx-0 mb-6 shadow-sm">
          RJ
        </div>
        <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mb-1">Rahul Jena</h3>
        <p class="text-zinc-500 dark:text-zinc-400 font-mono text-xs font-semibold mb-4">Founder &amp; Software Engineer</p>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal mb-6">
          I created TakeoutFix to make it easier to inspect Google Takeout exports and restore supported metadata locally in a browser. The project is independently maintained; questions and corrections are welcome through the support page.
        </p>
        <div class="flex flex-wrap gap-3 justify-center sm:justify-start">
          <a 
            href="/contact" 
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white dark:bg-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 text-xs font-semibold text-zinc-900 dark:text-white transition-all shadow-sm"
          >
            Get in Touch
          </a>
          <a 
            href="/guides" 
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 border border-zinc-200 dark:border-zinc-700 text-xs font-semibold text-zinc-900 dark:text-white transition-all"
          >
            Helpful Guides
          </a>
        </div>
      </div>

      <div class="lg:col-span-7 bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 sm:p-10 space-y-6 shadow-sm">
        <h3 class="text-2xl font-bold text-zinc-900 dark:text-white">What to expect</h3>
        <ul class="space-y-5 text-sm text-zinc-600 dark:text-zinc-400 font-normal">
          <li class="flex items-start gap-4">
            <div class="w-7 h-7 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 flex-shrink-0 mt-0.5">
              <Icon name="check" class="w-4 h-4" />
            </div>
            <span>
              <strong class="text-zinc-900 dark:text-white">Supported files:</strong> The tool works with selected photo and video formats. Check the restore guide for the current supported file list.
            </span>
          </li>
          <li class="flex items-start gap-4">
            <div class="w-7 h-7 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 flex-shrink-0 mt-0.5">
              <Icon name="check" class="w-4 h-4" />
            </div>
            <span>
              <strong class="text-zinc-900 dark:text-white">Check the results:</strong> File names and available details can vary. Try a few photos first and review the report before restoring a large folder.
            </span>
          </li>
          <li class="flex items-start gap-4">
            <div class="w-7 h-7 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 flex-shrink-0 mt-0.5">
              <Icon name="check" class="w-4 h-4" />
            </div>
            <span>
              <strong class="text-zinc-900 dark:text-white">Private photo processing:</strong> The browser restore tool does not upload the selected photo or video files. Account and website information is explained in our <a href="/privacy" class="underline font-semibold">Privacy Policy</a>.
            </span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Legal Transparency & Trademark Disclosure -->
    <div class="border border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 bg-zinc-50/50 dark:bg-zinc-900/30 text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed font-normal">
      <h4 class="text-xs font-bold text-zinc-900 dark:text-white mb-2 uppercase tracking-wider">Independent Organization Disclosure</h4>
      <p class="mb-3">
        Google Takeout™ and Google Photos™ are registered trademarks of Google LLC. Apple Photos™ and iCloud™ are registered trademarks of Apple Inc. 
        TakeoutFix is an independent utility software project and is <strong>not affiliated with, endorsed by, sponsored by, or associated with Google LLC or Apple Inc.</strong>
      </p>
      <p>
        For inquiries, press, or technical questions, please visit our <a href="/contact" class="text-zinc-900 dark:text-white hover:underline font-semibold">Contact Page</a> or review our <a href="/disclaimer" class="text-zinc-900 dark:text-white hover:underline font-semibold">Full Legal Disclaimer</a>.
      </p>
    </div>

  </div>
</Layout>
