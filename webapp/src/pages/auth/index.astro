---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import DesktopAuthBridge from "../../react-pages/auth/DesktopAuthBridge";
---

<Layout 
  title="TakeoutFix Desktop Authentication Bridge" 
  description="Authenticate TakeoutFix Desktop App with your Google account."
  isAuthPage={true}
>
  <DesktopAuthBridge client:only="react">
    <div slot="fallback" class="min-h-[85vh] flex items-center justify-center p-4 md:p-8 font-sans">
      <div class="w-full max-w-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#12131a] shadow-2xl rounded-2xl p-6 pb-8 text-center animate-pulse space-y-6">
        <div class="w-14 h-14 mx-auto rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800"></div>
        <div class="space-y-2">
          <div class="h-6 w-48 mx-auto rounded-lg bg-zinc-200 dark:bg-zinc-800"></div>
          <div class="h-4 w-60 mx-auto rounded-md bg-zinc-200 dark:bg-zinc-800"></div>
        </div>
        <div class="h-20 rounded-xl bg-zinc-100 dark:bg-zinc-900"></div>
        <div class="h-12 rounded-xl bg-zinc-200 dark:bg-zinc-800"></div>
      </div>
    </div>
  </DesktopAuthBridge>
</Layout>
