---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import ProfilePage from "../react-pages/user/ProfilePage";
---

<Layout title="TakeoutFix | Profile Settings" description="Update your TakeoutFix username, first name, last name, and account details.">
  <ProfilePage client:only="react">
    <div slot="fallback" class="min-h-[70vh] max-w-3xl mx-auto px-6 py-16 animate-pulse space-y-8">
      <div class="space-y-3">
        <div class="h-4 w-24 rounded-full bg-zinc-200 dark:bg-zinc-800"></div>
        <div class="h-10 w-48 rounded-xl bg-zinc-200 dark:bg-zinc-800"></div>
      </div>
      <div class="space-y-4 pt-4">
        <div class="h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800"></div>
        <div class="h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800"></div>
        <div class="h-14 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800"></div>
      </div>
    </div>
  </ProfilePage>
</Layout>
