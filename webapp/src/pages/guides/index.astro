---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/ui/Icon.astro";

const guides = [
  {
    slug: "google-takeout-json-metadata-explained",
    title: "Why Google Takeout Has Separate Photo Details Files",
    description: "Learn what the extra .json files are for, how to match one to a photo, and what to check before restoring dates or locations.",
    category: "Photo dates and details",
    badgeColor: "text-indigo-400 bg-indigo-500/10 border-indigo-500/20",
    readTime: "About 6 min",
    updatedAt: "2026-10-14",
    icon: "cpu"
  },
  {
    slug: "how-to-save-takeout-photos-to-hard-drive-nas-cloud",
    title: "Save Your Google Takeout Photos Safely",
    description: "Unpack your download, try a small group of photos, and make a second copy before moving your full library.",
    category: "Keep a safe backup",
    badgeColor: "text-emerald-400 bg-emerald-500/10 border-emerald-500/20",
    readTime: "About 6 min",
    updatedAt: "2026-10-14",
    icon: "hard-drive"
  },
  {
    slug: "google-takeout-common-errors-fix",
    title: "Fix Common Google Takeout Photo Problems",
    description: "Find missing or mismatched files, check dates and locations, and protect your original download while you troubleshoot.",
    category: "Troubleshooting",
    badgeColor: "text-amber-400 bg-amber-500/10 border-amber-500/20",
    readTime: "About 5 min",
    updatedAt: "2026-10-14",
    icon: "alert-triangle"
  },
  {
    slug: "../restore-data",
    title: "Restore Photo Dates and Locations",
    description: "Follow a simple walkthrough, check which files are supported, and review a small sample before restoring everything.",
    category: "Step-by-step walkthrough",
    badgeColor: "text-purple-400 bg-purple-500/10 border-purple-500/20",
    readTime: "Tool walkthrough",
    updatedAt: "2026-09-28",
    icon: "shield-check"
  }
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "TakeoutFix Guides",
  "description": "Simple guides for downloading, checking, restoring, and safely storing Google Photos Takeout files.",
  "url": "https://takeoutfix.pages.dev/guides",
  "publisher": {
    "@type": "Organization",
    "name": "TakeoutFix",
    "url": "https://takeoutfix.pages.dev"
  }
};
---

<Layout 
  title="Simple Google Takeout Photo Guides | TakeoutFix"
  description="Plain-language help for Google Takeout photo dates, missing locations, common download problems, and keeping a safe backup."
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mt-12 font-sans">
    
    <!-- Hero Header -->
    <div class="text-center mb-16 relative">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-6 font-mono">
        <Icon name="book-open" class="w-4 h-4" />
        Helpful Guides
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-zinc-900 dark:text-white mb-6 leading-tight">
        Google Takeout photo help <br class="hidden sm:inline" />
        <span class="text-zinc-900 dark:text-white">
          in plain language
        </span>
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed font-normal">
        Find out why photo dates can look wrong after a download, how to check the extra files in your folder, and how to keep your original photos safe.
      </p>
    </div>

    <!-- Guides Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      {guides.map((guide) => (
        <a 
          href={guide.slug.startsWith("../") ? guide.slug.replace("../", "/") : `/guides/${guide.slug}`}
          class="group bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-7 sm:p-8 flex flex-col justify-between hover:border-indigo-500/40 hover:bg-zinc-100 dark:hover:bg-zinc-900/80 transition-all duration-200 shadow-sm"
        >
          <div>
            <div class="flex items-center justify-between gap-3 mb-4">
              <span class={`text-[11px] font-mono font-semibold px-2.5 py-1 rounded-full border ${guide.badgeColor}`}>
                {guide.category}
              </span>
              <span class="text-xs text-zinc-500 font-mono">
                {guide.readTime}
              </span>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors mb-3 leading-snug">
              {guide.title}
            </h2>

            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal mb-6">
              {guide.description}
            </p>
          </div>

          <div class="pt-4 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-between text-xs text-zinc-500">
            <span>Updated {guide.updatedAt}</span>
            <span class="text-indigo-600 dark:text-indigo-400 font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Read Guide &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Start with the problem that matches your export -->
    <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-8 sm:p-12 mb-16">
      <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mb-2">Choose the next step for your archive</h3>
      <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-6">Start with the checks that match what you see. Keep your original export unchanged while you investigate.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/guides/google-takeout-json-metadata-explained#anatomy-schema" class="p-4 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-indigo-500/40 transition-colors shadow-sm">
          <div class="text-sm font-bold text-indigo-600 dark:text-indigo-400 mb-1">Check an extra details file</div>
          <p class="text-xs text-zinc-600 dark:text-zinc-400">See whether its name matches the photo and whether it contains a date or location.</p>
        </a>
        <a href="/guides/google-takeout-common-errors-fix#problem-1" class="p-4 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-amber-500/40 transition-colors shadow-sm">
          <div class="text-sm font-bold text-amber-600 dark:text-amber-400 mb-1">Find a mismatched file</div>
          <p class="text-xs text-zinc-600 dark:text-zinc-400">Check filename variants and neighboring files before deciding a sidecar is missing.</p>
        </a>
        <a href="/guides/how-to-save-takeout-photos-to-hard-drive-nas-cloud#step-2" class="p-4 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500/40 transition-colors shadow-sm">
          <div class="text-sm font-bold text-emerald-600 dark:text-emerald-400 mb-1">Try a few photos first</div>
          <p class="text-xs text-zinc-600 dark:text-zinc-400">Check the results and keep your original download safe before restoring the whole library.</p>
        </a>
        <a href="/restore-data" class="p-4 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-purple-500/40 transition-colors shadow-sm">
          <div class="text-sm font-bold text-purple-600 dark:text-purple-400 mb-1">Follow the restore walkthrough</div>
          <p class="text-xs text-zinc-600 dark:text-zinc-400">See how to choose your files, save the results, and check that everything looks right.</p>
        </a>
      </div>
    </div>

    <!-- Author & Trust Box -->
    <div class="border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 sm:p-8 bg-zinc-50/50 dark:bg-zinc-900/30 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h4 class="text-sm font-bold text-zinc-900 dark:text-white mb-1">Maintained by the TakeoutFix creator</h4>
        <p>
          TakeoutFix is an independent project maintained by Rahul Jena. Guide updates should reflect the current product behavior; report unclear or outdated steps through the support page.
        </p>
      </div>
      <a href="/contact" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs transition-all whitespace-nowrap shadow-sm">
        Report a guide issue
      </a>
    </div>

  </div>
</Layout>
