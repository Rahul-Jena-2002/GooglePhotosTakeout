---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/ui/Icon.astro";

const guides = [
  {
    slug: "google-takeout-json-metadata-explained",
    title: "Google Takeout JSON Sidecars: The Definitive Technical Guide",
    description: "Deep dive into why Google Takeout separates metadata into JSON files, how photoTakenTime and geoData are formatted, and how EXIF headers are reconstructed.",
    category: "Technical Architecture",
    badgeColor: "text-indigo-400 bg-indigo-500/10 border-indigo-500/20",
    readTime: "9 min read",
    updatedAt: "2026-09-28",
    icon: "cpu"
  },
  {
    slug: "how-to-save-takeout-photos-to-hard-drive-nas-cloud",
    title: "How to Save Google Takeout Photos to External Hard Drive, NAS & Cloud",
    description: "Complete workflow for storing restored Google Takeout libraries on USB drives, external SSDs, Synology/TrueNAS home servers, Apple iCloud, and OneDrive.",
    category: "Storage & Backup",
    badgeColor: "text-emerald-400 bg-emerald-500/10 border-emerald-500/20",
    readTime: "11 min read",
    updatedAt: "2026-09-28",
    icon: "hard-drive"
  },
  {
    slug: "google-takeout-common-errors-fix",
    title: "Troubleshooting Common Google Takeout Errors & Metadata Failures",
    description: "How to fix truncated filenames, missing GPS coordinates in shared albums, timezone shifts (UTC vs local), and 2GB/50GB split ZIP archive extraction issues.",
    category: "Troubleshooting",
    badgeColor: "text-amber-400 bg-amber-500/10 border-amber-500/20",
    readTime: "10 min read",
    updatedAt: "2026-09-28",
    icon: "alert-triangle"
  },
  {
    slug: "../restore-data",
    title: "The Master Guide: Restore Google Photos Dates & Metadata",
    description: "Comprehensive step-by-step documentation for matching companion JSON sidecars and restoring EXIF dates, camera models, and GPS tags locally in your browser.",
    category: "Pillar Documentation",
    badgeColor: "text-purple-400 bg-purple-500/10 border-purple-500/20",
    readTime: "14 min read",
    updatedAt: "2026-09-28",
    icon: "shield-check"
  }
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "TakeoutFix Knowledge Base & Educational Guides",
  "description": "In-depth technical guides, tutorials, and troubleshooting manuals for Google Takeout exports, EXIF metadata restoration, and digital photo library preservation.",
  "url": "https://takeoutfix.pages.dev/guides",
  "publisher": {
    "@type": "Organization",
    "name": "TakeoutFix",
    "url": "https://takeoutfix.pages.dev"
  }
};
---

<Layout 
  title="Google Takeout Knowledge Base & Educational Guides | TakeoutFix" 
  description="Explore authoritative technical guides, troubleshooting tutorials, and step-by-step walkthroughs for fixing Google Takeout photo dates, JSON sidecars, and GPS metadata."
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mt-12 font-sans">
    
    <!-- Hero Header -->
    <div class="text-center mb-16 relative">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-6 font-mono">
        <Icon name="book-open" class="w-4 h-4" />
        Educational Knowledge Base
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-zinc-900 dark:text-white mb-6 leading-tight">
        Mastering Google Takeout <br class="hidden sm:inline" />
        <span class="text-indigo-600 dark:text-indigo-400">
          Metadata &amp; Data Portability
        </span>
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed font-normal">
        Authoritative, peer-reviewed engineering guides to help you understand Google Takeout archives, resolve missing photo dates, and preserve your family memories with 100% privacy.
      </p>
    </div>

    <!-- Guides Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      {guides.map((guide) => (
        <a 
          href={guide.slug.startsWith("../") ? guide.slug.replace("../", "/") : `/guides/${guide.slug}`}
          class="group bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-7 sm:p-8 flex flex-col justify-between hover:border-indigo-500/40 hover:bg-zinc-100 dark:hover:bg-zinc-900/80 transition-all duration-200 shadow-sm"
        >
          <div>
            <div class="flex items-center justify-between gap-3 mb-4">
              <span class={`text-[11px] font-mono font-semibold px-2.5 py-1 rounded-full border ${guide.badgeColor}`}>
                {guide.category}
              </span>
              <span class="text-xs text-zinc-500 font-mono">
                {guide.readTime}
              </span>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors mb-3 leading-snug">
              {guide.title}
            </h2>

            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal mb-6">
              {guide.description}
            </p>
          </div>

          <div class="pt-4 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-between text-xs text-zinc-500">
            <span>Updated {guide.updatedAt}</span>
            <span class="text-indigo-600 dark:text-indigo-400 font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Read Guide &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Additional Learning Topics Bento -->
    <div class="bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-8 sm:p-12 mb-16">
      <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6">Explore Specific Problem Solvers</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/fix-google-takeout-dates" class="p-4 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-indigo-500/40 transition-colors shadow-sm">
          <div class="text-sm font-bold text-indigo-600 dark:text-indigo-400 mb-1">Fix Wrong Dates</div>
          <p class="text-xs text-zinc-600 dark:text-zinc-400">Why your photos display today's extraction date and how to fix it.</p>
        </a>
        <a href="/restore-gps-google-takeout" class="p-4 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-indigo-500/40 transition-colors shadow-sm">
          <div class="text-sm font-bold text-indigo-600 dark:text-indigo-400 mb-1">Restore GPS Coordinates</div>
          <p class="text-xs text-zinc-600 dark:text-zinc-400">Re-inject latitude, longitude, and altitude tags into EXIF segments.</p>
        </a>
        <a href="/google-takeout-to-apple-photos" class="p-4 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-indigo-500/40 transition-colors shadow-sm">
          <div class="text-sm font-bold text-indigo-600 dark:text-indigo-400 mb-1">Apple Photos Migration</div>
          <p class="text-xs text-zinc-600 dark:text-zinc-400">Prepare your archive so iCloud sorts photos chronologically.</p>
        </a>
        <a href="/google-takeout-merger" class="p-4 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-indigo-500/40 transition-colors shadow-sm">
          <div class="text-sm font-bold text-indigo-600 dark:text-indigo-400 mb-1">Merge JSON Sidecars</div>
          <p class="text-xs text-zinc-600 dark:text-zinc-400">Reunite detached sidecars with raw media files seamlessly.</p>
        </a>
      </div>
    </div>

    <!-- Author & Trust Box -->
    <div class="border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 sm:p-8 bg-zinc-50/50 dark:bg-zinc-900/30 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h4 class="text-sm font-bold text-zinc-900 dark:text-white mb-1">Maintained by TakeoutFix Engineering</h4>
        <p>
          Written and maintained by software engineers specializing in digital preservation and client-side processing. All tools execute locally on your device.
        </p>
      </div>
      <a href="/tool" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs transition-all whitespace-nowrap shadow-sm">
        Open Restore Tool
      </a>
    </div>

  </div>
</Layout>
