---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import ToolWorkspace from "../react-pages/tool/ToolWorkspace";
import Icon from "../components/ui/Icon.astro";
import AdUnit from "../components/monetization/AdUnit";

// Structured Schema.org data for SEO and AdSense crawler trust
const toolFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What should I do after TakeoutFix finishes restoring my files?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Once TakeoutFix finishes repairing your library, open your selected destination folder. To make Windows File Explorer or Mac Finder display original capture dates in file lists, double-click the generated sync_windows_dates.bat (Windows) or execute sync_macos_linux.sh (Mac/Linux)."
      }
    },
    {
      "@type": "Question",
      "name": "Why do restored files show today's date in Windows Explorer or Mac Finder?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Web browsers run in a secure sandbox that permits binary EXIF header injection into the image itself, but forbids modifying operating system filesystem attributes (CreationTime and LastWriteTime). Running the companion sync_windows_dates.bat or sync_macos_linux.sh script updates the OS filesystem attributes to match the embedded EXIF capture date in 2 to 3 seconds."
      }
    },
    {
      "@type": "Question",
      "name": "What does sync_windows_dates.bat do?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The sync_windows_dates.bat script reads the generated file_timestamps.json catalog and executes a localized PowerShell routine to update Windows filesystem CreationTime and LastWriteTime on every restored photo and video, so File Explorer sorts them chronologically."
      }
    },
    {
      "@type": "Question",
      "name": "Does the web tool compress or reduce photo resolution?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. TakeoutFix performs lossless binary metadata injection. Only the EXIF, XMP, and QuickTime header blocks are updated. Your underlying JPEG, HEIC, PNG, or video bitstreams remain 100% bit-for-bit identical to the originals."
      }
    },
    {
      "@type": "Question",
      "name": "Are my photos uploaded to any server while using the tool?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Processing occurs 100% locally on your computer inside client-side Web Workers using the File System Access API. Your files and photos never leave your device."
      }
    }
  ]
};
---

<Layout 
  title="Google Takeout Photos Metadata Fixer & Merger Online | TakeoutFix"
  description="Restore dates and locations for photos from a Google Takeout download. Choose your files, select where to save the restored copies, and run the tool on your device."
  isToolPage={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(toolFaqSchema)} />

  <!-- 1. INTERACTIVE TOOL WORKSPACE (UNMODIFIED UI) -->
  <div id="tool-workspace">
  <ToolWorkspace client:only="react">
    <section slot="fallback" class="w-full bg-background text-foreground">
      <div class="max-w-7xl mx-auto px-6 py-16 sm:py-20">
        <div class="max-w-3xl">
          <p class="inline-flex items-center rounded-full border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900 px-3 py-1 text-xs font-bold uppercase tracking-wider text-zinc-800 dark:text-zinc-100">
            Google Photos Metadata Restorer
          </p>
          <h1 class="mt-6 text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-foreground leading-tight">
            Restore your Takeout photos.
          </h1>
          <p class="mt-5 max-w-2xl text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Choose your Google Takeout files to restore their original dates and locations. Your photos are processed locally in your browser.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href="#tool-workspace" class="btn-monochrome-primary inline-flex h-14 items-center rounded-lg px-8 font-bold">Open Restore Tool</a>
            <span class="text-sm font-semibold text-zinc-600 dark:text-zinc-400">Free to use · No upload required</span>
          </div>
        </div>
      </div>
    </section>
  </ToolWorkspace>
  </div>

  <!-- Responsive ad placement managed by the existing monetization settings. -->
  <section class="w-full max-w-5xl mx-auto px-4 py-3 relative z-10" aria-label="Sponsored recommendations">
    <div class="tool-ad-slot">
      <AdUnit client:only="react" placement="TOOL_MANUAL_TOP" />
      <div class="tool-ad-placeholder" aria-label="Advertisement slot">
        <span>ADVERTISEMENT</span>
        <span>Ad space · ads appear when available</span>
      </div>
    </div>
  </section>

  <style>
    .tool-ad-slot { position: relative; min-height: 72px; }
    .tool-ad-placeholder {
      min-height: 72px; border: 1px dashed rgb(212 212 216); border-radius: .75rem;
      background: rgb(250 250 250 / .8); display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: .25rem; color: rgb(113 113 122);
      font-size: 11px; text-align: center;
    }
    .tool-ad-placeholder span:first-child { font-size: 9px; font-weight: 700; letter-spacing: .08em; }
    .dark .tool-ad-placeholder { border-color: rgb(63 63 70); background: rgb(24 24 27 / .5); color: rgb(161 161 170); }
    .tool-ad-slot:has(iframe, a[href], ins[data-ad-status="filled"]) .tool-ad-placeholder { display: none; }
  </style>

  <!-- 2. SCROLLABLE USER MANUAL & POST-RESTORATION GUIDE (BELOW WORKSPACE) -->
  <div class="w-full bg-zinc-50 dark:bg-zinc-950 border-t border-zinc-200 dark:border-zinc-800/80 text-zinc-700 dark:text-zinc-300 font-sans relative z-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      
      <!-- Section Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 text-xs font-semibold uppercase tracking-wider mb-4 font-mono">
          <Icon name="file-text" class="w-4 h-4" />
          <span>Tool User Manual &amp; Instructions</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white tracking-tight mb-3">
          How to Use the TakeoutFix Restore Tool
        </h2>
        <p class="text-base text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed">
          Choose your Takeout files, restore photo dates and locations, then save the finished copies.
        </p>
      </div>

      <!-- Quick Jump Navigation Strip -->
      <div class="flex flex-wrap items-center justify-center gap-2 pb-10 mb-12 border-b border-zinc-200 dark:border-zinc-800 text-xs">
        <a href="#post-restoration" class="px-3 py-1.5 rounded-lg bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white transition-colors border border-zinc-200 dark:border-zinc-800 shadow-sm">
          ⚡ After the restore
        </a>
        <a href="#how-it-works" class="px-3 py-1.5 rounded-lg bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white transition-colors border border-zinc-200 dark:border-zinc-800 shadow-sm">
          🔍 How Metadata Pairing Works
        </a>
        <a href="#supported-formats" class="px-3 py-1.5 rounded-lg bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white transition-colors border border-zinc-200 dark:border-zinc-800 shadow-sm">
          📁 File types
        </a>
        <a href="#privacy-architecture" class="px-3 py-1.5 rounded-lg bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white transition-colors border border-zinc-200 dark:border-zinc-800 shadow-sm">
          🔒 Privacy &amp; Offline Guarantee
        </a>
        <a href="#tool-faq" class="px-3 py-1.5 rounded-lg bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white transition-colors border border-zinc-200 dark:border-zinc-800 shadow-sm">
          ❓ Frequently Asked Questions
        </a>
      </div>

      <!-- ========================================================================= -->
      <!-- CRUCIAL SECTION: WHAT TO DO AFTER INJECTING (THE BAT / SH SCRIPTS)         -->
      <!-- ========================================================================= -->
      <section id="post-restoration" class="mb-16 scroll-mt-20">
        <div class="p-6 sm:p-8 rounded-2xl bg-gradient-to-b from-white to-zinc-50 dark:from-zinc-900 dark:to-zinc-900/60 border border-emerald-500/30 shadow-sm relative overflow-hidden">
          
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
              <Icon name="check-circle-2" class="w-5 h-5" />
            </div>
            <div>
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">After the restore</span>
              <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white">What to do after clicking "Start Restore"</h3>
            </div>
          </div>

          <div class="space-y-6 text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed">
            <p>
              When TakeoutFix finishes restoring your photos, it writes all your repaired media into your designated output folder. However, you will notice that in <strong>Windows File Explorer</strong> or <strong>Mac Finder</strong>, the files might still show today's date in the folder column.
            </p>

            <!-- Explanation Callout -->
            <div class="p-4 rounded-xl bg-zinc-100 dark:bg-black/50 border border-zinc-200 dark:border-zinc-800 text-xs space-y-2">
              <div class="font-bold text-zinc-900 dark:text-white flex items-center gap-2">
                <span>💡 Why does File Explorer / Finder show today's date?</span>
              </div>
              <p class="text-zinc-600 dark:text-zinc-400">
                Your browser can restore the date and location stored inside each photo. It cannot change the separate “Date created” value shown by your computer's file manager.
              </p>
              <p class="text-zinc-600 dark:text-zinc-400">
                Photo apps such as <strong>Apple Photos, Google Photos, and Lightroom</strong> use the restored photo date. If you also want to change the date shown in your computer's folders, the tool provides an optional helper script. Review it before running it.
              </p>
            </div>

            <!-- What the Script Does -->
            <div class="grid md:grid-cols-2 gap-4 pt-2">
              
              <!-- Windows .bat Card -->
              <div class="p-5 rounded-xl bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 shadow-sm flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between mb-3">
                    <span class="font-mono text-xs font-bold text-emerald-600 dark:text-emerald-400 px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20">
                      sync_windows_dates.bat
                    </span>
                    <span class="text-[11px] font-mono text-zinc-500">Windows Users</span>
                  </div>
                  <h4 class="font-bold text-zinc-900 dark:text-white mb-2 text-sm">How to run on Windows:</h4>
                  <ol class="list-decimal list-inside space-y-2 text-xs text-zinc-600 dark:text-zinc-400">
                    <li>Open your restored output folder in File Explorer.</li>
                    <li>Look for the generated file named <code class="text-zinc-900 dark:text-white font-mono bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 px-1 py-0.5 rounded">sync_windows_dates.bat</code>.</li>
                    <li>Double-click the file to run it.</li>
                    <li>A command window will scan your folder and update Windows <code class="text-zinc-800 dark:text-zinc-300 font-mono">CreationTime</code> and <code class="text-zinc-800 dark:text-zinc-300 font-mono">LastWriteTime</code> to match your photos' exact original dates in 2 to 3 seconds.</li>
                  </ol>
                </div>
                <div class="mt-4 pt-3 border-t border-zinc-200 dark:border-zinc-800 text-[11px] text-zinc-500">
                  ✓ Safe, self-contained local PowerShell routine. No internet required.
                </div>
              </div>

              <!-- Mac/Linux .sh Card -->
              <div class="p-5 rounded-xl bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 shadow-sm flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between mb-3">
                    <span class="font-mono text-xs font-bold text-blue-600 dark:text-blue-400 px-2 py-0.5 rounded bg-blue-500/10 border border-blue-500/20">
                      sync_macos_linux.sh
                    </span>
                    <span class="text-[11px] font-mono text-zinc-500">Mac &amp; Linux Users</span>
                  </div>
                  <h4 class="font-bold text-zinc-900 dark:text-white mb-2 text-sm">How to run on macOS / Linux:</h4>
                  <ol class="list-decimal list-inside space-y-2 text-xs text-zinc-600 dark:text-zinc-400">
                    <li>Open your restored output folder in Finder.</li>
                    <li>Open <strong>Terminal</strong> (<kbd class="px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-[10px] text-zinc-700 dark:text-zinc-300">Cmd + Space</kbd> &rarr; Terminal).</li>
                    <li>Type <code class="text-zinc-900 dark:text-white font-mono bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 px-1 py-0.5 rounded">bash </code>, drag the <code class="text-zinc-900 dark:text-white font-mono bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 px-1 py-0.5 rounded">sync_macos_linux.sh</code> file into Terminal, and press Enter.</li>
                    <li>The script runs native <code class="text-zinc-800 dark:text-zinc-300 font-mono">SetFile -d</code> and <code class="text-zinc-800 dark:text-zinc-300 font-mono">touch</code> commands to sync Finder timestamps instantly.</li>
                  </ol>
                </div>
                <div class="mt-4 pt-3 border-t border-zinc-200 dark:border-zinc-800 text-[11px] text-zinc-500">
                  ✓ Uses native macOS and POSIX command-line utilities.
                </div>
              </div>

            </div>
          </div>
        </div>
      </section>

      <!-- Sponsored Recommendations: In-Manual Banner -->
      <section class="mb-14 relative z-10" aria-label="Sponsored recommendations">
        <AdUnit client:only="react" placement="TOOL_BOTTOM" />
      </section>

      <!-- ========================================================================= -->
      <!-- HOW THE RESTORATION ENGINE WORKS                                          -->
      <!-- ========================================================================= -->
      <section id="how-it-works" class="mb-16 scroll-mt-20">
        <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white mb-6 flex items-center gap-2">
          <Icon name="cpu" class="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
          <span>How the Client-Side Pairing Engine Works</span>
        </h3>
        
        <div class="grid md:grid-cols-3 gap-5">
          <div class="p-5 rounded-xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 shadow-sm">
            <div class="font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400 mb-1">STAGE 01</div>
            <h4 class="font-bold text-zinc-900 dark:text-white text-sm mb-2">Folder Traversal &amp; Indexing</h4>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
              When you select your unzipped Takeout folder, the engine uses the W3C File System Access API to catalog all photos, videos, and <code class="font-mono text-[10px] bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 px-1 py-0.5 rounded text-zinc-800 dark:text-zinc-200">.json</code> sidecar files into high-speed memory maps.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 shadow-sm">
            <div class="font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400 mb-1">STAGE 02</div>
            <h4 class="font-bold text-zinc-900 dark:text-white text-sm mb-2">Heuristic Sidecar Pairing</h4>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Google Takeout may shorten a filename or add labels such as <code class="font-mono text-[10px] bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 px-1 py-0.5 rounded text-zinc-800 dark:text-zinc-200">-edited</code> and <code class="font-mono text-[10px] bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 px-1 py-0.5 rounded text-zinc-800 dark:text-zinc-200">(1)</code>. The tool checks these filename differences when matching a photo to its extra information file.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 shadow-sm">
            <div class="font-mono text-xs font-bold text-indigo-600 dark:text-indigo-400 mb-1">STAGE 03</div>
            <h4 class="font-bold text-zinc-900 dark:text-white text-sm mb-2">Lossless Binary Header Injection</h4>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
              The tool adds the saved date and location to supported photo and video files. It does not resize or recompress your media.
            </p>
          </div>
        </div>
      </section>

      <!-- ========================================================================= -->
      <!-- SUPPORTED FORMATS & TAG SPECIFICATIONS                                    -->
      <!-- ========================================================================= -->
      <section id="supported-formats" class="mb-16 scroll-mt-20">
        <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white mb-6 flex items-center gap-2">
          <Icon name="binary" class="w-5 h-5 text-indigo-600 dark:text-indigo-400" />
          <span>Supported File Formats &amp; Metadata Tags</span>
        </h3>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="p-6 rounded-xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 shadow-sm">
            <h4 class="font-bold text-zinc-900 dark:text-white text-sm mb-3">Supported Image Types</h4>
            <ul class="space-y-2 text-xs text-zinc-600 dark:text-zinc-400">
              <li class="flex items-center justify-between py-1 border-b border-zinc-100 dark:border-zinc-800/60">
                <span class="text-zinc-800 dark:text-white font-medium">JPEG / JPG</span>
                <span class="font-mono text-emerald-600 dark:text-emerald-400">Dates and locations</span>
              </li>
              <li class="flex items-center justify-between py-1 border-b border-zinc-100 dark:border-zinc-800/60">
                <span class="text-zinc-800 dark:text-white font-medium">Apple HEIC / HEIF</span>
                <span class="font-mono text-emerald-600 dark:text-emerald-400">Photo information</span>
              </li>
              <li class="flex items-center justify-between py-1 border-b border-zinc-100 dark:border-zinc-800/60">
                <span class="text-zinc-800 dark:text-white font-medium">PNG &amp; WebP</span>
                <span class="font-mono text-emerald-600 dark:text-emerald-400">eXIf Chunk + XMP</span>
              </li>
              <li class="flex items-center justify-between py-1">
                <span class="text-zinc-800 dark:text-white font-medium">Live Photos (HEIC + MOV)</span>
                <span class="font-mono text-emerald-600 dark:text-emerald-400">Paired Synchronization</span>
              </li>
            </ul>
          </div>

          <div class="p-6 rounded-xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 shadow-sm">
            <h4 class="font-bold text-zinc-900 dark:text-white text-sm mb-3">Supported Video Types</h4>
            <ul class="space-y-2 text-xs text-zinc-600 dark:text-zinc-400">
              <li class="flex items-center justify-between py-1 border-b border-zinc-100 dark:border-zinc-800/60">
                <span class="text-zinc-800 dark:text-white font-medium">MP4 (MPEG-4 Part 14)</span>
                <span class="font-mono text-emerald-600 dark:text-emerald-400">mvhd &amp; udta QuickTime Atoms</span>
              </li>
              <li class="flex items-center justify-between py-1 border-b border-zinc-100 dark:border-zinc-800/60">
                <span class="text-zinc-800 dark:text-white font-medium">MOV (QuickTime Movie)</span>
                <span class="font-mono text-emerald-600 dark:text-emerald-400">Creation Date + GPS Coordinates</span>
              </li>
              <li class="flex items-center justify-between py-1 border-b border-zinc-100 dark:border-zinc-800/60">
                <span class="text-zinc-800 dark:text-white font-medium">M4V &amp; 3GP</span>
                <span class="font-mono text-emerald-600 dark:text-emerald-400">Binary Container Metadata</span>
              </li>
              <li class="flex items-center justify-between py-1">
                <span class="text-zinc-800 dark:text-white font-medium">AVI (Legacy)</span>
                <span class="font-mono text-amber-600 dark:text-amber-400">RIFF INFO Timestamp Header</span>
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- ========================================================================= -->
      <!-- PRIVACY & OFFLINE GUARANTEE                                               -->
      <!-- ========================================================================= -->
      <section id="privacy-architecture" class="mb-16 scroll-mt-20">
        <div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-800 shadow-sm">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-600 dark:text-emerald-400">
              <Icon name="shield-check" class="w-5 h-5" />
            </div>
            <div>
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Your files stay on your device</span>
              <h3 class="text-xl font-bold text-zinc-900 dark:text-white">Private photo restoration</h3>
            </div>
          </div>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
            Your selected photos and Takeout archive are processed on your device and are not uploaded by the restore tool. The website may still use account, analytics, or advertising services as described in the <a href="/privacy" class="underline">Privacy Policy</a>.
          </p>
          <div class="p-3.5 rounded-xl bg-zinc-100 dark:bg-black/40 border border-zinc-200 dark:border-zinc-800/80 text-xs text-zinc-700 dark:text-zinc-400 font-mono">
            🧪 <strong>Offline Test:</strong> Once the page is loaded, you can disconnect your computer from the Wi-Fi or internet. The TakeoutFix restore engine will continue processing your entire library at full speed with zero network connectivity.
          </div>
        </div>
      </section>

      <!-- ========================================================================= -->
      <!-- TOOL FREQUENTLY ASKED QUESTIONS                                           -->
      <!-- ========================================================================= -->
      <section id="tool-faq" class="mb-12 scroll-mt-20">
        <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white mb-6">
          Frequently Asked Questions About the Web Tool
        </h3>

        <div class="space-y-4">
          <details class="p-4 rounded-xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 shadow-sm group">
            <summary class="font-bold text-sm text-zinc-900 dark:text-white cursor-pointer select-none flex justify-between items-center">
              <span>Can I restore a large Takeout download?</span>
              <span class="text-zinc-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="pt-3 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-100 dark:border-zinc-800/60 mt-3">
              Yes. The web tool runs parallel Web Workers to prevent UI freezing. For extremely large archives (100GB+), we recommend processing in album batches or using our <a href="/download" class="underline text-indigo-600 dark:text-indigo-400 hover:text-zinc-900 dark:hover:text-white">Desktop Application</a>, which runs a multi-threaded native engine without browser memory boundaries.
            </div>
          </details>

          <details class="p-4 rounded-xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 shadow-sm group">
            <summary class="font-bold text-sm text-zinc-900 dark:text-white cursor-pointer select-none flex justify-between items-center">
              <span>Will my original Google Takeout files be altered or overwritten?</span>
              <span class="text-zinc-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="pt-3 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-100 dark:border-zinc-800/60 mt-3">
              Never. TakeoutFix only reads your original Takeout directory and writes newly repaired files to your designated output directory. Your original Takeout download is preserved bit-for-bit as an immutable backup.
            </div>
          </details>

          <details class="p-4 rounded-xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 shadow-sm group">
            <summary class="font-bold text-sm text-zinc-900 dark:text-white cursor-pointer select-none flex justify-between items-center">
              <span>What if an extra information file is missing?</span>
              <span class="text-zinc-500 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="pt-3 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-100 dark:border-zinc-800/60 mt-3">
              If the extra <code class="font-mono text-zinc-800 dark:text-zinc-300">.json</code> file is missing, the tool may still find a date in the photo's filename. If it cannot match the information, it keeps the file in the results so you can review it; it does not silently discard it.
            </div>
          </details>
        </div>
