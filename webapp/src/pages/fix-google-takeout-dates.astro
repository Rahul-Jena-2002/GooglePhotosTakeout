---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Fix Google Takeout Dates – Restore Original Photo Dates | TakeoutFix"
  description="Fix wrong dates on Google Takeout photos. TakeoutFix restores original 'Date Taken' timestamps from JSON sidecars back into your photo EXIF headers — free, private, browser-based."
>
  <div class="bg-black text-zinc-100 min-h-screen py-24 px-4 sm:px-6 lg:px-8 relative overflow-hidden font-sans">

    <!-- BreadcrumbList Schema -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://takeoutfix.pages.dev/" },
        { "@type": "ListItem", "position": 2, "name": "Restore Data", "item": "https://takeoutfix.pages.dev/restore-data" },
        { "@type": "ListItem", "position": 3, "name": "Fix Google Takeout Dates" }
      ]
    }
    </script>

    <!-- Background glows -->
    <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-rose-900/10 blur-[150px] rounded-full pointer-events-none"></div>
    <div class="absolute bottom-20 right-1/4 w-[600px] h-[600px] bg-orange-900/10 blur-[150px] rounded-full pointer-events-none"></div>

    <!-- Hero -->
    <div class="max-w-4xl mx-auto text-center mb-20 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-semibold text-rose-400 mb-6 font-mono">
        📅 Fix Google Takeout Dates · Free · Browser-Based
      </div>

      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight">
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-orange-400 to-amber-500">Fix Google Takeout Dates</span>
        — Restore Original Timestamps
      </h1>

      <p class="text-lg md:text-xl text-zinc-400 max-w-3xl mx-auto leading-relaxed mb-8">
        Downloaded your photos from Google Takeout and they all show <strong class="text-red-400">today's date</strong>?
        That's because Google strips the original "Date Taken" from your images and stores it in separate JSON files.
        TakeoutFix reads those JSON sidecars and writes the correct timestamps back into your photo EXIF headers — instantly.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a href="/tool">
          <button id="fix-dates-cta-primary" class="glass-capsule interactive px-10 h-14 font-semibold text-white flex items-center gap-2">
            Fix My Dates Now →
          </button>
        </a>
        <a href="/restore-data">
          <button id="fix-dates-cta-guide" class="glass-capsule interactive px-8 h-14 font-semibold text-zinc-300 hover:text-white">
            See How It Works
          </button>
        </a>
      </div>
    </div>

    <!-- Why Dates Break -->
    <div class="max-w-4xl mx-auto mb-20 relative z-10">
      <div class="bg-zinc-950/40 border border-white/5 backdrop-blur-md rounded-2xl p-8">
        <h2 class="text-2xl font-bold text-white mb-4">Why Do Google Takeout Dates Go Wrong?</h2>
        <p class="text-zinc-400 leading-relaxed mb-4">
          When you export your Google Photos library using <strong class="text-zinc-200">Google Takeout</strong>, the platform creates a ZIP archive containing your raw image files alongside <code class="text-rose-400">.json</code> sidecar files.
        </p>
        <p class="text-zinc-400 leading-relaxed mb-4">
          The problem: the actual photo files (<code class="text-zinc-300">.jpg</code>, <code class="text-zinc-300">.mp4</code>) have their EXIF "Date Taken" field <strong class="text-red-400">stripped or overwritten</strong> with the export date. The real date is only stored in the companion JSON file.
        </p>
        <p class="text-zinc-400 leading-relaxed">
          When you import these photos into Apple Photos, Windows Gallery, Synology, or any other app, the system reads the file's EXIF header — which now shows the <strong class="text-red-400">wrong date</strong>. Your 2015 vacation photos appear as if they were taken today.
        </p>
      </div>
    </div>

    <!-- How TakeoutFix Fixes Dates -->
    <div class="max-w-4xl mx-auto mb-20 relative z-10">
      <h2 class="text-3xl font-bold text-white text-center mb-10">How TakeoutFix Restores Your Dates</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-zinc-950/40 border border-white/5 rounded-xl p-6 text-left relative overflow-hidden">
          <span class="absolute right-4 top-2 text-5xl font-extrabold text-white/5 font-mono select-none">1</span>
          <div class="w-10 h-10 rounded-lg bg-rose-500/10 border border-rose-500/20 flex items-center justify-center mb-3 text-rose-400 text-lg">📁</div>
          <h3 class="font-bold text-white mb-2">Select Takeout Folder</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Open TakeoutFix and select your extracted Google Takeout folder. The engine recursively scans for all photo files and their matching JSON sidecars.
          </p>
        </div>
        <div class="bg-zinc-950/40 border border-white/5 rounded-xl p-6 text-left relative overflow-hidden">
          <span class="absolute right-4 top-2 text-5xl font-extrabold text-white/5 font-mono select-none">2</span>
          <div class="w-10 h-10 rounded-lg bg-orange-500/10 border border-orange-500/20 flex items-center justify-center mb-3 text-orange-400 text-lg">🔗</div>
          <h3 class="font-bold text-white mb-2">Match JSON Sidecars</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            TakeoutFix's fuzzy matching engine handles truncated filenames, edited copies, and Google's naming quirks to correctly pair each photo with its JSON metadata.
          </p>
        </div>
        <div class="bg-zinc-950/40 border border-white/5 rounded-xl p-6 text-left relative overflow-hidden">
          <span class="absolute right-4 top-2 text-5xl font-extrabold text-white/5 font-mono select-none">3</span>
          <div class="w-10 h-10 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center mb-3 text-amber-400 text-lg">✅</div>
          <h3 class="font-bold text-white mb-2">Dates Restored</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            The original "Date Taken" timestamp is written directly into the EXIF header of each photo — no quality loss, no recompression. Your gallery timeline is fixed.
          </p>
        </div>
      </div>
    </div>

    <!-- Which Dates Get Fixed -->
    <div class="max-w-4xl mx-auto mb-20 relative z-10">
      <div class="bg-zinc-950/40 border border-white/5 backdrop-blur-md rounded-2xl p-8">
        <h2 class="text-2xl font-bold text-white mb-6">Which Date Fields Get Fixed?</h2>
        <div class="grid md:grid-cols-2 gap-4 text-sm text-zinc-400">
          <div class="space-y-3">
            <div class="flex items-center gap-3 p-3 bg-zinc-900/50 rounded-lg border border-zinc-800">
              <span class="text-rose-400">✓</span>
              <div>
                <div class="text-zinc-200 font-semibold">EXIF DateTimeOriginal</div>
                <div class="text-xs text-zinc-500">The primary "Date Taken" tag used by all gallery apps</div>
              </div>
            </div>
            <div class="flex items-center gap-3 p-3 bg-zinc-900/50 rounded-lg border border-zinc-800">
              <span class="text-rose-400">✓</span>
              <div>
                <div class="text-zinc-200 font-semibold">EXIF DateTimeDigitized</div>
                <div class="text-xs text-zinc-500">When the photo was digitized/captured</div>
              </div>
            </div>
          </div>
          <div class="space-y-3">
            <div class="flex items-center gap-3 p-3 bg-zinc-900/50 rounded-lg border border-zinc-800">
              <span class="text-rose-400">✓</span>
              <div>
                <div class="text-zinc-200 font-semibold">EXIF DateTime (ModifyDate)</div>
                <div class="text-xs text-zinc-500">File modification timestamp in EXIF header</div>
              </div>
            </div>
            <div class="flex items-center gap-3 p-3 bg-zinc-900/50 rounded-lg border border-zinc-800">
              <span class="text-rose-400">✓</span>
              <div>
                <div class="text-zinc-200 font-semibold">File System Modified Date</div>
                <div class="text-xs text-zinc-500">OS-level file timestamp for sorting in file explorers</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQ -->
    <div class="max-w-4xl mx-auto mb-20 relative z-10 space-y-4">
      <h2 class="text-3xl font-bold text-white text-center mb-8">Fix Google Takeout Dates — FAQ</h2>
      <div class="bg-zinc-950/40 border border-white/5 rounded-xl p-6">
        <h3 class="text-white font-semibold mb-2">Why do all my Google Takeout photos show today's date?</h3>
        <p class="text-zinc-400 text-sm leading-relaxed">Google Takeout exports the photo file without the original EXIF date. The file creation date becomes the export date. TakeoutFix reads the correct date from the JSON sidecar and writes it back into the photo's EXIF header.</p>
      </div>
      <div class="bg-zinc-950/40 border border-white/5 rounded-xl p-6">
        <h3 class="text-white font-semibold mb-2">Will fixing dates affect photo quality?</h3>
        <p class="text-zinc-400 text-sm leading-relaxed">No. TakeoutFix modifies only the EXIF header bytes — it never recompresses or alters the actual image data. Your photo quality is 100% preserved.</p>
      </div>
      <div class="bg-zinc-950/40 border border-white/5 rounded-xl p-6">
        <h3 class="text-white font-semibold mb-2">Does TakeoutFix fix dates for videos too?</h3>
        <p class="text-zinc-400 text-sm leading-relaxed">Yes. TakeoutFix fixes dates on MP4, MOV, and other video formats from Google Takeout. The original creation timestamp is restored from the JSON sidecar.</p>
      </div>
    </div>

    <!-- Related Guides -->
    <div class="max-w-4xl mx-auto mb-20 relative z-10">
      <div class="bg-zinc-950/40 border border-white/5 backdrop-blur-md rounded-2xl p-8">
        <h2 class="text-xl font-bold text-white mb-6">Related Guides</h2>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
          <a href="/restore-data" class="block p-4 bg-zinc-900/50 rounded-lg border border-zinc-800 hover:border-rose-500/30 transition-colors">
            <div class="text-sm font-semibold text-zinc-200 mb-1">Restore Data Guide</div>
            <div class="text-xs text-zinc-500">Complete walkthrough for restoring all metadata</div>
          </a>
          <a href="/takeout-fix" class="block p-4 bg-zinc-900/50 rounded-lg border border-zinc-800 hover:border-rose-500/30 transition-colors">
            <div class="text-sm font-semibold text-zinc-200 mb-1">Takeout Fix</div>
            <div class="text-xs text-zinc-500">Fix your Google Takeout photos & restore metadata</div>
          </a>
          <a href="/metadata-fixer" class="block p-4 bg-zinc-900/50 rounded-lg border border-zinc-800 hover:border-rose-500/30 transition-colors">
            <div class="text-sm font-semibold text-zinc-200 mb-1">Metadata Fixer</div>
            <div class="text-xs text-zinc-500">Online EXIF metadata repair tool</div>
          </a>
          <a href="/restore-gps-google-takeout" class="block p-4 bg-zinc-900/50 rounded-lg border border-zinc-800 hover:border-rose-500/30 transition-colors">
            <div class="text-sm font-semibold text-zinc-200 mb-1">Restore GPS Data</div>
            <div class="text-xs text-zinc-500">Recover GPS coordinates from Google Takeout</div>
          </a>
          <a href="/google-takeout-to-apple-photos" class="block p-4 bg-zinc-900/50 rounded-lg border border-zinc-800 hover:border-rose-500/30 transition-colors">
            <div class="text-sm font-semibold text-zinc-200 mb-1">Takeout → Apple Photos</div>
            <div class="text-xs text-zinc-500">Migrate Google Takeout to Apple Photos</div>
          </a>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="max-w-4xl mx-auto text-center py-16 border-t border-zinc-900 relative z-10">
      <h2 class="text-3xl font-bold tracking-tight mb-4 text-white">Fix Your Google Takeout Dates Now</h2>
      <p class="text-zinc-500 mb-8 max-w-md mx-auto">Restore correct timestamps on all your exported photos. Free, private, and instant.</p>
      <a href="/tool">
        <button id="fix-dates-cta-bottom" class="glass-capsule interactive px-12 h-14 font-semibold text-white">
          Open TakeoutFix →
        </button>
      </a>
    </div>
  </div>
</Layout>
