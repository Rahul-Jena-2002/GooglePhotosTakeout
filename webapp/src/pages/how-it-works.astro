---
import Layout from "../layouts/Layout.astro";
import AdUnit from "../components/AdUnit";
import { FolderSearch, Binary, Cpu, ArrowRight, ShieldCheck, CheckCircle2, FileText, Download, Play, UploadCloud } from "lucide-react";
---

<Layout title="How it Works: Restore Google Takeout Photo & Video EXIF Metadata" description="Learn how to restore photo dates, GPS locations, timestamps, and EXIF information from your Google Takeout archive. Everything runs locally in your browser.">
  <div class="bg-black text-zinc-100 min-h-screen py-24 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    
    <!-- Header -->
    <div class="max-w-4xl mx-auto text-center mb-16 relative">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-semibold text-zinc-450 mb-6 font-mono">
        <ShieldCheck className="w-4 h-4 text-zinc-450" />
        100% Client-Side Engine Telemetry
      </div>
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white mb-6">
        Guides & <span class="text-white">Specifications</span>
      </h1>
      <p class="text-base md:text-lg text-zinc-400 max-w-2xl mx-auto font-normal leading-relaxed">
        <strong>Learn how to export Google Photos, restore missing EXIF metadata, and import your library back with the correct dates and locations—all in a few simple steps.</strong>
      </p>
    </div>

    <!-- Tab Navigation Toggler -->
    <div class="max-w-xs mx-auto mb-20 flex tool-tab-container p-1 rounded-xl relative z-30 font-sans">
      <button 
        id="btn-tab-use"
        class="flex-1 py-2.5 text-xs font-bold rounded-lg transition-all cursor-pointer tool-tab-btn active"
      >
        How to Use
      </button>
      <button 
        id="btn-tab-tech"
        class="flex-1 py-2.5 text-xs font-bold rounded-lg transition-all cursor-pointer tool-tab-btn"
      >
        Behind the Scenes
      </button>
    </div>

    <!-- TAB 1: HOW TO USE (USER ONBOARDING) -->
    <div id="section-how-to-use" class="max-w-4xl mx-auto relative z-10 transition-all duration-300">
      
      <!-- Timeline Step List -->
      <div class="space-y-12">
        
        <!-- STEP 1: Navigate to Takeout -->
        <div class="flex flex-col md:flex-row gap-6 p-8 rounded-2xl bg-zinc-950/40 border border-zinc-900 hover:border-zinc-850 transition-all items-center md:items-start">
          <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-xl bg-zinc-900 border border-zinc-800 font-mono text-xs font-bold text-zinc-400">
            01
          </div>
          <div class="space-y-2 flex-grow">
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
              Navigate to Google Takeout
              <span class="text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-zinc-500">takeout.google.com</span>
            </h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Open Google Takeout in a new browser tab. Make sure you are logged into the Google Account that contains the Google Photos library you wish to export.
            </p>
            <div class="pt-2">
              <a href="https://takeout.google.com" target="_blank" rel="noopener noreferrer" class="text-xs text-white underline hover:text-zinc-300 inline-flex items-center gap-1">
                Go to Google Takeout <ArrowRight class="w-3 h-3" />
              </a>
            </div>
          </div>
          <div class="w-full md:w-72 flex-shrink-0 rounded-xl overflow-hidden border border-zinc-800 bg-zinc-950/60 shadow-lg">
            <img src="/hiw-step1.png" alt="Navigate to Google Takeout selection screenshot" class="w-full h-auto object-cover" />
          </div>
        </div>

        <!-- STEP 2: Filter Your Export -->
        <div class="flex flex-col md:flex-row gap-6 p-8 rounded-2xl bg-zinc-950/40 border border-zinc-900 hover:border-zinc-850 transition-all items-center md:items-start">
          <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-xl bg-zinc-900 border border-zinc-800 font-mono text-xs font-bold text-zinc-400">
            02
          </div>
          <div class="space-y-2 flex-grow">
            <h3 class="text-lg font-bold text-white">Select Google Photos Only</h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              By default, Google selects all of your Google Account data. Click <strong class="text-white">"Deselect all"</strong> at the top of the list, then scroll down to find <strong class="text-white">Google Photos</strong> and check its box. This makes your download size significantly smaller and saves you time.
            </p>
          </div>
          <div class="w-full md:w-72 flex-shrink-0 rounded-xl overflow-hidden border border-zinc-800 bg-zinc-950/60 shadow-lg">
            <img src="/hiw-step2.png" alt="Select Google Photos filter check screenshot" class="w-full h-auto object-cover" />
          </div>
        </div>

        <!-- STEP 3: Create Export & Download -->
        <div class="flex flex-col md:flex-row gap-6 p-8 rounded-2xl bg-zinc-950/40 border border-zinc-900 hover:border-zinc-850 transition-all items-center md:items-start">
          <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-xl bg-zinc-900 border border-zinc-800 font-mono text-xs font-bold text-zinc-400">
            03
          </div>
          <div class="space-y-2 flex-grow">
            <h3 class="text-lg font-bold text-white">Create Export and Download ZIPs</h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Scroll to the bottom, click <strong class="text-white">"Next step"</strong>, select your preferred archive sizes (we recommend 10GB or 50GB splits if you have a massive library to avoid downloading dozens of small files), and click <strong class="text-white">"Create export"</strong>. Google will generate your files and email you download links. Download all of these ZIP files onto your computer.
            </p>
          </div>
          <div class="w-full md:w-72 flex-shrink-0 rounded-xl overflow-hidden border border-zinc-800 bg-zinc-950/60 shadow-lg">
            <img src="/hiw-step3.png" alt="Create export and download split archives screenshot" class="w-full h-auto object-cover" />
          </div>
        </div>

        <!-- STEP 4: Select Folder in Tool -->
        <div class="flex flex-col md:flex-row gap-6 p-8 rounded-2xl bg-zinc-950/40 border border-zinc-900 hover:border-zinc-850 transition-all items-center md:items-start">
          <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-xl bg-zinc-900 border border-zinc-800 font-mono text-xs font-bold text-zinc-400">
            04
          </div>
          <div class="space-y-2 flex-grow">
            <h3 class="text-lg font-bold text-white">Load Archive in TakeoutFix</h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Go to the <a href="/tool" class="text-white underline hover:text-zinc-300 font-semibold">Restore Center</a>. Click <strong class="text-white">"Select Folder"</strong> to select your extracted Google Takeout folder directly on your hard drive, or drop your downloaded ZIP archives directly into the drop zone. <strong class="text-white">TakeoutFix automatically scans your Google Takeout folder and detects photos, videos, and their matching metadata files.</strong>
            </p>
          </div>
          <div class="w-full md:w-72 flex-shrink-0 rounded-xl overflow-hidden border border-zinc-800 bg-zinc-950/60 shadow-lg">
            <img src="/hiw-step4.png" alt="Browse and Select your Google Takeout folder mockup" class="w-full h-auto object-cover" />
          </div>
        </div>

        <!-- STEP 5: Start Restoration -->
        <div class="flex flex-col md:flex-row gap-6 p-8 rounded-2xl bg-zinc-950/40 border border-zinc-900 hover:border-zinc-850 transition-all items-center md:items-start">
          <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-xl bg-zinc-900 border border-zinc-800 font-mono text-xs font-bold text-zinc-400">
            05
          </div>
          <div class="space-y-2 flex-grow">
            <h3 class="text-lg font-bold text-white">Rebuild EXIF Metadata Offline</h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Click <strong class="text-white">"Start Restore."</strong> TakeoutFix automatically matches each photo and video with its corresponding metadata file and restores missing dates, GPS locations, and EXIF information. Everything happens locally in your browser, so your files never leave your device. Once completed, save your restored files.
            </p>
          </div>
          <div class="w-full md:w-72 flex-shrink-0 rounded-xl overflow-hidden border border-zinc-800 bg-zinc-950/60 shadow-lg">
            <img src="/hiw-step5.png" alt="Restoration progress dashboard mockup" class="w-full h-auto object-cover" />
          </div>
        </div>

        <!-- STEP 6: Import to Device Library -->
        <div class="flex flex-col md:flex-row gap-6 p-8 rounded-2xl bg-zinc-950/40 border border-zinc-900 hover:border-zinc-850 transition-all items-center md:items-start">
          <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-xl bg-zinc-900 border border-zinc-800 font-mono text-xs font-bold text-zinc-400">
            06
          </div>
          <div class="space-y-2 flex-grow">
            <h3 class="text-lg font-bold text-white">Import Restored Photos to iCloud/Apple/Synology</h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Import your restored photos into Apple Photos, iCloud Photos, Synology Photos, or another photo library. Your photos will appear in the correct chronological order with restored dates and GPS locations.
            </p>
          </div>
          <div class="w-full md:w-72 flex-shrink-0 rounded-xl overflow-hidden border border-zinc-800 bg-zinc-950/60 shadow-lg">
            <img src="/hiw-step6.png" alt="Imported photo library grid mockup" class="w-full h-auto object-cover" />
          </div>
        </div>

      </div>

      <!-- Estimated Time Box -->
      <div class="mt-16 p-6 rounded-2xl bg-zinc-950/20 border border-dashed border-zinc-800 text-left max-w-2xl mx-auto">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 flex items-center gap-2">
          ⏱️ Typical Restoration Time
        </h4>
        <ul class="space-y-2 text-xs text-zinc-400 font-sans">
          <li class="flex justify-between border-b border-zinc-900 pb-2">
            <span class="font-semibold text-zinc-300">1. Archive Export (Google)</span>
            <span>Depends on Google Photos library size (typically 1–24 hours)</span>
          </li>
          <li class="flex justify-between border-b border-zinc-900 pb-2">
            <span class="font-semibold text-zinc-300">2. Local Scan (TakeoutFix)</span>
            <span>A few seconds (instant parsing of files in browser)</span>
          </li>
          <li class="flex justify-between pb-1">
            <span class="font-semibold text-zinc-300">3. Rebuild & Restore</span>
            <span>1–10 minutes (depending on library size and CPU speed)</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- TAB 2: UNDER THE HOOD (TECHNICAL SPECS DEEP DIVE) -->
    <div id="section-how-it-works" class="max-w-6xl mx-auto relative hidden transition-all duration-300">
      
      <!-- Central connecting line for desktop -->
      <div class="absolute left-[50%] top-12 bottom-20 w-[1px] bg-zinc-800 opacity-30 hidden lg:block"></div>

      <div class="space-y-40">
        
        <!-- PHASE 1: Directory Parsing -->
        <div class="relative flex flex-col lg:flex-row items-stretch gap-12 lg:gap-20">
          <!-- Timeline node marker for desktop -->
          <div class="absolute left-[50%] -translate-x-1/2 top-4 w-10 h-10 rounded-full bg-zinc-950 border border-zinc-800 flex items-center justify-center shadow-[0_0_20px_rgba(0,0,0,0.8)] z-20 hidden lg:flex">
            <span class="w-3.5 h-3.5 rounded-full bg-zinc-500 animate-pulse"></span>
          </div>

          <!-- Left Block (Text & Code) -->
          <div class="flex-1 flex flex-col justify-center space-y-6 order-1 lg:text-left">
            <div class="flex items-center gap-3">
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-zinc-900 border border-zinc-800 shadow-md">
                <FolderSearch className="w-6 h-6 text-zinc-450" />
              </div>
              <div>
                <span class="text-[10px] font-bold uppercase tracking-[0.2em] font-mono text-zinc-450">Phase 01</span>
                <h3 class="text-2xl font-bold tracking-tight text-white">Local Directory Parsing Heuristics</h3>
              </div>
            </div>
            
            <div class="text-sm font-semibold tracking-wide text-zinc-500 uppercase font-mono">Secure Client-Side Indexing</div>
            
            <p class="text-base text-zinc-400 leading-relaxed font-normal">
              TakeoutFix utilizes the modern browser File System Access API to gain read-only permission to your Google Takeout folder. It executes a high-performance recursive traversal to locate all media files and their corresponding sidecar JSON files entirely on your machine.
            </p>

            <ul class="space-y-2.5">
              <li class="flex items-start gap-2.5 text-sm text-zinc-400 font-normal">
                <CheckCircle2 className="w-4 h-4 mt-0.5 flex-shrink-0 text-zinc-450" />
                <span>Zero-upload architecture: media bytes never leave your device.</span>
              </li>
              <li class="flex items-start gap-2.5 text-sm text-zinc-400 font-normal">
                <CheckCircle2 className="w-4 h-4 mt-0.5 flex-shrink-0 text-zinc-450" />
                <span>Asynchronous scanning runs in a background Web Worker to prevent UI blocking.</span>
              </li>
              <li class="flex items-start gap-2.5 text-sm text-zinc-400 font-normal">
                <CheckCircle2 className="w-4 h-4 mt-0.5 flex-shrink-0 text-zinc-450" />
                <span>Supports nested folder structures and multi-part Takeout archives.</span>
              </li>
            </ul>
          </div>

          <!-- Right Block (Diagram) -->
          <div class="flex-1 flex items-center justify-center order-2">
            <div class="relative w-full max-w-lg">
              <div class="relative bg-zinc-900/30 border border-white/5 rounded-2xl p-4 shadow-2xl backdrop-blur-md">
                <div class="aspect-square bg-zinc-950/80 rounded-xl border border-zinc-800/80 overflow-hidden p-2 flex items-center justify-center relative">
                  
                  <!-- CSS Indexed Diagram -->
                  <div class="w-full h-full p-6 flex flex-col diagram-card text-left font-mono justify-between text-xs border border-zinc-800/50 rounded-xl relative overflow-hidden group select-none">
                    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:16px_16px] pointer-events-none"></div>
                    <div class="flex items-center justify-between border-b border-zinc-800 pb-3 z-10">
                      <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-zinc-500 animate-pulse"></span>
                        <span class="text-zinc-400 font-semibold text-[10px] uppercase tracking-wider">File System Indexer</span>
                      </div>
                      <span class="text-zinc-400 text-[10px] font-bold">Active Traversal</span>
                    </div>
 
                    <div class="space-y-3.5 my-4 z-10 flex-1 justify-center flex flex-col">
                      <div class="flex items-center justify-between p-2.5 rounded border border-zinc-900 diagram-sub-box hover:border-zinc-800/80 transition-all animate-slide-in-1">
                        <div class="flex items-center gap-2">
                          <span class="w-1.5 h-1.5 rounded-full bg-zinc-400 shadow-[0_0_8px_rgba(255,255,255,0.15)]"></span>
                          <span class="text-zinc-300 font-medium truncate max-w-[130px] md:max-w-[180px] diagram-nested-file">IMG_3021.HEIC</span>
                        </div>
                        <div class="flex items-center gap-3">
                          <span class="text-zinc-500 text-[10px] font-semibold">4.2 MB</span>
                          <span class="px-1.5 py-0.5 rounded text-[8px] font-bold uppercase bg-zinc-800 text-zinc-300 border border-zinc-750 diagram-badge-indexed">indexed</span>
                        </div>
                      </div>
                      <div class="flex items-center justify-between p-2.5 rounded border border-zinc-900 diagram-sub-box hover:border-zinc-800/80 transition-all animate-slide-in-2">
                        <div class="flex items-center gap-2">
                          <span class="w-1.5 h-1.5 rounded-full bg-zinc-650 shadow-[0_0_8px_rgba(255,255,255,0.05)]"></span>
                          <span class="text-zinc-300 font-medium truncate max-w-[130px] md:max-w-[180px] diagram-nested-file">IMG_3021.HEIC.json</span>
                        </div>
                        <div class="flex items-center gap-3">
                          <span class="text-zinc-550 text-[10px] font-semibold">1.2 KB</span>
                          <span class="px-1.5 py-0.5 rounded text-[8px] font-bold uppercase bg-zinc-900 text-zinc-450 border border-zinc-800 diagram-badge-parsed">parsed</span>
                        </div>
                      </div>
                      <div class="flex items-center justify-between p-2.5 rounded border border-zinc-900 diagram-sub-box hover:border-zinc-800/80 transition-all animate-slide-in-3">
                        <div class="flex items-center gap-2">
                          <span class="w-1.5 h-1.5 rounded-full bg-zinc-400 shadow-[0_0_8px_rgba(255,255,255,0.15)]"></span>
                          <span class="text-zinc-300 font-medium truncate max-w-[130px] md:max-w-[180px] diagram-nested-file">IMG_3022-edited.JPG</span>
                        </div>
                        <div class="flex items-center gap-3">
                          <span class="text-zinc-550 text-[10px] font-semibold">2.8 MB</span>
                          <span class="px-1.5 py-0.5 rounded text-[8px] font-bold uppercase bg-zinc-800 text-zinc-300 border border-zinc-750 diagram-badge-indexed">indexed</span>
                        </div>
                      </div>
                      <div class="flex items-center justify-between p-2.5 rounded border border-zinc-900 diagram-sub-box hover:border-zinc-800/80 transition-all animate-slide-in-4">
                        <div class="flex items-center gap-2">
                          <span class="w-1.5 h-1.5 rounded-full bg-zinc-650 shadow-[0_0_8px_rgba(255,255,255,0.05)]"></span>
                          <span class="text-zinc-300 font-medium truncate max-w-[130px] md:max-w-[180px] diagram-nested-file">IMG_3022.JPG.json</span>
                        </div>
                        <div class="flex items-center gap-3">
                          <span class="text-zinc-550 text-[10px] font-semibold">1.5 KB</span>
                          <span class="px-1.5 py-0.5 rounded text-[8px] font-bold uppercase bg-zinc-900 text-zinc-450 border border-zinc-800 diagram-badge-parsed">parsed</span>
                        </div>
                      </div>
                    </div>
 
                    <div class="border-t border-zinc-900 pt-3 flex items-center justify-between z-10 text-[10px] text-zinc-550 font-bold uppercase tracking-wider">
                      <div>Scanned: <span class="text-zinc-300 font-extrabold">1,824 files</span></div>
                      <div>Speed: <span class="text-zinc-400 font-extrabold">142 files/s</span></div>
                    </div>
                  </div>
 
                </div>
              </div>
            </div>
          </div>
        </div>
 
        <!-- PHASE 2: Heuristic Matching -->
        <div class="relative flex flex-col lg:flex-row items-stretch gap-12 lg:gap-20">
          <div class="absolute left-[50%] -translate-x-1/2 top-4 w-10 h-10 rounded-full bg-zinc-950 border border-zinc-800 flex items-center justify-center shadow-[0_0_20px_rgba(0,0,0,0.8)] z-20 hidden lg:flex">
            <span class="w-3.5 h-3.5 rounded-full bg-zinc-500 animate-pulse"></span>
          </div>
 
          <div class="flex-1 flex flex-col justify-center space-y-6 order-1 lg:order-2 lg:text-left">
            <div class="flex items-center gap-3">
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-zinc-900 border border-zinc-800 shadow-md">
                <Cpu className="w-6 h-6 text-zinc-450" />
              </div>
              <div>
                <span class="text-[10px] font-bold uppercase tracking-[0.2em] font-mono text-zinc-450">Phase 02</span>
                <h3 class="text-2xl font-bold tracking-tight text-white">Heuristic Metadata Matching Algorithms</h3>
              </div>
            </div>
            
            <div class="text-sm font-semibold tracking-wide text-zinc-500 uppercase font-mono">Pairing Files with Sidecars</div>
            
            <p class="text-base text-zinc-400 leading-relaxed font-normal">
              Google Takeout often edits names, truncates titles, or appends suffixes (like '-edited' or '(1)') to media, making standard matching fail. TakeoutFix applies a multi-layered match heuristic to pair files with their JSON sidecar, resolving filename inconsistencies automatically.
            </p>

            <ul class="space-y-2.5">
              <li class="flex items-start gap-2.5 text-sm text-zinc-400 font-normal">
                <CheckCircle2 className="w-4 h-4 mt-0.5 flex-shrink-0 text-zinc-450" />
                <span>Name-hash pairing checks original file titles inside the JSON schema.</span>
              </li>
              <li class="flex items-start gap-2.5 text-sm text-zinc-400 font-normal">
                <CheckCircle2 className="w-4 h-4 mt-0.5 flex-shrink-0 text-zinc-450" />
                <span>Fuzzy matching reconciles truncated strings and system-appended suffixes.</span>
              </li>
              <li class="flex items-start gap-2.5 text-sm text-zinc-400 font-normal">
                <CheckCircle2 className="w-4 h-4 mt-0.5 flex-shrink-0 text-zinc-450" />
                <span>Timestamp alignment acts as a fallback to resolve similar media files.</span>
              </li>
            </ul>
          </div>
 
          <!-- Right Block (Diagram) -->
          <div class="flex-1 flex items-center justify-center order-2 lg:order-1">
            <div class="relative w-full max-w-lg">
              <div class="relative bg-zinc-900/30 border border-white/5 rounded-2xl p-4 shadow-2xl backdrop-blur-md">
                <div class="aspect-square bg-zinc-950/80 rounded-xl border border-zinc-800/80 overflow-hidden p-2 flex items-center justify-center relative">
                  
                  <!-- CSS Heuristic Matching Diagram -->
                  <div class="w-full h-full p-6 flex flex-col diagram-card text-left font-mono justify-between text-xs border border-zinc-800/50 rounded-xl relative overflow-hidden group select-none">
                    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:16px_16px] pointer-events-none"></div>
                    <div class="flex items-center justify-between border-b border-zinc-800 pb-3 z-10">
                      <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-zinc-500 animate-pulse"></span>
                        <span class="text-zinc-400 font-semibold text-[10px] uppercase tracking-wider">Heuristic Matching Engine</span>
                      </div>
                      <span class="text-zinc-400 text-[10px] font-bold">Resolving Permutations</span>
                    </div>
 
                    <div class="my-auto py-2 space-y-4 z-10 flex-1 justify-center flex flex-col">
                      <!-- Match 1 -->
                      <div class="relative space-y-1 bg-zinc-900/20 p-2.5 rounded border border-zinc-900/60 diagram-sub-box">
                        <div class="flex justify-between text-[8px] text-zinc-500 font-bold uppercase tracking-wider px-1">
                          <span>Source Media</span>
                          <span class="text-zinc-450 font-bold">Fuzzy String Match</span>
                          <span>Sidecar JSON</span>
                        </div>
                        <div class="flex items-center justify-between gap-3">
                          <div class="flex-1 p-2 rounded bg-zinc-900 border border-zinc-800/50 text-zinc-300 truncate max-w-[130px] text-center font-bold text-[10px] diagram-nested-file">
                            IMG_9102-edited.JPG
                          </div>
                          <div class="relative flex-1 flex items-center justify-center h-2">
                            <div class="absolute inset-0 bg-zinc-800 rounded-full h-[1px]"></div>
                            <div class="absolute w-2.5 h-2.5 rounded-full bg-zinc-400 shadow-[0_0_8px_rgba(255,255,255,0.2)] animate-beam-1"></div>
                          </div>
                          <div class="flex-1 p-2 rounded bg-zinc-900 border border-zinc-800/50 text-zinc-400 truncate max-w-[130px] text-center text-[10px] diagram-nested-file">
                            IMG_9102.JPG.json
                          </div>
                        </div>
                      </div>
 
                      <!-- Match 2 -->
