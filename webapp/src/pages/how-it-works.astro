<script>
  function setupTabs() {
    const btnUse = document.getElementById("btn-tab-use");
    const btnTech = document.getElementById("btn-tab-tech");
    const secUse = document.getElementById("section-how-to-use");
    const secTech = document.getElementById("section-how-it-works");

    if (!btnUse || !btnTech || !secUse || !secTech) return;

    btnUse.addEventListener("click", () => {
      // Toggle buttons
      btnUse.classList.add("active");
      btnTech.classList.remove("active");

      // Toggle sections
      secUse.classList.remove("hidden");
      secTech.classList.add("hidden");
    });

    btnTech.addEventListener("click", () => {
      // Toggle buttons
      btnTech.classList.add("active");
      btnUse.classList.remove("active");

      // Toggle sections
      secTech.classList.remove("hidden");
      secUse.classList.add("hidden");
    });

    // Handle hash links to jump directly to specific section/tabs
    const hash = window.location.hash;
    if (hash === "#tech-specs" || hash === "#tech-deep-dive") {
      btnTech.click();
    }
  }

  // Set up on initial load
  setupTabs();

  // Re-run setup on Astro page transitions (astro:page-load)
  document.addEventListener("astro:page-load", setupTabs);
</script>

