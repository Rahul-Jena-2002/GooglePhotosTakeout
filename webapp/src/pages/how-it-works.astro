  @keyframes beam {
    0% {
      left: 0%;
    }
    50% {
      left: 100%;
    }
    100% {
      left: 0%;
    }
  }

  .animate-slide-in-1 {
    animation: slideIn 0.5s ease-out forwards;
  }
  .animate-slide-in-2 {
    animation: slideIn 0.5s ease-out 0.15s forwards;
    opacity: 0;
  }
  .animate-slide-in-3 {
    animation: slideIn 0.5s ease-out 0.3s forwards;
    opacity: 0;
  }
  .animate-slide-in-4 {
    animation: slideIn 0.5s ease-out 0.45s forwards;
    opacity: 0;
  }

  .animate-beam-1 {
    animation: beam 2.5s ease-in-out infinite;
  }
  .animate-beam-2 {
