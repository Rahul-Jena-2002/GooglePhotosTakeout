---
// Offline fallback page — served by SW when user is offline and page not cached
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TakeoutFix — Offline</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #09090b;
      color: #fff;
      font-family: system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }
    .card {
      text-align: center;
      max-width: 420px;
    }
    .icon {
      width: 64px;
      height: 64px;
      border-radius: 1rem;
      background: #18181b;
      border: 1px solid #27272a;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
      font-size: 2rem;
    }
    h1 {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      letter-spacing: -0.025em;
    }
    p {
      color: #71717a;
      font-size: 0.9rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }
    .pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: #18181b;
      border: 1px solid #27272a;
      border-radius: 9999px;
      padding: 0.35rem 0.9rem;
      font-size: 0.75rem;
      color: #a1a1aa;
      margin-bottom: 2rem;
    }
    .dot { width: 6px; height: 6px; border-radius: 50%; background: #ef4444; }
    button {
      background: #6366f1;
      color: #fff;
      border: none;
      border-radius: 0.75rem;
      padding: 0.65rem 1.5rem;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
    }
    button:hover { background: #4f46e5; }
    .note {
      margin-top: 1.25rem;
      font-size: 0.75rem;
      color: #52525b;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="icon">📡</div>
    <div class="pill">
      <span class="dot"></span>
      No Internet Connection
    </div>
    <h1>You're offline</h1>
    <p>
      TakeoutFix needs a connection to load authentication and sync your account.
      Once the app is loaded online, <strong>photo processing works fully offline</strong> — 
      all restoration happens in your browser.
    </p>
    <button onclick="location.reload()">Try Again</button>
    <p class="note">
      If you were already processing photos, your session is saved and will resume when you reconnect.
    </p>
  </div>
</body>
</html>
