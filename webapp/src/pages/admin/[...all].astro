---
import "../../index.css";
import { AuthProvider } from "../../contexts/AuthContext";
import AdminRouter from "../../components/AdminRouter";

export const prerender = false;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TakeoutFix | Admin Operations Center</title>
    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class="bg-zinc-950 text-zinc-100 selection:bg-indigo-500/30">
    <AuthProvider client:only="react">
      <AdminRouter client:only="react" />
    </AuthProvider>
  </body>
</html>
