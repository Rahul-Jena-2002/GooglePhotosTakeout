rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Role Helpers ───────────────────────────────────────────────────────────
    function isSuperAdminEmail() {
      return request.auth != null && request.auth.token.email in [
        'rahuljena.dev@gmail.com'
      ];
    }

    function getAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isSuperAdminEmail() ||
        (request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function getRole() {
      return isSuperAdminEmail() ? 'SUPER_ADMIN' : getAdminDoc().data.role;
    }

    function isSuperAdmin() {
      return isAdmin() && getRole() == 'SUPER_ADMIN';
    }

    function isAdminOrAbove() {
      return isAdmin() && getRole() in ['SUPER_ADMIN', 'ADMIN'];
    }

    function isSupportOrAbove() {
      return isAdmin() && getRole() in ['SUPER_ADMIN', 'ADMIN', 'SUPPORT'];
    }

    function isModeratorOrAbove() {
      return isAdmin() && getRole() in ['SUPER_ADMIN', 'ADMIN', 'MODERATOR'];
    }

    // ─── User Collection ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // ─── Admins Collection ───────────────────────────────────────────────────────
    match /admins/{adminId} {
      // Any admin can read the full admin list (for team page & online presence)
      allow read: if isAdmin();
      // Only SUPER_ADMIN can create/update/delete admin records
      allow create, update, delete: if isSuperAdmin();
      // Admins can update their OWN presence status fields only
      allow update: if request.auth != null
        && request.auth.uid == adminId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastSeen']);
    }

    // ─── Admin Activity Feed ─────────────────────────────────────────────────────
    match /admin_activity/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // ─── Usage Logs ──────────────────────────────────────────────────────────────
    match /usage_logs/{logId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // ─── Recovery History ─────────────────────────────────────────────────────────
    match /recoveryHistory/{uid}/sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // ─── Recoveries ──────────────────────────────────────────────────────────────
    match /recoveries/{recoveryId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdminOrAbove());
    }

    // ─── Support Tickets ─────────────────────────────────────────────────────────
    match /tickets/{ticketId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow read, write: if isSupportOrAbove();
    }

    // ─── Reviews ─────────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isModeratorOrAbove();
    }

    // ─── Transactions Collection ─────────────────────────────────────────────────
    match /transactions/{txId} {
      allow create: if request.auth != null && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdminOrAbove());
      allow update, delete: if isSuperAdmin();
    }

    // ─── Active Sessions ─────────────────────────────────────────────────────────
    match /active_sessions/{sessionId} {
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ─── Platform Stats ───────────────────────────────────────────────────────────
    match /platform_stats/{document} {
      allow read: if true;
      allow update, create: if request.auth != null;
    }

    // ─── Settings Collection ─────────────────────────────────────────────────────
    match /settings/{document} {
      allow read: if document != 'secure';
      allow write: if isAdmin();
      allow read, write: if isAdmin();
    }

    // ─── Config Collection ───────────────────────────────────────────────────────
    match /config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
