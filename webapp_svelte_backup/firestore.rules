rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Normal users can only read and write their OWN data
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Master Admin can read and write EVERYONE'S data
      allow read, write: if request.auth != null && request.auth.token.email == 'rahuljenasonu@gmail.com';
    }

    match /usage_logs/{logId} {
      // Any authenticated user can create a log, but they cannot read them
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      
      // Master Admin can read all logs
      allow read, delete: if request.auth != null && request.auth.token.email == 'rahuljenasonu@gmail.com';
    }
  }
}
